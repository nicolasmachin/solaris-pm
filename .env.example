PORT=4000
DATABASE_URL=
JWT_SECRET=
JWT_EXPIRES_IN=7d
STORAGE_PATH=./storage
MAX_FILE_SIZE_MB=20
# Límite propio para los videos de ensayos (se aplica SOLO en esa ruta).
MAX_VIDEO_SIZE_MB=500

BASE_URL=http://localhost:5173

# Etapa 10 — Notificaciones email y WhatsApp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Clave para cifrar las credenciales SMTP por usuario (sistema de mails).
# Cualquier string largo y secreto; se deriva a 32 bytes con SHA-256.
SMTP_ENCRYPTION_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# Respaldo off-site del storage a Backblaze B2 (solo prod, ver docs/DEPLOY.md §3).
B2_ACCOUNT_ID=
B2_APPLICATION_KEY=
B2_BUCKET=voltia-storage
