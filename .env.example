PORT=4000
DATABASE_URL=
JWT_SECRET=
JWT_EXPIRES_IN=7d
STORAGE_PATH=./storage
MAX_FILE_SIZE_MB=20
# Límite propio para los videos de ensayos (se aplica SOLO en esa ruta).
MAX_VIDEO_SIZE_MB=500

BASE_URL=http://localhost:5173

# Bunny Stream — videos del módulo Capacitación (Stream → biblioteca → API / Security).
# API_KEY: alcanza la "Read-only API Key" (la app solo lista videos).
# TOKEN_KEY: "Embed view token authentication key"; vacía = embeds sin firma.
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_TOKEN_KEY=
BUNNY_STREAM_CDN_HOSTNAME=
# Referer para bajar miniaturas (tiene que estar en "Allowed domains" de Bunny).
# En dev conviene el dominio de producción: el pedido lo hace el server.
BUNNY_STREAM_REFERER=
# Etapa 10 — Notificaciones email y WhatsApp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Clave para cifrar las credenciales SMTP por usuario (sistema de mails).
# Cualquier string largo y secreto; se deriva a 32 bytes con SHA-256.
SMTP_ENCRYPTION_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
# WhatsApp Cloud API de Meta (docs/manual/15-whatsapp.md). Secretos: solo en el servidor.
WHATSAPP_TOKEN=
META_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
# Versión de la Graph API. Vacío = v26.0 (la vigente desde julio de 2026).
GRAPH_API_VERSION=
# Marketing → Instagram (docs/manual/20-marketing.md): el contestador del conector
# de indicadores. El secreto es el mismo en las dos puntas (openssl rand -hex 32).
INSTAGRAM_CONECTOR_URL=
INSTAGRAM_CONECTOR_SECRETO=

# Respaldo off-site del storage a Backblaze B2 (solo prod, ver docs/DEPLOY.md §3).
B2_ACCOUNT_ID=
B2_APPLICATION_KEY=
B2_BUCKET=voltia-storage
