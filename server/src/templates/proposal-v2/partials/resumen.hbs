<div class="pg" style="width:794px; height:1123px; background:#fff; position:relative; overflow:hidden; padding:42px 50px; display:flex; flex-direction:column;">
  <div style="display:flex; align-items:center; justify-content:space-between; padding-bottom:16px; border-bottom:2px solid #1836B2;">
    <div>
      <div style="font-size:10.5px; font-weight:700; letter-spacing:.14em; color:#1836B2; text-transform:uppercase;">Propuesta comercial · Energía solar</div>
      <div style="font-size:20px; font-weight:700; color:#10131f; margin-top:5px;">{{data.cliente.nombre}}</div>
      <div style="font-size:12px; color:#6b7188; margin-top:2px;">{{data.cliente.ciudad}} · {{calculated.fechaTextoLargo}}</div>
    </div>
    <img src="{{logoMarkBlue}}" alt="Voltia" style="height:44px; width:44px; object-fit:contain; display:block;">
  </div>

  <div style="margin-top:18px; font-size:10.5px; font-weight:700; letter-spacing:.14em; color:#1836B2; text-transform:uppercase;">Lo que vas a ganar</div>
  <div style="margin-top:11px; display:grid; grid-template-columns:repeat(4,1fr); gap:11px;">
    <div style="border:1px solid #e6e8f2; border-radius:12px; padding:15px 14px;"><div style="font-size:9.5px; font-weight:600; letter-spacing:.08em; text-transform:uppercase; color:#8a90a6;">Ahorro mensual</div><div style="font-size:22px; font-weight:700; letter-spacing:-.02em; color:#1836B2; margin-top:8px;">{{pesos calculated.ahorroMensualPesos}}</div><div style="font-size:10.5px; color:#6b7188; margin-top:5px;">{{number (mult calculated.porcentajeAhorro 100)}}% de tu factura</div><div style="font-size:9px; color:#9aa0b4; margin-top:3px;">* Promedio anual</div></div>
    <div style="border:1px solid #e6e8f2; border-radius:12px; padding:15px 14px;"><div style="font-size:9.5px; font-weight:600; letter-spacing:.08em; text-transform:uppercase; color:#8a90a6;">Ahorro anual</div><div style="font-size:22px; font-weight:700; letter-spacing:-.02em; color:#1836B2; margin-top:8px;">{{currency calculated.ahorroAnualUsd}}</div><div style="font-size:10.5px; color:#6b7188; margin-top:5px;">por año</div></div>
    <div style="border:1px solid #e6e8f2; border-radius:12px; padding:15px 14px;"><div style="font-size:9.5px; font-weight:600; letter-spacing:.08em; text-transform:uppercase; color:#8a90a6;">Recupero (PRI)</div><div style="font-size:22px; font-weight:700; letter-spacing:-.02em; color:#1836B2; margin-top:8px;">{{number calculated.priAnios 1}} años</div><div style="font-size:10.5px; color:#6b7188; margin-top:5px;">período de retorno</div></div>
    <div style="border:1px solid #e6e8f2; border-radius:12px; padding:15px 14px;"><div style="font-size:9.5px; font-weight:600; letter-spacing:.08em; text-transform:uppercase; color:#8a90a6;">Rentab. (TIR)</div><div style="font-size:22px; font-weight:700; letter-spacing:-.02em; color:#1836B2; margin-top:8px;">{{percent calculated.tir}}</div><div style="font-size:10.5px; color:#6b7188; margin-top:5px;">tasa interna</div></div>
  </div>

  <div style="margin-top:18px; display:grid; grid-template-columns:1.05fr 1fr; gap:22px;">
    <div>
      <div style="font-size:10.5px; font-weight:700; letter-spacing:.14em; color:#1836B2; text-transform:uppercase;">El sistema</div>
      <div style="margin-top:9px; display:flex; flex-direction:column;">
        <div style="display:flex; align-items:center; gap:11px; padding:8px 0; border-bottom:1px solid #edeff5;"><div style="width:32px; height:32px; flex:none; border-radius:9px; background:#eef1fb; display:flex; align-items:center; justify-content:center; color:#1836B2;"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="13" rx="1"></rect><path d="M3 9h18M9 4v13M15 4v13M9 21h6M12 17v4"></path></svg></div><div><div style="font-size:12px; font-weight:700; color:#10131f;">Paneles</div><div style="font-size:10.5px; color:#6b7188;">{{data.sistema.marcaPaneles}} · {{data.sistema.cantidadPaneles}} · {{data.sistema.potenciaPanelW}} W</div></div></div>
        <div style="display:flex; align-items:center; gap:11px; padding:8px 0; border-bottom:1px solid #edeff5;"><div style="width:32px; height:32px; flex:none; border-radius:9px; background:#eef1fb; display:flex; align-items:center; justify-content:center; color:#1836B2;"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="3" width="16" height="18" rx="2"></rect><path d="M8 7h8"></path><circle cx="12" cy="14" r="3"></circle></svg></div><div><div style="font-size:12px; font-weight:700; color:#10131f;">Inversor</div><div style="font-size:10.5px; color:#6b7188;">{{data.sistema.marcaInversor}} · {{number data.sistema.potenciaInversorKw}} kW · Wifi</div></div></div>
        <div style="display:flex; align-items:center; gap:11px; padding:8px 0; border-bottom:1px solid #edeff5;"><div style="width:32px; height:32px; flex:none; border-radius:9px; background:#eef1fb; display:flex; align-items:center; justify-content:center; color:#1836B2;"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2 4 14h6l-1 8 9-12h-6z"></path></svg></div><div><div style="font-size:12px; font-weight:700; color:#10131f;">Potencia pico</div><div style="font-size:10.5px; color:#6b7188;">{{number calculated.potenciaTotalKwp 2}} kWp · ~{{number calculated.metrosCuadradosPaneles}} m²</div></div></div>
        <div style="display:flex; align-items:center; gap:11px; padding:8px 0;"><div style="width:32px; height:32px; flex:none; border-radius:9px; background:#eef1fb; display:flex; align-items:center; justify-content:center; color:#1836B2;"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v3M12 19v3M2 12h3M19 12h3M5 5l2 2M17 17l2 2M19 5l-2 2M7 17l-2 2"></path></svg></div><div><div style="font-size:12px; font-weight:700; color:#10131f;">Generación anual</div><div style="font-size:10.5px; color:#6b7188;">{{number calculated.energiaAnualKwh}} kWh / año</div></div></div>
      </div>
    </div>
    <div style="display:flex; flex-direction:column; justify-content:flex-start;">
      <div style="font-size:10.5px; font-weight:700; letter-spacing:.14em; color:#1836B2; text-transform:uppercase;">Inversión</div>
      <div style="margin-top:9px; background:#1836B2; border-radius:14px; padding:18px 22px; color:#fff;">
        <div style="font-size:10px; letter-spacing:.14em; text-transform:uppercase; color:#aebcf2;">Sistema on-grid · llave en mano</div>
        <div style="font-size:12px; color:#cdd6f7; margin-top:5px;">{{number (mult calculated.potenciaTotalKwp 1000)}} W · {{currency calculated.subtotalSinIva}} + IVA</div>
        <div style="margin-top:12px; padding-top:12px; border-top:1px solid rgba(255,255,255,.2); display:flex; align-items:baseline; justify-content:space-between;">
          <span style="font-size:10px; letter-spacing:.14em; text-transform:uppercase; color:#aebcf2;">Total c/IVA</span>
          <span style="font-size:30px; font-weight:700; letter-spacing:-.02em;">{{currency calculated.totalConIva}}</span>
        </div>
      </div>
      <div style="margin-top:7px; font-size:9px; color:#9aa0b4; line-height:1.5;">Tarifa UTE {{tarifaLabel data.factura.tarifa}} · dólar ${{number data.cotizacion.cotizacionDolar}}. Emitida el {{calculated.fechaTextoLargo}}, vigente 60 días.</div>
    </div>
  </div>

  <div style="margin-top:18px; font-size:10.5px; font-weight:700; letter-spacing:.14em; color:#1836B2; text-transform:uppercase;">Plazo de entrega</div>
  <div style="margin-top:14px; position:relative;">
    <div style="position:absolute; left:7%; right:7%; top:7px; height:2px; background:#dde1ee;"></div>
    <div style="display:flex; justify-content:space-between; position:relative;">
      <div style="display:flex; flex-direction:column; align-items:center; width:24%;"><div style="width:15px; height:15px; border-radius:50%; background:#1836B2;"></div><div style="font-size:11.5px; font-weight:700; color:#10131f; margin-top:9px; text-align:center;">Firma + 50%</div><div style="font-size:10px; color:#1836B2; font-weight:700; margin-top:3px;">Día 0</div></div>
      <div style="display:flex; flex-direction:column; align-items:center; width:24%;"><div style="width:15px; height:15px; border-radius:50%; background:#1836B2;"></div><div style="font-size:11.5px; font-weight:700; color:#10131f; margin-top:9px; text-align:center;">Coordinación</div><div style="font-size:10px; color:#1836B2; font-weight:700; margin-top:3px;">3 a 4 semanas</div></div>
      <div style="display:flex; flex-direction:column; align-items:center; width:24%;"><div style="width:15px; height:15px; border-radius:50%; background:#1836B2;"></div><div style="font-size:11.5px; font-weight:700; color:#10131f; margin-top:9px; text-align:center;">Instalación</div><div style="font-size:10px; color:#1836B2; font-weight:700; margin-top:3px;">3 días</div></div>
      <div style="display:flex; flex-direction:column; align-items:center; width:24%;"><div style="width:15px; height:15px; border-radius:50%; background:#fff; border:3px solid #1836B2;"></div><div style="font-size:11.5px; font-weight:700; color:#10131f; margin-top:9px; text-align:center;">Habilitación UTE</div><div style="font-size:10px; color:#1836B2; font-weight:700; margin-top:3px;">hasta 8 semanas</div></div>
    </div>
  </div>

  <div style="margin-top:18px; font-size:10.5px; font-weight:700; letter-spacing:.14em; color:#1836B2; text-transform:uppercase;">Financiación BBVA</div>
  <div style="margin-top:11px; display:grid; grid-template-columns:1.15fr 1fr; gap:18px; align-items:start;">
    <div style="border:1px solid #e6e8f2; border-radius:12px; overflow:hidden;">
      <div style="display:grid; grid-template-columns:1fr 0.8fr 1fr; background:#f4f6fc; border-bottom:1px solid #e6e8f2;">
        <div style="padding:9px 14px; font-size:9.5px; font-weight:700; letter-spacing:.05em; text-transform:uppercase; color:#7b8198;">Plazo</div>
        <div style="padding:9px 8px; font-size:9.5px; font-weight:700; letter-spacing:.05em; text-transform:uppercase; color:#7b8198;">Interés</div>
        <div style="padding:9px 14px; font-size:9.5px; font-weight:700; letter-spacing:.05em; text-transform:uppercase; color:#7b8198; text-align:right;">Cuota mensual</div>
      </div>
      <div style="display:grid; grid-template-columns:1fr 0.8fr 1fr; border-bottom:1px solid #eef0f6;"><div style="padding:11px 14px; font-size:12.5px; font-weight:600; color:#10131f;">24 cuotas</div><div style="padding:11px 8px; font-size:12.5px; color:#3a3e50;">0% UI</div><div style="padding:11px 14px; font-size:13.5px; font-weight:700; color:#1836B2; text-align:right;">{{pesos (mult calculated.cuota24m data.cotizacion.cotizacionDolar)}}</div></div>
      <div style="display:grid; grid-template-columns:1fr 0.8fr 1fr; border-bottom:1px solid #eef0f6;"><div style="padding:11px 14px; font-size:12.5px; font-weight:600; color:#10131f;">36 cuotas</div><div style="padding:11px 8px; font-size:12.5px; color:#3a3e50;">0% UI</div><div style="padding:11px 14px; font-size:13.5px; font-weight:700; color:#1836B2; text-align:right;">{{pesos (mult calculated.cuota36m data.cotizacion.cotizacionDolar)}}</div></div>
      <div style="display:grid; grid-template-columns:1fr 0.8fr 1fr;"><div style="padding:11px 14px; font-size:12.5px; font-weight:600; color:#10131f;">60 cuotas</div><div style="padding:11px 8px; font-size:12.5px; color:#3a3e50;">5% UI</div><div style="padding:11px 14px; font-size:13.5px; font-weight:700; color:#1836B2; text-align:right;">{{pesos (mult calculated.cuota60m data.cotizacion.cotizacionDolar)}}</div></div>
    </div>
    <div style="display:flex; flex-direction:column; gap:11px;">
      <div style="border:1px solid #e6e8f2; border-radius:12px; padding:13px 16px;"><div style="font-size:12px; font-weight:700; color:#10131f;">Condiciones</div><div style="margin-top:7px; display:flex; flex-direction:column; gap:4px; font-size:10.5px; line-height:1.4; color:#6b7188;"><div>· Validez: 60 días · Pago inicial: 50%.</div><div>· Saldo al finalizar la instalación técnica.</div><div>· Habilitación UTE: hasta 8 semanas.</div></div></div>
      <div style="border:1px solid #e6e8f2; border-radius:12px; padding:13px 16px;"><div style="display:flex; align-items:center; gap:8px;"><span style="color:#1836B2;"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l8 3v6c0 5-3.4 8.5-8 11-4.6-2.5-8-6-8-11V5z"></path></svg></span><div style="font-size:12px; font-weight:700; color:#10131f;">Seguro contra granizo</div></div><p style="margin:6px 0 0; font-size:10.5px; line-height:1.45; color:#6b7188;">Opcional · USD 12 / panel / año. Cubre reposición e instalación sin costo de mano de obra.</p></div>
    </div>
  </div>
  <p style="margin:10px 0 0; font-size:9px; line-height:1.5; color:#9aa0b4;">Cuotas orientativas. La variación del dólar y de la Unidad Indexada modificará los montos. El otorgamiento del préstamo está sujeto a análisis crediticio.</p>

  <div style="margin-top:auto; padding-top:14px; border-top:1px solid #eef0f6; display:flex; align-items:center; justify-content:space-between;">
    <img src="{{logoMarkBlue}}" alt="Voltia" style="height:38px; width:38px; object-fit:contain; display:block;">
    <span style="font-size:10px; color:#a3a8bb; letter-spacing:.08em;">contacto@voltia.com.uy · 098 640 651</span>
  </div>
</div>
