  // Cuántas "obras" vale el proyecto para la métrica ponderada. Default 1;
  // sólo ADMIN lo sube a mano desde la ficha (ej. una obra grande = 5).
  pesoObra                        Int                      @default(1)
  locationCity                    String
  locationProvince                String
  status                          ProjectStatus
  startDate                       DateTime                 @db.Date
  saleDate                        DateTime?                @db.Date
  plannedEndDate                  DateTime?                @db.Date
  actualEndDate                   DateTime?                @db.Date
  budgetUsd                       Decimal?                 @db.Decimal(14, 2)
  executedUsd                     Decimal                  @db.Decimal(14, 2)
  estimatedMwhYear                Decimal?                 @db.Decimal(10, 2)
  co2TonsAvoided                  Decimal?                 @db.Decimal(10, 2)
  actualOnboardingEnd             DateTime?                @db.Date
  actualEngineeringEnd            DateTime?                @db.Date
  actualUteStart                  DateTime?                @db.Date
  actualUteEnd                    DateTime?                @db.Date
  modalidadPago                   ModalidadPago?
  firstDateScheduledAt            DateTime?                @db.Timestamptz(6)
  clientEmail                     String?
  clientPhone                     String?
  clientAddress                   String?
  uteCodigoPS                     String?
  uteCodigoAS                     String?
  createdById                     String
  createdBy                       User                     @relation("ProjectCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  salespersonId                   String?
  salesperson                     User?                    @relation("ProjectSalesperson", fields: [salespersonId], references: [id], onDelete: SetNull)
  clientUserId                    String?
  clientUser                      User?                    @relation("ProjectClient", fields: [clientUserId], references: [id], onDelete: SetNull)
  stages                          Stage[]
  substages                       Substage[]
  checklistItems                  ChecklistItem[]
  obraChecklistItems              ProjectChecklistItem[]
  tasks                           Task[]
  files                           FileAttachment[]
  auditLogs                       AuditLog[]
  notifications                   Notification[]
  comments                        Comment[]
  settings                        Setting[]                @relation("SettingProject")
  convertedLeads                  SalesLead[]              @relation("LeadConvertedTo")
  proposals                       ProposalGeneration[]     @relation("ProposalProject")
  solarSystems                    SolarSystem[]
  financeMovements                FinanceMovement[]
  projectMaterials                ProjectMaterial[]
  nonMaterialCosts                ProjectNonMaterialCost[]
  tickets                         Ticket[]
  surveys                         SatisfactionSurvey[]
  stockMovements                  StockMovement[]
  installationSchedule            InstallationSchedule?
  uteProcesses                    UteProcess[]
  clients                         ProjectClient[]
  unifilarVersions                UnifilarVersion[]
  preIngenieriaVersions           PreIngenieriaVersion[]
  contractDraft                   ContractDraft?
  contractVersions                ContractVersion[]
  proformaDraft                   ProformaDraft?
  proformaVersions                ProformaVersion[]
  technicalVisits                 TechnicalVisit[]
  engineeringFinalProject         EngineeringFinalProject?
  uteDocumentConfig               UteDocumentConfig?
  uteDocumentGenerations          UteDocumentGeneration[]
  informes                        Informe[]                @relation("InformesDeProyecto")
  emailLogs                       EmailLog[]               @relation("EmailLogProject")
  clientInteractions              ClientInteraction[]
  recorridoChecks                 RecorridoCheck[]
  traspasos                       Traspaso[]
  reporteFvConfig                 ReporteFvConfig?
  reporteFvLecturas               ReporteFvLectura[]
  reporteFvCalculos               ReporteFvCalculo[]
  reporteFvEmisiones              ReporteFvEmision[]
  reporteFvGeneracionesDiarias    ReporteFvGeneracionDiaria[]
  growattPlant                    GrowattPlant?
  huaweiPlant                     HuaweiPlant?
  fvIncidencias                   FvIncidencia[]
  projectVideos                   ProjectVideo[]
  installerPayment                InstallerPayment?
  // Sub-fase del E3 (Post-Habilitación). Solo se setea cuando el proyecto llega
  // a POST_HABILITACION (T7). E3-A = compromiso comercial (año 0-2); E3-B = vida
  // útil extendida (año 2-25). Es un flag interno para reportes, no cambia la etapa.
  postHabilitacionSubFase         PostHabilitacionSubFase?
  postHabilitacionInicioEn        DateTime?                @db.Timestamptz(6)
  postHabilitacionFechaAproximada Boolean                  @default(false)
  // Etapa fijada a mano para la vista (dashboard/lista). "Empujón hacia
  // adelante": la etapa mostrada es la MÁS AVANZADA entre la derivada de las
  // sub-tareas y esta. Permite avanzar aunque quede un ítem pendiente. Se setea
  // al confirmar un traspaso (por defecto) o manualmente; null = 100% automático.
  stageOverride                   StageType?
  // Equipo de obra tercerizado vs propio. Condiciona sub-tareas del pipeline
  // (ej. logística de envío en Compras). Spec v3, C13.
  equipoTercerizado               Boolean                  @default(false)
  // Regla de Oro del aviso post-habilitación (§8.2): se setea cuando CX registra
  // el aviso al cliente de que ya puede encender. Mientras esté null y
  // postHabilitacionInicioEn tenga valor, el cron alerta a las 24/48hs.
  avisoHabilitacionEn             DateTime?                @db.Timestamptz(6)
  // Override manual del recorrido E1/E2/E3 en Experiencia Solar (útil para
  // clientes importados sin pipeline). Si está seteado, pisa el derivado.
  recorridoManual                 String?
  // Datos del cliente que se cargan desde el form del proyecto y/o se
  // extraen de la cédula con IA. Ver feature ute-doc-extraction.
  // nombreCliente: nombre tal cual figura en la cédula, usado en los docs
  // UTE. Independiente de clientName (nombre del proyecto). Puede coincidir
  // pero la extracción de cédula sólo toca este campo, nunca clientName.
  nombreCliente                   String                   @default("")
  ciCliente                       String                   @default("")
  calle                           String                   @default("")
  numCalle                        String                   @default("")
  personaFisica                   Boolean                  @default(true)
  empresa                         Boolean                  @default(false)
  // Rutas relativas dentro de STORAGE_PATH/projects/{id}/ute-docs/
  cedulaPath                      String?
  facturaUtePath                  String?
  // Generador "liviano" cargado por CSV en Experiencia Solar: existe como cliente
  // pero sin pipeline/obra. Se excluye de la lista de Proyectos (solo vive en
  // Experiencia Solar) hasta que, si alguna vez, se lo convierta en proyecto real.
  importedFromCsv                 Boolean                  @default(false)
  // Omitido de métricas y SLA: proyectos viejos/de seguimiento sin todo cargado
  // que distorsionan los indicadores. Sigue existiendo y visible en el resto de
  // la app (p. ej. seguimiento de trámite UTE); solo NO cuenta en el panel de
  // Tiempos & SLA ni en las métricas. Reversible desde el panel.
  excludedFromMetrics             Boolean                  @default(false)
  // Ampliación de una instalación ya existente. "Es una ampliación" se deriva de
  // que este campo tenga valor: no hay un enum aparte que pueda quedar
  // desincronizado con el vínculo. El árbol es PLANO — una ampliación de una
  // ampliación se cuelga de la misma raíz, nunca del hermano (ver
  // `resolveRootProject` en ampliacion.service.ts).
  //
  // SetNull y no Cascade: borrar la obra original no puede arrastrar la
  // ampliación, que tiene su propia plata, sus materiales y su trámite UTE.
  parentProjectId                 String?
  parentProject                   Project?                 @relation("ProjectAmpliacion", fields: [parentProjectId], references: [id], onDelete: SetNull)
  ampliaciones                    Project[]                @relation("ProjectAmpliacion")
  // Facturación al cliente. No todos los clientes "llevan factura" (algunos exigen
  // factura fiscal y otros no). Una sola factura por proyecto: el estado de emisión
  // vive en el propio proyecto. El check y la nota se editan al crear/editar el
  // proyecto; "marcar emitida" es una acción del módulo Finanzas.
  llevaFactura                    Boolean                  @default(false)
  facturaNota                     String?
  facturaEmitida                  Boolean                  @default(false)
  facturaEmitidaEn                DateTime?                @db.Timestamptz(6)
  deletedAt                       DateTime?                @db.Timestamptz(6)
  createdAt                       DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt                       DateTime                 @updatedAt @db.Timestamptz(6)

  @@index([status])
  @@index([importedFromCsv])
  @@index([parentProjectId])
  @@index([llevaFactura])
  @@index([tenantId])
  @@index([createdById])
  @@index([salespersonId])
  @@index([clientUserId])
  @@index([plannedEndDate])
  @@index([saleDate])
  @@index([deletedAt])
  @@map("projects")
}

// ─── Traspasos entre áreas ───────────────────────────────────────────────────
// Evento formal, persistente y auditable por el cual un área transfiere trabajo
// a otra: condición detectada → modal al actor → confirmación humana → notifica
// a los destinatarios. Red de seguridad: escalación a ADMIN por SLA vencido.

model Traspaso {
  id     String         @id @default(cuid())
  tipo   TraspasoTipo
  estado TraspasoEstado @default(PENDIENTE_CONFIRMACION)

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Payload flexible del contexto (ej. flags del reporte de capataz, nota del emisor).
  payload Json?

  condicionDetectadaEn DateTime @default(now()) @db.Timestamptz(6)

  // Usuario al que se le muestra el modal (el actor que ejecutó la acción).
  modalUsuarioId  String
  modalUsuario    User      @relation("TraspasoModalUsuario", fields: [modalUsuarioId], references: [id], onDelete: Restrict)
  modalMostradoEn DateTime? @db.Timestamptz(6)

  confirmadoEn    DateTime? @db.Timestamptz(6)
  confirmadoPorId String?
  confirmadoPor   User?     @relation("TraspasoConfirmadoPor", fields: [confirmadoPorId], references: [id], onDelete: SetNull)
  notaAlReceptor  String?

  escaladoEn DateTime? @db.Timestamptz(6)

  // "Posponer 6 hs": mientras pospuestoHasta > now, el traspaso se oculta del
  // popup y de la bandeja de Pendientes, y no escala. Al vencer, reaparece.
  pospuestoHasta DateTime? @db.Timestamptz(6)

  destinatarios TraspasoDestinatario[]

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([projectId])
  @@index([estado])
  @@index([modalUsuarioId, estado])
  @@index([tipo, condicionDetectadaEn])
  @@map("traspasos")
}

model TraspasoDestinatario {
  id              String    @id @default(cuid())
  traspasoId      String
  traspaso        Traspaso  @relation(fields: [traspasoId], references: [id], onDelete: Cascade)
  usuarioId       String
  usuario         User      @relation("TraspasoDestinatarioUsuario", fields: [usuarioId], references: [id], onDelete: Cascade)
  // true si entra solo por regla de copia (Gerente de Operaciones o ADMIN).
  esCopia         Boolean   @default(false)
  notificadoInApp Boolean   @default(false)
  notificadoEmail Boolean   @default(false)
  leidoEn         DateTime? @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@unique([traspasoId, usuarioId])
  @@index([usuarioId, leidoEn])
  @@map("traspaso_destinatarios")
}

// ─── Tickets (reclamos/consultas; fase E3 del protocolo) ─────────────────────
// Los abre cualquier área interna o el propio cliente desde el portal. Al
// derivarse a un área técnica dispara T9; al resolverse dispara T10 (motor de
// traspasos). Cuelgan de un Project (= Generador). Comunicación in-app; NUNCA
// email al cliente (guardrail post-incidente mayo 2026).

enum TicketEstado {
  ABIERTO
  DERIVADO
  EN_PROGRESO
  RESUELTO
  CERRADO
}

enum TicketPrioridad {
  BAJA
  MEDIA
  ALTA
}

model Ticket {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  titulo        String
  descripcion   String
  estado        TicketEstado    @default(ABIERTO)
  prioridad     TicketPrioridad @default(MEDIA)
  // "INGENIERIA" | "OPERACIONES" cuando el ticket está derivado a un área técnica.
  areaDerivada  String?
  // true si lo abrió el cliente desde su portal (vs un usuario interno).
  origenCliente Boolean         @default(false)

  // Ids de usuario sin relación (mismo criterio que ProjectNonMaterialCost):
  // el nombre se resuelve en el service con un lookup puntual.
  creadoPorId   String
  asignadoAId   String?
  resueltoEn    DateTime? @db.Timestamptz(6)
  resueltoPorId String?
  cerradoEn     DateTime? @db.Timestamptz(6)

  comentarios TicketComment[]

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  @@index([projectId])
  @@index([estado])
  @@map("tickets")
}

model TicketComment {
  id        String  @id @default(cuid())
  ticketId  String
  ticket    Ticket  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  autorId   String
  contenido String
  // Nota interna del staff que el cliente NO ve en el portal.
  esInterno Boolean @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([ticketId])
  @@map("ticket_comments")
}

// ─── Encuestas de satisfacción (Experiencia Solar — Ola 3a) ──────────────────

enum SurveyTipo {
  OBRA // al cerrar la obra (E1→E2)
  HABILITACION // al finalizar el trámite UTE (E2→E3, = T8)
  ANIVERSARIO // en cada aniversario de la puesta en marcha (E3)
}

enum SurveyEstado {
  PENDIENTE
  RESPONDIDA
}

/// Checks del recorrido de Experiencia Solar.
///
/// Viven acá y NO en el pipeline del proyecto a propósito: al equipo de obra no
/// le aportan y le ensucian su vista, y —sobre todo— acá pueden tener plazo,
/// responsable y estado que vence **sin frenar la obra**. El avance de etapa lo
/// sigue determinando el proyecto; Experiencia Solar acompaña, no avanza.
///
/// Hay dos clases:
///   - **fijos**: los que toda cuenta tiene en su etapa (bienvenida, aviso de
///     fecha de obra, aviso de habilitación…). Se crean del catálogo.
///   - **dinámicos**: uno nuevo por cada hecho repetible. Hoy: cada reprogramación
///     de obra genera su propio check, porque tildar una casilla única y darla por
///     cumplida para siempre es justamente lo que hacía que no se avisara.
model RecorridoCheck {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// E1 | E2 | E3
  recorrido   String
  /// Código del catálogo (ver services/clientes/recorrido-checks.ts).
  codigo      String
  titulo      String
  /// Orden dentro de la etapa.
  orden       Int       @default(0)

  /// Vencimiento. Null = sin plazo (no vence, pero queda pendiente a la vista).
  venceEn     DateTime? @db.Timestamptz(6)

  completadoEn   DateTime? @db.Timestamptz(6)
  completadoPorId String?
  completadoPor  User?     @relation("RecorridoCheckCompletadoPor", fields: [completadoPorId], references: [id], onDelete: SetNull)

  /// Contexto del hecho que lo generó (motivo de la reagenda, fecha nueva…).
  nota        String?
  /// true = generado por un hecho repetible; false = del catálogo fijo.
  esDinamico  Boolean   @default(false)

  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)

  /// Un check fijo por proyecto+código. Los dinámicos usan códigos con sufijo.
  @@unique([projectId, codigo])
  @@index([projectId])
  @@index([recorrido])
  @@map("recorrido_checks")
}

model SatisfactionSurvey {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  tipo    SurveyTipo
  estado  SurveyEstado @default(PENDIENTE)
  // 0 para OBRA/HABILITACION; 1,2,… para cada aniversario. Permite el @@unique
  // que hace idempotente la generación (una por proyecto+tipo+edición).
  edicion Int          @default(0)

  // Tres notas 1-5 (null hasta que el cliente responde) + comentario opcional.
  // `nota` es la primera y la única obligatoria al responder; nota2 y nota3 son
  // opcionales para no sumar fricción (la tasa de respuesta hoy es ~5%). El texto
  // de cada pregunta depende del tipo de encuesta (ver services/encuestas/preguntas.ts).
  // El puntaje de la encuesta es el PROMEDIO de las notas respondidas.
  nota            Int?
  nota2           Int?
  nota3           Int?
  comentario      String?
  respondidaEn    DateTime? @db.Timestamptz(6)
  // Id de usuario CLIENT que respondió (sin relación; lookup puntual en el service).
  respondidaPorId String?

  // Link al T11 disparado si la encuesta dio nota baja. Null si no aplicó.
  traspasoId  String?
  // Null si la generó un job/hook de sistema (hito de etapa o cron de aniversario).
  createdById String?

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  @@unique([projectId, tipo, edicion])
  @@index([projectId])
  @@index([estado])
  @@map("satisfaction_surveys")
}

// Relación many-to-many entre Project y User (rol CLIENT). Reemplaza al
// `Project.clientUserId` que sólo permitía un cliente por proyecto. El campo
// directo se conserva como legacy (deprecado, no se actualiza desde nuevos
// endpoints) para no romper datos preexistentes hasta una migración posterior.
model ProjectClient {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation("ProjectClientUser", fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  createdById String?
  createdBy   User?    @relation("ProjectClientCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
  @@map("project_clients")
}

model SolarSystem {
  id                String     @id @default(cuid())
  projectId         String
  project           Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  order             Int        @default(1)
  description       String?
  inverterBrand     String?
  inverterPowerKw   Decimal?   @db.Decimal(10, 2)
  inverterQuantity  Int?       @default(1)
  inverterPhaseType PhaseType?
  inverterModel     String?
  panelQuantity     Int?
  panelPowerW       Int?
  panelBrand        String?
  panelModel        String?
  deletedAt         DateTime?  @db.Timestamptz(6)
  createdAt         DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime   @updatedAt @db.Timestamptz(6)

  @@unique([projectId, order])
  @@index([projectId])
  @@index([deletedAt])
  @@map("solar_systems")
}

model Stage {
  id                        String           @id @default(cuid())
  projectId                 String
  project                   Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  order                     Int
  name                      StageType
  status                    StageStatus
  progressPercent           Int
  tipoObra                  TipoObra?
  plannedStartDate          DateTime?        @db.Date
  plannedEndDate            DateTime?        @db.Date
  actualStartDate           DateTime?        @db.Date
  actualEndDate             DateTime?        @db.Date
  plannedDurationDays       Int?
  actualDurationDays        Int?
  delayDays                 Int?
  actualDatesManuallyEdited Boolean          @default(false)
  /// @deprecated usar responsibleUserId + relación responsibleUser. Se conserva como referencia.
  responsibleName           String?
  responsibleUserId         String?
  responsibleUser           User?            @relation("StageResponsibleUser", fields: [responsibleUserId], references: [id], onDelete: SetNull)
  notes                     String?
  substages                 Substage[]
  tasks                     Task[]
  files                     FileAttachment[]
  comments                  Comment[]
  deletedAt                 DateTime?        @db.Timestamptz(6)
  createdAt                 DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt                 DateTime         @updatedAt @db.Timestamptz(6)

  @@unique([projectId, order])
  @@unique([projectId, name])
  @@index([projectId, order])
  @@index([projectId, status])
  @@index([status])
  @@index([responsibleUserId])
  @@index([deletedAt])
  @@map("stages")
}

model Substage {
  id                       String           @id @default(cuid())
  stageId                  String
  projectId                String
  order                    Int
  name                     String
  sopCode                  String?
  responsableRol           String?
  status                   SubstageStatus
  progressPercent          Int              @default(0)
  /// @deprecated usar userId + relación user. Se conserva como referencia del rol sugerido heredado del template.
  responsible              String
  userId                   String?
  user                     User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  stage                    Stage            @relation(fields: [stageId], references: [id], onDelete: Cascade)
  project                  Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  dueDate                  DateTime?        @db.Date
  plannedStartDate         DateTime?        @db.Date
  plannedEndDate           DateTime?        @db.Date
  actualStartDate          DateTime?        @db.Date
  actualEndDate            DateTime?        @db.Date
  actualDurationDays       Int?
  delayDays                Int?
  notes                    String?
  isSystem                 Boolean          @default(false)
  isActive                 Boolean          @default(true)
  // Identifica una subetapa system-managed que representa una acción del
  // UteProcess (consultaSentAt, caseOpenedAt, …, finalizedAt). Sólo se setea
  // en subetapas de la stage HABILITACION_UTE generadas por el sync. Cuando
  // está set + isSystem=true, el endpoint bloquea cambios de nombre/orden.
  uteAction                String?
  checklistItems           ChecklistItem[]
  tasks                    Task[]
  files                    FileAttachment[]
  comments                 Comment[]
  projectVideos            ProjectVideo[]   @relation("ProjectVideoSubstage")
  deadline                 DateTime?        @db.Date
  deadlineManuallySet      Boolean          @default(false)
  deadlineNotificationSent Boolean          @default(false)
  deadlineNotifiedAt       DateTime?        @db.Timestamptz(6)
  deletedAt                DateTime?        @db.Timestamptz(6)
  createdAt                DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt                DateTime         @updatedAt @db.Timestamptz(6)

  @@unique([stageId, order])
  @@index([stageId])
  @@index([projectId, status])
  @@index([status])
  @@index([userId])
  @@index([deletedAt])
  @@index([deadline])
  @@index([uteAction])
  @@map("substages")
}

model UserNotificationPreference {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Aviso 3 días antes de un deadline
  deadlineWarning         Boolean @default(true)
  deadlineWarningInApp    Boolean @default(true)
  deadlineWarningEmail    Boolean @default(false)
  deadlineWarningWhatsapp Boolean @default(false)

  // Aviso al completarse la subetapa anterior a la mía
  prevSubstageCompleted         Boolean @default(true)
  prevSubstageCompletedInApp    Boolean @default(true)
  prevSubstageCompletedEmail    Boolean @default(false)
  prevSubstageCompletedWhatsapp Boolean @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@map("user_notification_preferences")
}

enum DeadlineRuleTipo {
  DIAS_DESDE_CREACION
  DIAS_ANTES_INSTALACION
  MANUAL
  SIN_DEADLINE
}

// Reglas globales de cálculo de deadlines. Se matchea por (stageType, sopCode)
// o (stageType, substageName) contra el template de pipeline. Una regla aplica
// a las subetapas correspondientes en TODOS los proyectos.
model DeadlineRule {
  id           String           @id @default(cuid())
  stageType    StageType
  // Identifica la subetapa dentro de la etapa. Si ambos son null, la regla
  // aplica como default a todas las subetapas de ese stageType que no tengan
  // una regla más específica.
  sopCode      String?
  substageName String?
  tipo         DeadlineRuleTipo
  dias         Int?
  activa       Boolean          @default(true)
  createdAt    DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime         @updatedAt @db.Timestamptz(6)

  @@unique([stageType, sopCode, substageName])
  @@index([stageType])
  @@index([activa])
  @@map("deadline_rules")
}

// Plazo objetivo (SLA) por tipo de etapa, en días hábiles. Global: una fila por
// StageType, aplica a todos los proyectos. Alimenta la cuenta regresiva del
// pipeline y la métrica de cumplimiento. Las etapas paralelas/indefinidas
// (POST_HABILITACION, POSTVENTA, SEGUIMIENTO_*) pueden quedar sin fila o con
// `activo=false` → sin cuenta regresiva. Se edita en Administración.
model StageSla {
  id          String    @id @default(cuid())
  stageType   StageType @unique
  diasHabiles Int
  activo      Boolean   @default(true)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)

  @@map("stage_slas")
}

// Cadencia objetivo de contacto por recorrido del cliente (E1/E2/E3): cada
// cuántos días CALENDARIO como máximo debería haber una interacción registrada
// antes de considerar al cliente "sin comunicación". Una fila por recorrido.
// Alimenta el Panel de operaciones (tarjeta "Sin comunicación"). Es config de
// administración, editable sin tocar código (mismo patrón que StageSla).
model RecorridoCadencia {
  id           String   @id @default(cuid())
  recorrido    String   @unique // "E1" | "E2" | "E3"
  diasObjetivo Int // días calendario máx. sin contacto
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)

  @@map("recorrido_cadencias")
}

// Tramos de tiempo del embudo comercial (medidos por pares de hitos del lead).
// Alimentan el Panel de ventas (Embudo & SLA) del Dashboard.
enum SalesFunnelStep {
  LEAD_TO_QUOTE // leadCreatedAt → proposalSentAt
  QUOTE_TO_SCHEDULED // proposalSentAt → visitScheduledAt
  SCHEDULED_TO_VISIT // visitScheduledAt → visitCompletedAt
  VISIT_TO_CLOSE // visitCompletedAt → closedAt (ganado)
  CLOSE_TO_PROJECT // closedAt → convertedAt (handoff a proyecto)
}

// Plazo objetivo (días HÁBILES) de cada tramo del embudo comercial. Una fila por
// tramo. Config de administración, editable sin tocar código (mismo patrón que
// StageSla / RecorridoCadencia). Alimenta el Panel de ventas del Dashboard.
model SalesStageSla {
  id          String          @id @default(cuid())
  step        SalesFunnelStep @unique
  diasHabiles Int
  activo      Boolean         @default(true)
  createdAt   DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime        @updatedAt @db.Timestamptz(6)

  @@map("sales_stage_slas")
}

// Qué tipos de notificación entran al resumen diario (digest) de cada rol.
// Modelo OPT-IN: la existencia de una fila = ese rol recibe ese tipo. Sin fila
// = no lo recibe (un tipo nuevo arranca apagado para todos hasta que se tilde
// en Administración → Resumen diario). `roleName` es el name del rol (tabla
// roles es dinámica, no un enum).
model DigestPreference {
  id               String           @id @default(cuid())
  roleName         String
  notificationType NotificationType
  createdAt        DateTime         @default(now()) @db.Timestamptz(6)

  @@unique([roleName, notificationType])
  @@index([roleName])
  @@map("digest_preferences")
}

model ChecklistItem {
  id                       String         @id @default(cuid())
  substageId               String
  substage                 Substage       @relation(fields: [substageId], references: [id], onDelete: Cascade)
  projectId                String
  project                  Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  order                    Int
  label                    String
  completed                Boolean        @default(false)
  completedAt              DateTime?      @db.Timestamptz(6)
  completedBy              String?
  user                     User?          @relation("ChecklistCompletedBy", fields: [completedBy], references: [id], onDelete: SetNull)
  notes                    String?
  isRequired               Boolean        @default(false)
  isBlocker                Boolean        @default(false)
  isCustom                 Boolean        @default(false)
  // Tipo de evidencia que respalda este ítem. Cuando está seteado, el ítem deja
  // de ser una casilla de confianza: se marca solo al aparecer la evidencia y no
  // se puede tildar a mano sin ella. Hoy el único valor es "ensayo-video".
  //
  // Es una columna y no un match por `label` porque los labels son editables
  // desde la UI (PATCH /checklist/:itemId): cualquier comparación por texto se
  // rompería el día que alguien corrige una tilde.
  evidenceKind             String?
  appliesWhenModalidadPago ModalidadPago?
  comments                 Comment[]
  deletedAt                DateTime?      @db.Timestamptz(6)
  createdAt                DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt                DateTime       @updatedAt @db.Timestamptz(6)

  @@index([substageId])
  @@index([completed])
  @@index([projectId])
  @@index([deletedAt])
  @@map("checklist_items")
}

enum ObraChecklistStatus {
  PENDING
  OK
}

model ChecklistTemplate {
  id          String                 @id @default(cuid())
  name        String
  description String?
  order       Int                    @default(0)
  isActive    Boolean                @default(true)
  createdAt   DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime               @updatedAt @db.Timestamptz(6)
  instances   ProjectChecklistItem[]

  @@index([isActive, order])
  @@map("checklist_templates")
}

model ProjectChecklistItem {
  id            String              @id @default(cuid())
  projectId     String
  project       Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  templateId    String?
  template      ChecklistTemplate?  @relation(fields: [templateId], references: [id], onDelete: SetNull)
  name          String
  description   String?
  order         Int                 @default(0)
  status        ObraChecklistStatus @default(PENDING)
  observation   String?
  completedById String?
  completedBy   User?               @relation("ObraChecklistCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)
  completedAt   DateTime?           @db.Timestamptz(6)
  createdAt     DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime            @updatedAt @db.Timestamptz(6)

  @@index([projectId])
  @@index([projectId, status])
  @@map("project_checklist_items")
}

model Task {
  id          String         @id @default(cuid())
  // Si projectId es null, es una "tarea suelta" (standalone) — no atada a un
  // proyecto. Se gestiona desde "Mis Tareas". Las tareas atadas a un proyecto
  // mantienen el comportamiento anterior (cascade delete con el proyecto).
  projectId   String?
  // Un pendiente comercial cuelga de un lead en lugar de un proyecto. Conviven:
  // una ampliación sobre una instalación existente tiene proyecto, un reclamo
  // previo a la venta tiene lead. La regla "nunca huérfano" se valida en la capa
  // que crea (conector, minutas), no acá: las tareas sueltas de Mis Tareas son
  // legítimamente `projectId: null` sin lead.
  leadId      String?
  stageId     String?
  substageId  String?
  title       String
  description String?
  status      TaskStatus
  priority    TaskPriority
  origin      TaskOrigin     @default(MANUAL)
  // Qué se está esperando y cuándo reconsultar. Solo tienen sentido con
  // status WAITING.
  waitingReason String?
  followUpAt    DateTime?    @db.Date
  /// @deprecated usar userId + relación user. Se conserva como referencia legacy.
  responsible String
  // userId = asignado "primario" (legacy). Se mantiene sincronizado con el
  // primer elemento de `assignees` para retrocompat; la fuente de verdad de la
  // asignación es la tabla `assignees` (many-to-many), que permite varios
  // responsables por tarea. Cualquiera de ellos puede resolverla.
  userId      String?
  user        User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  assignees   TaskAssignee[]
  project     Project?       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  lead        SalesLead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  stage       Stage?         @relation(fields: [stageId], references: [id], onDelete: SetNull)
  substage    Substage?      @relation(fields: [substageId], references: [id], onDelete: SetNull)
  comments    Comment[]
  dueDate     DateTime?      @db.Date
  completedAt DateTime?      @db.Timestamptz(6)
  deletedAt   DateTime?      @db.Timestamptz(6)
  createdAt   DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime       @updatedAt @db.Timestamptz(6)

  @@index([projectId])
  @@index([leadId])
  @@index([status])
  @@index([projectId, status])
  @@index([userId])
  @@index([dueDate])
  @@index([deletedAt])
  @@map("tasks")
}

// Asignados de una tarea (many-to-many Task ↔ User). Una tarea puede tener
// varios responsables y cualquiera puede resolverla. Reemplaza al único
// `Task.userId` como fuente de verdad de la asignación (el userId se mantiene
// como "primario" legacy sincronizado con el primer assignee).
model TaskAssignee {
  id        String   @id @default(cuid())
  taskId    String
  userId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@unique([taskId, userId])
  @@index([userId])
  @@index([taskId])
  @@map("task_assignees")
}

// ───────────────────────────────────────────────────────────────────────────
// Conector MCP: piezas del OAuth propio
//
// El conector expone Voltia PM como herramientas dentro del chat de Claude. La
// autorización es un OAuth 2.1 mínimo sobre el mismo login de la app: el
// usuario entra con su email y contraseña, autoriza, y Claude recibe un token.
//
// Sólo se persisten las dos piezas que no pueden ser stateless: el código de
// autorización (un solo uso) y el refresh token (revocable). El access token es
// un JWT con `typ: "mcp"` y no necesita tabla.
// ───────────────────────────────────────────────────────────────────────────

/// Código de autorización OAuth. Vida corta y un solo uso: se marca `usedAt` al
/// canjearlo. Se guarda el hash, no el código, para que una filtración de la
/// base no permita canjearlos.
model McpAuthCode {
  id            String    @id @default(cuid())
  codeHash      String    @unique
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId      String
  redirectUri   String
  /// PKCE S256: el desafío que el cliente tiene que poder resolver al canjear.
  codeChallenge String
  scope         String
  expiresAt     DateTime  @db.Timestamptz(6)
  usedAt        DateTime? @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)

  @@index([userId])
  @@index([expiresAt])
  @@map("mcp_auth_codes")
}

/// Refresh token del conector. Se rota en cada uso —lo exige la spec para
/// clientes públicos—: al canjear uno se marca `revokedAt` y se apunta al que
/// lo reemplazó, así queda la cadena para auditar.
model McpRefreshToken {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId    String
  scope       String
  expiresAt   DateTime  @db.Timestamptz(6)
  revokedAt   DateTime? @db.Timestamptz(6)
  /// Id del token que lo reemplazó al rotar. Null si nunca se usó.
  rotatedToId String?
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)

  @@index([userId])
  @@index([expiresAt])
  @@map("mcp_refresh_tokens")
}

model FileAttachment {
  id                     String                 @id @default(cuid())
  // Un FileAttachment debe estar ligado a UN owner: o un Project, o un
  // SalesLead. La validación (XOR) se hace a nivel de service.
  projectId              String?
  leadId                 String?
  stageId                String?
  substageId             String?
  // Owner alternativo: adjunto de un Informe (módulo Informes). Parte del XOR
  // de owner — la validación que exige exactamente uno de
  // project/lead/stage/substage/informe se hace a nivel de service.
  informeId              String?
  filename               String
  storedFilename         String
  mimeType               String
  sizeBytes              Int
  url                    String
  tipo                   FileAttachmentTipo? // null = upload manual legacy
  // Trazabilidad fina del origen para documentos generados por herramientas del
  // módulo Ingeniería. `tipo` queda como índice grueso (UNIFILAR, etc.); estos
  // campos permiten badges "Ingeniería: Unifilar v3" y filtros por origen.
  toolSource             String?
  toolVersion            Int?
  toolEntityId           String?
  uploadedById           String
  uploadedBy             User                   @relation("FileUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)
  project                Project?               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  lead                   SalesLead?             @relation("LeadAttachments", fields: [leadId], references: [id], onDelete: Cascade)
  stage                  Stage?                 @relation(fields: [stageId], references: [id], onDelete: SetNull)
  substage               Substage?              @relation(fields: [substageId], references: [id], onDelete: SetNull)
  informe                Informe?               @relation("InformeAdjuntos", fields: [informeId], references: [id], onDelete: Cascade)
  preIngenieriaFotos     PreIngenieriaFoto[]
  preIngenieriaMinutaFor PreIngenieriaVersion[] @relation("MinutaSource")
  efpAttachments         EFPAttachment[]        @relation("EFPAttachmentFile")
  proposalGenerations    ProposalGeneration[]   @relation("ProposalAttachment")
  proposalV2Covers       ProposalDefaults[]     @relation("ProposalV2Cover")
  proposalV2CoversEmpresa ProposalDefaults[]    @relation("ProposalV2CoverEmpresa")
  reporteFvEmisiones     ReporteFvEmision[]     @relation("ReporteFvPdf")
  projectVideos          ProjectVideo[]         @relation("ProjectVideoFile")
  deletedAt              DateTime?              @db.Timestamptz(6)
  createdAt              DateTime               @default(now()) @db.Timestamptz(6)

  @@index([projectId])
  @@index([leadId])
  @@index([informeId])
  @@index([uploadedById])
  @@index([deletedAt])
  @@index([toolSource])
  @@map("file_attachments")
}

enum FileAttachmentTipo {
  UPLOAD_MANUAL
  LISTA_MATERIALES
  PRESUPUESTO
  CALCULO_TRIANGULOS
  UNIFILAR
  PRE_INGENIERIA
  MINUTA_RELEVAMIENTO
  REPORTE_FOTOVOLTAICO
  OTRO
}

// ─── Módulo Informes ──────────────────────────────────────────────────────────
// Informes con revisión dirigida y visibilidad row-level (autor + destinatarios).
// Una sola pasada: BORRADOR → PENDIENTE → APROBADO | DEVUELTO. Ver SPEC.

enum InformeEstado {
  BORRADOR
  PENDIENTE
  APROBADO
  DEVUELTO
}

enum InformeRespuesta {
  PENDIENTE
  APROBADO
  DEVUELTO
}

model Informe {
  id     String        @id @default(cuid())
  titulo String
  cuerpo String // texto del informe (markdown/plano)
  // Estado consolidado MATERIALIZADO: se recalcula en cada respuesta/envío.
  estado InformeEstado @default(BORRADOR)

  autorId String
  autor   User   @relation("InformesCreados", fields: [autorId], references: [id], onDelete: Restrict)

  projectId String? // vínculo OPCIONAL a obra
  project   Project? @relation("InformesDeProyecto", fields: [projectId], references: [id], onDelete: SetNull)

  destinatarios InformeDestinatario[]
  adjuntos      FileAttachment[]      @relation("InformeAdjuntos")

  enviadoAt DateTime? @db.Timestamptz(6) // null mientras BORRADOR
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)

  @@index([autorId])
  @@index([projectId])
  @@index([estado])
  @@map("informes")
}

model InformeDestinatario {
  id        String  @id @default(cuid())
  informeId String
  informe   Informe @relation(fields: [informeId], references: [id], onDelete: Cascade)

  usuarioId String
  usuario   User   @relation("InformesRecibidos", fields: [usuarioId], references: [id], onDelete: Restrict)

  respuesta    InformeRespuesta @default(PENDIENTE)
  comentario   String? // motivo de devolución o nota de aprobación
  respondidoAt DateTime?        @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@unique([informeId, usuarioId]) // un usuario no puede ser destinatario dos veces
  @@index([usuarioId])
  @@map("informe_destinatarios")
}

model AuditLog {
  id           String          @id @default(cuid())
  entityType   AuditEntityType
  entityId     String
  projectId    String?
  project      Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  userId       String
  user         User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  action       AuditAction
  fieldChanged String?
  oldValue     String?
  newValue     String?
  description  String
  timestamp    DateTime        @default(now()) @db.Timestamptz(6)
  metadata     Json?

  @@index([entityType, entityId])
  @@index([projectId])
  @@index([projectId, timestamp])
  @@index([timestamp])
  @@index([userId])
  @@map("audit_logs")
}

model Notification {
  id           String           @id @default(cuid())
  userId       String?
  user         User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  projectId    String?
  project      Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  type         NotificationType
