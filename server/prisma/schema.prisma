enum Action {
  VIEW
  CREATE
  EDIT
  DELETE
  COMPLETE
  COMMENT
  // ACCESS = SIN USO. Se pensó como gate grueso de "puede entrar al módulo",
  // separado de los permisos granulares, pero nunca se implementó: Ingeniería
  // (menú, rutas y bloque dentro del proyecto) se gatea entera con VIEW. Se
  // sacó del catálogo de la pantalla de permisos y sus filas se borraron
  // (migración 20260805210000). El valor queda porque Postgres no deja quitar
  // un valor de un enum sin recrear el tipo. Si se reusa, elegir otro nombre o
  // confirmar que ningún rol lo tenga heredado.
  ACCESS
  // ACCESS_MEMORIA = gate de la memoria de cálculo de propuestas
  // (/admin/propuestas/memoria-calculo). Feature admin-only por default.
  ACCESS_MEMORIA
  // DEBUG_CALCULADORA = gate del drawer de debug de cálculo del borrador
  // (constructor de propuestas v2). Feature admin-only por default.
  DEBUG_CALCULADORA
  // CONFIRM = confirmar un traspaso (acuse humano del modal). Módulo TRASPASOS.
  CONFIRM
  // ADMIN_REPORT = ver los reportes agregados de traspasos. Módulo TRASPASOS,
  // admin-only por default.
  ADMIN_REPORT
}

