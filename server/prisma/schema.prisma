generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums existentes ────────────────────────────────────────────────────────

enum ProjectStatus {
  PROSPECT
  ACTIVE
  COMPLETED
  PAUSED
  ARCHIVED
}

enum StageType {
  ONBOARDING
  INGENIERIA
  OPERACIONES
  HABILITACION_UTE
  POSTVENTA
}

enum TipoObra {
  PROPIA
  TERCERIZADA
}

enum ModalidadPago {
  DIRECTO_50_50
  FINANCIACION_BANCARIA
}

enum StageStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum SubstageStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  BLOCKED
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum TaskPriority {
  NORMAL
  URGENT
}

enum AuditEntityType {
  project
  solar_system
  stage
  substage
  task
  file
  user
  notification
  comment
  lead
  proposal
  setting
  permission
  supplier
  finance_movement
  finance_comprobante
  stock_product
  stock_movement
  exchange_rate
  installation_schedule
  team
  material_category
  material_item
  invoice_item
  payment
  payment_application
}

enum AuditAction {
  created
  updated
  deleted
  status_changed
  file_uploaded
  stage_advanced
  alert_triggered
  comment_added
  comment_edited
  comment_deleted
  lead_created
  lead_stage_changed
  lead_converted
  proposal_generated
  setting_changed
  role_changed
  permission_changed
}

enum NotificationType {
  task_due
  stage_changed
  progress_milestone
  substage_blocked
  stage_overdue
  project_delayed
  goals_not_configured
}

enum GoalArea {
  VENTAS
  OPERACIONES
}

enum GoalMetric {
  INSTALLATIONS_COUNT
  KWP_INSTALLED
  LEADS_CREATED
  PROPOSALS_SENT
  CLOSED_WON
}

enum GoalPeriod {
  ANNUAL
  QUARTERLY
}

enum PhaseType {
  MONOFASICO
  TRIFASICO_230
  TRIFASICO_400
}

// ─── Enums nuevos ────────────────────────────────────────────────────────────

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  label       String
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  permissions Permission[]

  @@map("roles")
}

enum Module {
  VENTAS
  ONBOARDING
  INGENIERIA
  OPERACIONES
  HABILITACION
  POSTVENTA
  METRICAS
  CONFIGURACION
  USUARIOS
  FINANZAS
  STOCK
  TRAMITES_UTE
}

enum Moneda {
  USD
  UYU
}

enum MetodoPago {
  TRANSFERENCIA
  EFECTIVO
  CHEQUE
  TARJETA_DEBITO
  TARJETA_CREDITO
  CRYPTO
  OTRO
}

enum TipoMovimiento {
  INGRESO
  GASTO
  AJUSTE
}

enum CategoriaPrincipal {
  FIJO
  VARIABLE
  PROYECTO_ENTRADA
  PROYECTO_SALIDA
  COMPRA_STOCK
  CONSUMO_STOCK
  PAGO_PROVEEDOR
  COBRO_CLIENTE
  OTRO
}

enum EstadoAprobacion {
  BORRADOR
  REGISTRADO
  PENDIENTE_APROBACION
  APROBADO
  RECHAZADO
  ANULADO
}

enum TipoComprobante {
  FACTURA
  NOTA_CREDITO
  TICKET
  PRESUPUESTO
  OTRO
}

enum EstadoComprobante {
  PENDIENTE
  PARCIALMENTE_PAGADO
  PAGADO
  ANULADO
}

enum FinanceMovementStatus {
  PREVISTO
  COMPROMETIDO
  A_PAGAR
  PARCIALMENTE_PAGADO
  PAGADO
}

enum MovementSourceType {
  MANUAL
  PROJECT_MATERIALS
}

enum ExpenseSourceType {
  FACTURA
  DEVOLUCION_PROVEEDOR
  AJUSTE_INVENTARIO
  IMPORTACION_INICIAL
  OTRO
}

enum TipoMovimientoStock {
  INGRESO
  EGRESO
  AJUSTE
}

enum Action {
  VIEW
  CREATE
  EDIT
  DELETE
  COMPLETE
  COMMENT
}

enum SettingLevel {
  SYSTEM
  PROJECT
  USER
}

enum SettingKey {
  DEFAULT_CURRENCY
  DATE_FORMAT
  TIMEZONE
  NOTIFICATIONS_EMAIL
  NOTIFICATIONS_WHATSAPP
  SHOW_BUDGET_IN_PIPELINE
  DEFAULT_LANGUAGE
  CO2_FACTOR
  PROPOSAL_SCRIPT_PATH
  PIPELINE_TEMPLATE
}

enum SalesStage {
  NUEVO_LEAD
  PENDIENTE_COTIZAR
  COTIZADO
  RECLAMADO
  VOLVER_CONTACTAR
  NEGOCIACION
  AGENDAR_VISITA
  VISITADO
  ONBOARDING
  CERRADO_GANADO
  CERRADO_PERDIDO
  MAS_ADELANTE
}

enum ProposalStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// ─── Modelos existentes ───────────────────────────────────────────────────────

model User {
  id                             String                   @id @default(cuid())
  email                          String                   @unique
  password                       String
  name                           String
  roleId                         String
  role                           Role                     @relation(fields: [roleId], references: [id], onDelete: Restrict)
  tenantId                       String?
  avatarUrl                      String?                  @map("avatar_url")
  createdProjects                Project[]                @relation("ProjectCreatedBy")
  projectsSalesperson            Project[]                @relation("ProjectSalesperson")
  assignedSubstages              Substage[]
  assignedStages                 Stage[]                  @relation("StageResponsibleUser")
  completedChecklistItems        ChecklistItem[]          @relation("ChecklistCompletedBy")
  assignedTasks                  Task[]
  uploadedFiles                  FileAttachment[]         @relation("FileUploadedBy")
  auditLogs                      AuditLog[]
  notifications                  Notification[]
  comments                       Comment[]
  settings                       Setting[]                @relation("SettingUser")
  settingsUpdated                Setting[]                @relation("SettingUpdatedBy")
  salesLeadsAssigned             SalesLead[]              @relation("LeadAssignedTo")
  salesLeadsCreated              SalesLead[]              @relation("LeadCreatedBy")
  salesActivities                SalesActivity[]
  proposals                      ProposalGeneration[]     @relation("ProposalGeneratedBy")
  goals                          Goal[]                   @relation("GoalCreatedBy")
  financeMovementsCreated        FinanceMovement[]        @relation("FinanceMovCreadoPor")
  financeMovementsApproved       FinanceMovement[]        @relation("FinanceMovAprobadoPor")
  financeApprovalHistory         FinanceApprovalHistory[]
  paymentsCreated                Payment[]                @relation("PaymentCreatedBy")
  installationSchedulesConfirmed InstallationSchedule[]   @relation("InstallationConfirmedBy")
  deletedAt                      DateTime?                @db.Timestamptz(6)
  createdAt                      DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt                      DateTime                 @updatedAt @db.Timestamptz(6)

  @@index([deletedAt])
  @@index([tenantId])
  @@map("users")
}

model Project {
  id                   String                @id @default(cuid())
  code                 String                @unique
  tenantId             String?
  clientName           String
  capacityKwp          Decimal               @db.Decimal(10, 2)
  locationCity         String
  locationProvince     String
  status               ProjectStatus
  startDate            DateTime              @db.Date
  plannedEndDate       DateTime?             @db.Date
  actualEndDate        DateTime?             @db.Date
  budgetUsd            Decimal?              @db.Decimal(14, 2)
  executedUsd          Decimal               @db.Decimal(14, 2)
  estimatedMwhYear     Decimal?              @db.Decimal(10, 2)
  co2TonsAvoided       Decimal?              @db.Decimal(10, 2)
  actualOnboardingEnd  DateTime?             @db.Date
  actualEngineeringEnd DateTime?             @db.Date
  actualUteStart       DateTime?             @db.Date
  actualUteEnd         DateTime?             @db.Date
  modalidadPago        ModalidadPago?
  firstDateScheduledAt DateTime?             @db.Timestamptz(6)
  notificationEmail    String?
  notificationPhone    String?
  clientAddress        String?
  uteCodigoPS          String?
  uteCodigoAS          String?
  createdById          String
  createdBy            User                  @relation("ProjectCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  salespersonId        String?
  salesperson          User?                 @relation("ProjectSalesperson", fields: [salespersonId], references: [id], onDelete: SetNull)
  stages               Stage[]
  substages            Substage[]
  checklistItems       ChecklistItem[]
  tasks                Task[]
  files                FileAttachment[]
  auditLogs            AuditLog[]
  notifications        Notification[]
  comments             Comment[]
  settings             Setting[]             @relation("SettingProject")
  convertedLeads       SalesLead[]           @relation("LeadConvertedTo")
  proposals            ProposalGeneration[]  @relation("ProposalProject")
  solarSystems         SolarSystem[]
  financeMovements     FinanceMovement[]
  projectMaterials     ProjectMaterial[]
  stockMovements       StockMovement[]
  installationSchedule InstallationSchedule?
  uteProcesses         UteProcess[]
  deletedAt            DateTime?             @db.Timestamptz(6)
  createdAt            DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime              @updatedAt @db.Timestamptz(6)

  @@index([status])
  @@index([tenantId])
  @@index([createdById])
  @@index([salespersonId])
  @@index([plannedEndDate])
  @@index([deletedAt])
  @@map("projects")
}

model SolarSystem {
  id                String     @id @default(cuid())
  projectId         String
  project           Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  order             Int        @default(1)
  description       String?
  inverterBrand     String?
  inverterPowerKw   Decimal?   @db.Decimal(10, 2)
  inverterQuantity  Int?       @default(1)
  inverterPhaseType PhaseType?
  inverterModel     String?
  panelQuantity     Int?
  panelPowerW       Int?
  panelBrand        String?
  panelModel        String?
  deletedAt         DateTime?  @db.Timestamptz(6)
  createdAt         DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime   @updatedAt @db.Timestamptz(6)

  @@unique([projectId, order])
  @@index([projectId])
  @@index([deletedAt])
  @@map("solar_systems")
}

model Stage {
  id                        String           @id @default(cuid())
  projectId                 String
  project                   Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  order                     Int
  name                      StageType
  status                    StageStatus
  progressPercent           Int
  tipoObra                  TipoObra?
  plannedStartDate          DateTime?        @db.Date
  plannedEndDate            DateTime?        @db.Date
  actualStartDate           DateTime?        @db.Date
  actualEndDate             DateTime?        @db.Date
  plannedDurationDays       Int?
  actualDurationDays        Int?
  delayDays                 Int?
  actualDatesManuallyEdited Boolean          @default(false)
  /// @deprecated usar responsibleUserId + relación responsibleUser. Se conserva como referencia.
  responsibleName           String?
  responsibleUserId         String?
  responsibleUser           User?            @relation("StageResponsibleUser", fields: [responsibleUserId], references: [id], onDelete: SetNull)
  notes                     String?
  substages                 Substage[]
  tasks                     Task[]
  files                     FileAttachment[]
  comments                  Comment[]
  deletedAt                 DateTime?        @db.Timestamptz(6)
  createdAt                 DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt                 DateTime         @updatedAt @db.Timestamptz(6)

  @@unique([projectId, order])
  @@unique([projectId, name])
  @@index([projectId, order])
  @@index([projectId, status])
  @@index([status])
  @@index([responsibleUserId])
  @@index([deletedAt])
  @@map("stages")
}

model Substage {
  id                 String           @id @default(cuid())
  stageId            String
  projectId          String
  order              Int
  name               String
  sopCode            String?
  responsableRol     String?
  status             SubstageStatus
  progressPercent    Int              @default(0)
  /// @deprecated usar userId + relación user. Se conserva como referencia del rol sugerido heredado del template.
  responsible        String
  userId             String?
  user               User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  stage              Stage            @relation(fields: [stageId], references: [id], onDelete: Cascade)
  project            Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  dueDate            DateTime?        @db.Date
  plannedStartDate   DateTime?        @db.Date
  plannedEndDate     DateTime?        @db.Date
  actualStartDate    DateTime?        @db.Date
  actualEndDate      DateTime?        @db.Date
  actualDurationDays Int?
  delayDays          Int?
  notes              String?
  isSystem           Boolean          @default(false)
  isActive           Boolean          @default(true)
  checklistItems     ChecklistItem[]
  tasks              Task[]
  files              FileAttachment[]
  comments           Comment[]
  deletedAt          DateTime?        @db.Timestamptz(6)
  createdAt          DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime         @updatedAt @db.Timestamptz(6)

  @@unique([stageId, order])
  @@index([stageId])
  @@index([projectId, status])
  @@index([status])
  @@index([userId])
  @@index([deletedAt])
  @@map("substages")
}

model ChecklistItem {
  id                       String         @id @default(cuid())
  substageId               String
  substage                 Substage       @relation(fields: [substageId], references: [id], onDelete: Cascade)
  projectId                String
  project                  Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  order                    Int
  label                    String
  completed                Boolean        @default(false)
  completedAt              DateTime?      @db.Timestamptz(6)
  completedBy              String?
  user                     User?          @relation("ChecklistCompletedBy", fields: [completedBy], references: [id], onDelete: SetNull)
  notes                    String?
  isRequired               Boolean        @default(false)
  isBlocker                Boolean        @default(false)
  isCustom                 Boolean        @default(false)
  appliesWhenModalidadPago ModalidadPago?
  comments                 Comment[]
  deletedAt                DateTime?      @db.Timestamptz(6)
  createdAt                DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt                DateTime       @updatedAt @db.Timestamptz(6)

  @@index([substageId])
  @@index([completed])
  @@index([projectId])
  @@index([deletedAt])
  @@map("checklist_items")
}

model Task {
  id          String       @id @default(cuid())
  projectId   String
  stageId     String?
  substageId  String?
  title       String
  description String?
  status      TaskStatus
  priority    TaskPriority
  /// @deprecated usar userId + relación user. Se conserva como referencia legacy.
  responsible String
  userId      String?
  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stage       Stage?       @relation(fields: [stageId], references: [id], onDelete: SetNull)
  substage    Substage?    @relation(fields: [substageId], references: [id], onDelete: SetNull)
  comments    Comment[]
  dueDate     DateTime?    @db.Date
  completedAt DateTime?    @db.Timestamptz(6)
  deletedAt   DateTime?    @db.Timestamptz(6)
  createdAt   DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(6)

  @@index([projectId])
  @@index([status])
  @@index([projectId, status])
  @@index([userId])
  @@index([dueDate])
  @@index([deletedAt])
  @@map("tasks")
}

model FileAttachment {
  id             String    @id @default(cuid())
  projectId      String
  stageId        String?
  substageId     String?
  filename       String
  storedFilename String
  mimeType       String
  sizeBytes      Int
  url            String
  uploadedById   String
  uploadedBy     User      @relation("FileUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stage          Stage?    @relation(fields: [stageId], references: [id], onDelete: SetNull)
  substage       Substage? @relation(fields: [substageId], references: [id], onDelete: SetNull)
  deletedAt      DateTime? @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)

  @@index([projectId])
  @@index([uploadedById])
  @@index([deletedAt])
  @@map("file_attachments")
}

model AuditLog {
  id           String          @id @default(cuid())
  entityType   AuditEntityType
  entityId     String
  projectId    String?
  project      Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  userId       String
  user         User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  action       AuditAction
  fieldChanged String?
  oldValue     String?
  newValue     String?
  description  String
  timestamp    DateTime        @default(now()) @db.Timestamptz(6)
  metadata     Json?

  @@index([entityType, entityId])
  @@index([projectId])
  @@index([projectId, timestamp])
  @@index([timestamp])
  @@index([userId])
  @@map("audit_logs")
}

model Notification {
  id           String           @id @default(cuid())
  userId       String?
  user         User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  projectId    String?
  project      Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  type         NotificationType
  title        String
  message      String
  read         Boolean          @default(false)
  sentEmail    Boolean          @default(false)
  sentWhatsapp Boolean          @default(false)
  createdAt    DateTime         @default(now()) @db.Timestamptz(6)

  @@index([userId, read])
  @@index([projectId])
  @@index([projectId, type])
  @@map("notifications")
}

// ─── Modelos nuevos ───────────────────────────────────────────────────────────

model Permission {
  id        String   @id @default(cuid())
  roleId    String
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  module    Module
  action    Action
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@unique([roleId, module, action])
  @@index([roleId])
  @@map("permissions")
}

model Comment {
  id              String         @id @default(cuid())
  content         String
  authorId        String
  author          User           @relation(fields: [authorId], references: [id], onDelete: Restrict)
  projectId       String?
  project         Project?       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  leadId          String?
  lead            SalesLead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  stageId         String?
  stage           Stage?         @relation(fields: [stageId], references: [id], onDelete: SetNull)
  substageId      String?
  substage        Substage?      @relation(fields: [substageId], references: [id], onDelete: SetNull)
  checklistItemId String?
  checklistItem   ChecklistItem? @relation(fields: [checklistItemId], references: [id], onDelete: SetNull)
  taskId          String?
  task            Task?          @relation(fields: [taskId], references: [id], onDelete: SetNull)
  isEdited        Boolean        @default(false)
  editedAt        DateTime?      @db.Timestamptz(6)
  deletedAt       DateTime?      @db.Timestamptz(6)
  createdAt       DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime       @updatedAt @db.Timestamptz(6)

  @@index([projectId])
  @@index([leadId])
  @@index([stageId])
  @@index([substageId])
  @@index([checklistItemId])
  @@index([taskId])
  @@index([authorId])
  @@index([deletedAt])
  @@map("comments")
}

model Setting {
  id          String       @id @default(cuid())
  level       SettingLevel
  key         SettingKey
  value       String
  userId      String?
  user        User?        @relation("SettingUser", fields: [userId], references: [id], onDelete: SetNull)
  projectId   String?
  project     Project?     @relation("SettingProject", fields: [projectId], references: [id], onDelete: Cascade)
  updatedById String
  updatedBy   User         @relation("SettingUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(6)

  @@unique([level, key, userId, projectId])
  @@index([level, key])
  @@map("settings")
}

model SalesLead {
  id                   String               @id @default(cuid())
  code                 String               @unique
  tenantId             String?
  clientName           String
  clientEmail          String?
  clientPhone          String?
  address              String?
  stage                SalesStage           @default(NUEVO_LEAD)
  estimatedKwp         Decimal?             @db.Decimal(10, 2)
  estimatedBudgetUsd   Decimal?             @db.Decimal(14, 2)
  uteBillMonthlyUsd    Decimal?             @db.Decimal(10, 2)
  roofType             String?
  notes                String?
  lostReason           String?
  proposalSentAt       DateTime?            @db.Timestamptz(6)
  visitScheduledAt     DateTime?            @db.Timestamptz(6)
  visitCompletedAt     DateTime?            @db.Timestamptz(6)
  closedAt             DateTime?            @db.Timestamptz(6)
  assignedToId         String?
  assignedTo           User?                @relation("LeadAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  convertedToProjectId String?
  convertedToProject   Project?             @relation("LeadConvertedTo", fields: [convertedToProjectId], references: [id], onDelete: SetNull)
  convertedAt          DateTime?            @db.Timestamptz(6)
  createdById          String
  createdBy            User                 @relation("LeadCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  activities           SalesActivity[]
  proposals            ProposalGeneration[] @relation("ProposalLead")
  comments             Comment[]
  deletedAt            DateTime?            @db.Timestamptz(6)
  createdAt            DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime             @updatedAt @db.Timestamptz(6)

  @@index([stage])
  @@index([tenantId])
  @@index([assignedToId])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("sales_leads")
}

model SalesActivity {
  id        String      @id @default(cuid())
  leadId    String
  lead      SalesLead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  fromStage SalesStage?
  toStage   SalesStage?
  action    String
  notes     String?
  createdAt DateTime    @default(now()) @db.Timestamptz(6)

  @@index([leadId])
  @@index([createdAt])
  @@map("sales_activities")
}

model Goal {
  id          String     @id @default(cuid())
  area        GoalArea
  metric      GoalMetric
  period      GoalPeriod
  year        Int
  quarter     Int?
  targetValue Decimal    @db.Decimal(14, 2)
  createdById String
  createdBy   User       @relation("GoalCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime   @updatedAt @db.Timestamptz(6)

  @@unique([area, metric, period, year, quarter])
  @@index([area])
  @@index([year])
  @@map("goals")
}

model ProposalGeneration {
  id             String         @id @default(cuid())
  leadId         String?
  lead           SalesLead?     @relation("ProposalLead", fields: [leadId], references: [id], onDelete: SetNull)
  projectId      String?
  project        Project?       @relation("ProposalProject", fields: [projectId], references: [id], onDelete: SetNull)
  inputFilePath  String?
  outputFilePath String?
  status         ProposalStatus @default(PENDING)
  errorMessage   String?
  generatedById  String
  generatedBy    User           @relation("ProposalGeneratedBy", fields: [generatedById], references: [id], onDelete: Restrict)
  createdAt      DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(6)

  @@index([leadId])
  @@index([projectId])
  @@index([status])
  @@map("proposal_generations")
}

// ─── Módulo Finanzas & Stock ──────────────────────────────────────────────────

model Supplier {
  id             String    @id @default(cuid())
  nombre         String
  rut            String?
  contactoNombre String?
  email          String?
  telefono       String?
  direccion      String?
  condicionPago  String?
  activo         Boolean   @default(true)
  notas          String?
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  movimientos      FinanceMovement[]
  payments         Payment[]
  comprobantes     FinanceComprobante[]
  movimientosStock StockMovement[]
  materialItems    MaterialItem[]
  projectMaterials ProjectMaterial[]

  @@index([activo])
  @@map("suppliers")
}

model FinanceSubcategory {
  id        String             @id @default(cuid())
  nombre    String
  categoria CategoriaPrincipal
  activa    Boolean            @default(true)
  createdAt DateTime           @default(now())

  movimientos FinanceMovement[]

  @@unique([nombre, categoria])
  @@map("finance_subcategories")
}

model ExchangeRate {
  id        String   @id @default(cuid())
  date      DateTime @default(now())
  usdToUyu  Decimal  @db.Decimal(10, 4)
  source    String   @default("manual")
  createdBy String?
  createdAt DateTime @default(now())

  @@index([date])
  @@map("exchange_rates")
}

model FinanceMovement {
  id                  String                   @id @default(cuid())
  fecha               DateTime
  mes                 Int
  anio                Int
  tipoMovimiento      TipoMovimiento
  categoriaPrincipal  CategoriaPrincipal
  subcategoriaId      String?
  subcategoria        FinanceSubcategory?      @relation(fields: [subcategoriaId], references: [id])
  descripcion         String
  monto               Decimal                  @db.Decimal(14, 2)
  moneda              Moneda                   @default(USD)
  tipoCambio          Decimal?                 @db.Decimal(10, 4)
  pagado              Boolean                  @default(false)
  cobrado             Boolean                  @default(false)
  impactaFlujo        Boolean                  @default(true)
  status              FinanceMovementStatus    @default(PAGADO)
  expectedDate        DateTime?                @db.Date
  dueDate             DateTime?                @db.Date
  sourceType          MovementSourceType       @default(MANUAL)
  materialItemId      String?
  materialItem        MaterialItem?            @relation(fields: [materialItemId], references: [id])
  quantity            Decimal?                 @db.Decimal(10, 2)
  unitPrice           Decimal?                 @db.Decimal(12, 2)
  // Desglose de factura → impacta stock cuando pasa a A_PAGAR
  requiresItemDetail  Boolean                  @default(false)
  hasItemDetail       Boolean                  @default(false)
  noTieneMateriales   Boolean                  @default(false)
  depositoIngresoId   String?
  invoiceItems        InvoiceItem[]
  projectId           String?
  project             Project?                 @relation(fields: [projectId], references: [id])
  supplierId          String?
  supplier            Supplier?                @relation(fields: [supplierId], references: [id])
  observaciones       String?
  estadoAprobacion    EstadoAprobacion         @default(REGISTRADO)
  archivoAdjuntoUrl   String?
  paymentApplications PaymentApplication[]
  comprobantes        FinanceComprobante[]
  movimientosStock    StockMovement[]
  historial           FinanceApprovalHistory[]
  projectMaterial     ProjectMaterial?
  creadoPorId         String?
  creadoPor           User?                    @relation("FinanceMovCreadoPor", fields: [creadoPorId], references: [id])
  aprobadoPorId       String?
  aprobadoPor         User?                    @relation("FinanceMovAprobadoPor", fields: [aprobadoPorId], references: [id])
  deletedAt           DateTime?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  @@index([fecha])
  @@index([mes, anio])
  @@index([projectId])
  @@index([categoriaPrincipal])
  @@index([estadoAprobacion])
  @@index([tipoMovimiento])
  @@index([status])
  @@index([sourceType])
  @@index([dueDate])
  @@map("finance_movements")
}

model FinanceComprobante {
  id               String                      @id @default(cuid())
  supplierId       String
  supplier         Supplier                    @relation(fields: [supplierId], references: [id])
  numero           String?
  tipo             TipoComprobante             @default(FACTURA)
  concepto         String
  monto            Decimal                     @db.Decimal(14, 2)
  moneda           Moneda                      @default(USD)
  fechaEmision     DateTime
  fechaVencimiento DateTime?
  estado           EstadoComprobante           @default(PENDIENTE)
  movimientoId     String?
  movimiento       FinanceMovement?            @relation(fields: [movimientoId], references: [id])
  origenEmail      String?
  archivoUrl       String?
  notas            String?
  pagos            FinanceComprobantePayment[]
  deletedAt        DateTime?
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt

  @@index([supplierId])
  @@index([estado])
  @@index([fechaVencimiento])
  @@map("finance_comprobantes")
}

model FinanceComprobantePayment {
  id             String             @id @default(cuid())
  comprobanteId  String
  comprobante    FinanceComprobante @relation(fields: [comprobanteId], references: [id], onDelete: Cascade)
  fecha          DateTime
  monto          Decimal            @db.Decimal(14, 2)
  moneda         Moneda             @default(USD)
  metodoPago     MetodoPago         @default(TRANSFERENCIA)
  referencia     String?
  comprobanteUrl String?
  observaciones  String?
  createdAt      DateTime           @default(now())

  @@index([comprobanteId])
  @@map("finance_comprobante_payments")
}

model FinanceApprovalHistory {
  id            String           @id @default(cuid())
  movimientoId  String
  movimiento    FinanceMovement  @relation(fields: [movimientoId], references: [id], onDelete: Cascade)
  userId        String
  user          User             @relation(fields: [userId], references: [id])
  accion        String
  comentario    String?
  estadoAntes   EstadoAprobacion
  estadoDespues EstadoAprobacion
  createdAt     DateTime         @default(now())

  @@index([movimientoId])
  @@index([userId])
  @@map("finance_approval_history")
}

model FinanceApprovalRule {
  id               String           @id @default(cuid())
  nombre           String
  activa           Boolean          @default(true)
  prioridad        Int              @default(0)
  categorias       String[]
  montoMinimo      Decimal?         @db.Decimal(14, 2)
  montoMaximo      Decimal?         @db.Decimal(14, 2)
  estadoResultante EstadoAprobacion @default(PENDIENTE_APROBACION)
  descripcion      String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@map("finance_approval_rules")
}

model InstallationSchedule {
  id              String    @id @default(cuid())
  projectId       String    @unique
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  teamId          String?
  team            Team?     @relation(fields: [teamId], references: [id], onDelete: SetNull)
  teamName        String
  teamColor       String    @default("#378ADD")
  actualWorkEnd   DateTime? @db.Date
  confirmedAt     DateTime? @db.Timestamptz(6)
  confirmedBy     String?
  confirmedByUser User?     @relation("InstallationConfirmedBy", fields: [confirmedBy], references: [id], onDelete: SetNull)
  notes           String?
  createdBy       String?
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt       DateTime? @db.Timestamptz(6)

  segments InstallationSegment[]

  @@index([projectId])
  @@index([teamId])
  @@index([deletedAt])
  @@map("installation_schedules")
}

model InstallationSegment {
  id         String               @id @default(cuid())
  scheduleId String
  schedule   InstallationSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  startDate  DateTime             @db.Date
  endDate    DateTime             @db.Date
  notes      String?
  createdAt  DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime             @updatedAt @db.Timestamptz(6)

  @@index([scheduleId])
  @@index([startDate])
  @@map("installation_segments")
}

model Team {
  id        String    @id @default(cuid())
  name      String    @unique
  color     String    @default("#378ADD")
  notes     String?
  createdBy String?
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  installations InstallationSchedule[]

  @@index([deletedAt])
  @@map("teams")
}

model StockMovement {
  id                String              @id @default(cuid())
  fecha             DateTime
  materialItemId    String
  materialItem      MaterialItem        @relation(fields: [materialItemId], references: [id])
  tipo              TipoMovimientoStock
  cantidad          Decimal             @db.Decimal(14, 3)
  costoUnitario     Decimal?            @db.Decimal(14, 2)
  costoTotal        Decimal?            @db.Decimal(14, 2)
  moneda            Moneda              @default(USD)
  stockResultante   Decimal             @db.Decimal(14, 3)
  supplierId        String?
  supplier          Supplier?           @relation(fields: [supplierId], references: [id])
  projectId         String?
  project           Project?            @relation(fields: [projectId], references: [id])
  financeMovementId String?
  financeMovement   FinanceMovement?    @relation(fields: [financeMovementId], references: [id])
  invoiceItemId     String?             @unique
  invoiceItem       InvoiceItem?        @relation(fields: [invoiceItemId], references: [id])
  causaIngreso      ExpenseSourceType?
  reversed          Boolean             @default(false)
  referencia        String?
  observaciones     String?
  createdAt         DateTime            @default(now())

  @@index([materialItemId])
  @@index([fecha])
  @@index([projectId])
  @@index([financeMovementId])
  @@index([reversed])
  @@map("stock_movements")
}

// ─── Trámites UTE ────────────────────────────────────────────────────────────

enum UteStage {
  CONSULTA
  SOLICITUD
  DOCS_1
  DOCS_2
  RELEVAR
  ENSAYOS
  FINALIZADO
}

enum UteStatus {
  CERRADO
  EN_PROCESO
  ESPERANDO
  PENDIENTE
}

model UteProcess {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  currentStage     UteStage  @default(CONSULTA)
  currentStatus    UteStatus @default(PENDIENTE)
  stageManuallySet Boolean   @default(false)

  caseNumber String?
  notes      String?
  dateColors Json?

  consultaSentAt     DateTime? @db.Date
  caseOpenedAt       DateTime? @db.Date
  consultaApprovedAt DateTime? @db.Date

  solicitudSentAt    DateTime? @db.Date
  proyectoApprovedAt DateTime? @db.Date

  docs1SentAt     DateTime? @db.Date
  docs1ApprovedAt DateTime? @db.Date

  ensayosSentAt     DateTime? @db.Date
  ensayosApprovedAt DateTime? @db.Date

  docs2SentAt DateTime? @db.Date
  finalizedAt DateTime? @db.Date

  createdById String?
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt   DateTime? @db.Timestamptz(6)

  @@index([projectId])
  @@index([currentStage])
  @@index([currentStatus])
  @@index([deletedAt])
  @@map("ute_processes")
}

// ─── Catálogo de materiales ──────────────────────────────────────────────────

model MaterialCategory {
  id          String  @id @default(cuid())
  nombre      String  @unique
  descripcion String?
  orden       Int     @default(0)
  activa      Boolean @default(true)

  items MaterialItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([activa])
  @@index([orden])
  @@map("material_categories")
}

model MaterialItem {
  id         String           @id @default(cuid())
  categoryId String
  category   MaterialCategory @relation(fields: [categoryId], references: [id])

  nombre      String
  descripcion String?
  unidad      String  @default("un")

  precioSugerido Decimal? @db.Decimal(12, 2)
  moneda         Moneda   @default(USD)

  defaultSupplierId String?
  defaultSupplier   Supplier? @relation(fields: [defaultSupplierId], references: [id])

  activo Boolean @default(true)

  // Campos de stock (unificación con StockProduct)
  // gestionaStock = false → es un servicio / mano de obra, no tiene representación
  // física y no entra al inventario.
  gestionaStock     Boolean  @default(true)
  stockActual       Decimal  @default(0) @db.Decimal(10, 2)
  stockMinimo       Decimal? @db.Decimal(10, 2)
  ubicacionDeposito String?

  projectMaterials ProjectMaterial[]
  movimientos      FinanceMovement[]
  stockMovements   StockMovement[]
  invoiceItems     InvoiceItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([activo])
  @@index([gestionaStock])
  @@map("material_items")
}

model ProjectMaterial {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  materialItemId String
  materialItem   MaterialItem @relation(fields: [materialItemId], references: [id])

  quantity  Decimal @db.Decimal(10, 2)
  unitPrice Decimal @db.Decimal(12, 2)
  moneda    Moneda  @default(USD)

  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id])

  notes String?

  movementId String?          @unique
  movement   FinanceMovement? @relation(fields: [movementId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([materialItemId])
  @@map("project_materials")
}

// ─── Desglose de factura (InvoiceItem) ──────────────────────────────────────
// Cada factura A_PAGAR/PAGADO puede llevar el detalle de los ítems comprados.
// Al confirmar el desglose, cada InvoiceItem genera un StockMovement de
// ENTRADA. Si el movimiento luego se anula, se revierte el StockMovement.

model InvoiceItem {
  id         String          @id @default(cuid())
  movementId String
  movement   FinanceMovement @relation(fields: [movementId], references: [id], onDelete: Cascade)

  materialItemId String
  materialItem   MaterialItem @relation(fields: [materialItemId], references: [id])

  quantity  Decimal @db.Decimal(10, 2)
  unitPrice Decimal @db.Decimal(12, 2)
  moneda    Moneda  @default(USD)
  notes     String?

  // 1:1 con el StockMovement de ENTRADA generado al confirmar
  stockMovement StockMovement?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([movementId])
  @@index([materialItemId])
  @@map("invoice_items")
}

// ─── Payments + PaymentApplications ──────────────────────────────────────────
//
// Pago real hecho a un proveedor (transferencia, cheque, efectivo). Un pago
// puede aplicarse a una o varias facturas (FinanceMovement) vía
// PaymentApplication. El total aplicado puede ser menor al monto del pago
// (saldo a favor del proveedor) y un pago puede dejarse sin aplicar para
// asignarlo después.

model Payment {
  id         String   @id @default(cuid())
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  fecha  DateTime @db.Date
  monto  Decimal  @db.Decimal(14, 2)
  moneda Moneda   @default(USD)

  metodo     MetodoPago @default(TRANSFERENCIA)
  referencia String?
  notas      String?

  applications PaymentApplication[]

  createdById String?
  createdBy   User?   @relation("PaymentCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([supplierId])
  @@index([fecha])
  @@index([deletedAt])
  @@map("payments")
}

model PaymentApplication {
  id        String  @id @default(cuid())
  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  movementId String
  movement   FinanceMovement @relation(fields: [movementId], references: [id])

  montoAplicado Decimal @db.Decimal(14, 2)

  createdAt DateTime @default(now())

  @@unique([paymentId, movementId])
  @@index([movementId])
  @@map("payment_applications")
}
