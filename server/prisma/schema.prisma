  // Desglose de factura → impacta stock cuando pasa a A_PAGAR
  requiresItemDetail   Boolean                  @default(false)
  hasItemDetail        Boolean                  @default(false)
  noTieneMateriales    Boolean                  @default(false)
  depositoIngresoId    String?
  invoiceItems         InvoiceItem[]
  projectId            String?
  project              Project?                 @relation(fields: [projectId], references: [id])
  supplierId           String?
  supplier             Supplier?                @relation(fields: [supplierId], references: [id])
  accountId            String?
  account              Account?                 @relation(fields: [accountId], references: [id])
  observaciones        String?
  estadoAprobacion     EstadoAprobacion         @default(REGISTRADO)
  archivoAdjuntoUrl    String?
  paymentApplications  PaymentApplication[]
  comprobantes         FinanceComprobante[]
  movimientosStock     StockMovement[]
  historial            FinanceApprovalHistory[]
  projectMaterials     ProjectMaterial[]
  reconciliacionAjuste AccountReconciliation?   @relation("ReconciliationAjuste")
  commission           Commission?
  // Pago (total o parcial) de mano de obra a un instalador tercerizado. A
  // diferencia de la comisión —que es 1:1 con su movimiento— acá un mismo pago
  // puede tener varios movimientos: uno por cada entrega.
  installerPaymentId   String?
  installerPayment     InstallerPayment?        @relation("FinanceMovementInstallerPayment", fields: [installerPaymentId], references: [id], onDelete: SetNull)
  // Para transferencias entre cuentas: par de movimientos (GASTO origen +
  // INGRESO destino) con el mismo transferGroupId. Permite eliminarlos juntos
  // y mostrarlos como una sola operación en la UI.
  transferGroupId      String?
  fixedCostId          String?
  fixedCost            FixedCost?               @relation(fields: [fixedCostId], references: [id])
  creadoPorId          String?
  creadoPor            User?                    @relation("FinanceMovCreadoPor", fields: [creadoPorId], references: [id])
  aprobadoPorId        String?
  aprobadoPor          User?                    @relation("FinanceMovAprobadoPor", fields: [aprobadoPorId], references: [id])
  deletedAt            DateTime?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  @@index([fecha])
  @@index([mes, anio])
  @@index([projectId])
  @@index([categoriaPrincipal])
  @@index([estadoAprobacion])
  @@index([tipoMovimiento])
  @@index([status])
  @@index([sourceType])
  @@index([dueDate])
  @@index([fixedCostId])
  @@index([transferGroupId])
  @@map("finance_movements")
}

// Costos fijos predefinidos (alquiler, contador, seguros, sueldos, etc).
// Usados como sugerencia en el formulario de movimiento (categoría FIJO):
// el operador ve los que faltan pagar este mes y al elegir uno se autocompleta
// el nombre. El monto siempre lo carga el usuario.
model FixedCost {
  id              String               @id @default(cuid())
  nombre          String
  descripcion     String?
  periodicidad    FixedCostPeriodicity
  diaDelMes       Int
  // Solo cuando periodicidad = BIMENSUAL: true=meses pares (feb/abr/...),
  // false=meses impares (ene/mar/...).
  mesesPares      Boolean?
  // Solo cuando periodicidad = ANUAL: 1-12, mes del año en que cae.
  mesAnual        Int?
  montoReferencia Decimal              @db.Decimal(12, 2)
  moneda          Moneda               @default(UYU)
  movements       FinanceMovement[]
  skips           FixedCostSkip[]
  activo          Boolean              @default(true)
  createdAt       DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime             @updatedAt @db.Timestamptz(6)
  deletedAt       DateTime?

  @@index([activo])
  @@index([deletedAt])
  @@map("fixed_costs")
}

// Skip de un mes específico de un costo fijo. Sirve para "borrar" el pendiente
// del mes sin desactivar el costo fijo entero (que afectaría los próximos meses).
model FixedCostSkip {
  id          String    @id @default(cuid())
  fixedCostId String
  fixedCost   FixedCost @relation(fields: [fixedCostId], references: [id], onDelete: Cascade)
  mes         Int
  anio        Int
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)

  @@unique([fixedCostId, mes, anio])
  @@map("fixed_cost_skips")
}

enum FixedCostPeriodicity {
  MENSUAL
  BIMENSUAL
  ANUAL
}

/// @deprecated A partir de v5.4: las facturas a pagar a proveedor se modelan
/// como FinanceMovement (GASTO + PAGO_PROVEEDOR + status A_PAGAR + supplierId
/// + dueDate). Los datos viejos siguen en esta tabla por compatibilidad; no
/// crear nuevos registros desde código nuevo. El POST /finance/comprobantes
