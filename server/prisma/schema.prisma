enum StageType {
  ONBOARDING
  INGENIERIA
  OPERACIONES
  HABILITACION_UTE
  POSTVENTA
  // Pipeline expandido a 8 etapas (módulo Traspasos v1). Los 4 valores viejos
  // (INGENIERIA, OPERACIONES, HABILITACION_UTE, POSTVENTA) quedan temporalmente
  // para no romper filas Stage existentes; se eliminan después de la migración
  // de datos que divide/renombra los bloques (Fase 5 del plan Traspasos).
  // REVISION_CAPATAZ quedó reemplazado por VALIDACION_OPERACIONES (spec v3, C6);
  // se mantiene temporalmente (sin uso) y se elimina también en la Fase 5.
  PRE_INGENIERIA
  REVISION_CAPATAZ
  VALIDACION_OPERACIONES
  INGENIERIA_FINAL
  COMPRAS
  EJECUCION_OBRA
  TRAMITACION_UTE
  POST_HABILITACION
  // Etapas PARALELAS de Experiencia Solar (no participan del orden lineal ni del
  // progreso/cierre del proyecto). Ver isParallelStage / PARALLEL_STAGE_TYPES.
  SEGUIMIENTO_PREOBRA
  SEGUIMIENTO_HABILITACION
}

