model SalesLead {
  id                   String               @id @default(cuid())
  code                 String               @unique
  tenantId             String?
  clientName           String
  clientEmail          String?
  clientPhone          String?
  address              String?
  stage                SalesStage           @default(NUEVO_LEAD)
  // Residencial o empresa. Clasifica al cliente potencial y precarga el
  // cotizador correspondiente; NO restringe: desde cualquier lead se puede
  // abrir cualquiera de los dos cotizadores.
  tipoCliente          ProposalVariante     @default(RESIDENCIAL)
  estimatedKwp         Decimal?             @db.Decimal(10, 2)
  estimatedBudgetUsd   Decimal?             @db.Decimal(14, 2)
  uteBillMonthlyUsd    Decimal?             @db.Decimal(10, 2)
  roofType             String?
  notes                String?
  lostReason           String?
  // Contador de reclamos (insistencias) hechos al lead. Es transversal a la
  // etapa: un lead en cualquier stage puede acumular reclamos. Se muestra como
  // "xR" en la tarjeta y se incrementa con el botón "+" desde el kanban.
  reclamosCount        Int                  @default(0)
  lastReclamoAt        DateTime?            @db.Timestamptz(6)
  // Fecha de "alta comercial" del lead. Por default copia createdAt en
  // los registros nuevos (auto-fill en el handler de POST), pero es
  // editable desde el panel "Fechas del proceso" para corregir backfills
  // manuales o fechas históricas.
  leadCreatedAt        DateTime?            @db.Timestamptz(6)
  proposalSentAt       DateTime?            @db.Timestamptz(6)
  visitScheduledAt     DateTime?            @db.Timestamptz(6)
  visitCompletedAt     DateTime?            @db.Timestamptz(6)
  closedAt             DateTime?            @db.Timestamptz(6)
  assignedToId         String?
  assignedTo           User?                @relation("LeadAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  convertedToProjectId String?
  convertedToProject   Project?             @relation("LeadConvertedTo", fields: [convertedToProjectId], references: [id], onDelete: SetNull)
  convertedAt          DateTime?            @db.Timestamptz(6)
  createdById          String
  createdBy            User                 @relation("LeadCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  activities           SalesActivity[]
  proposals            ProposalGeneration[] @relation("ProposalLead")
  proposalV2Drafts     ProposalV2Draft[]
  proposalV2Versions   ProposalV2Version[]
  commission           Commission?
  comments             Comment[]
  tasks                Task[]
  attachments          FileAttachment[]     @relation("LeadAttachments")
  videos               ProjectVideo[]       @relation("SalesLeadVideos")
  deletedAt            DateTime?            @db.Timestamptz(6)
  createdAt            DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime             @updatedAt @db.Timestamptz(6)

  @@index([stage])
  @@index([tenantId])
  @@index([assignedToId])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("sales_leads")
}

model SalesActivity {
  id        String      @id @default(cuid())
  leadId    String
  lead      SalesLead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  fromStage SalesStage?
  toStage   SalesStage?
  action    String
  notes     String?
  createdAt DateTime    @default(now()) @db.Timestamptz(6)

  @@index([leadId])
  @@index([createdAt])
  @@map("sales_activities")
}

model Goal {
  id          String     @id @default(cuid())
  area        GoalArea
  metric      GoalMetric
  period      GoalPeriod
  year        Int
  quarter     Int?
  targetValue Decimal    @db.Decimal(14, 2)
  createdById String
  createdBy   User       @relation("GoalCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime   @updatedAt @db.Timestamptz(6)

  @@unique([area, metric, period, year, quarter])
  @@index([area])
  @@index([year])
  @@map("goals")
}

model ProposalGeneration {
  id             String          @id @default(cuid())
  leadId         String?
  lead           SalesLead?      @relation("ProposalLead", fields: [leadId], references: [id], onDelete: SetNull)
  projectId      String?
  project        Project?        @relation("ProposalProject", fields: [projectId], references: [id], onDelete: SetNull)
  // Versión incremental por lead (1, 2, 3...). En proyectos sin lead asociado
  // se mantiene 1 — el caso "propuesta para proyecto" no se usa hoy.
  version        Int             @default(1)
  inputFilePath  String?
  outputFilePath String?
  status         ProposalStatus  @default(PENDING)
  errorMessage   String?
  // Al completarse, se crea un FileAttachment en el lead para que la propuesta
  // aparezca en la sección "Adjuntos". La descarga sigue funcionando vía el
  // endpoint /api/proposals/:id/download.
  attachmentId   String?
  attachment     FileAttachment? @relation("ProposalAttachment", fields: [attachmentId], references: [id], onDelete: SetNull)
  generatedById  String
  generatedBy    User            @relation("ProposalGeneratedBy", fields: [generatedById], references: [id], onDelete: Restrict)
  completedAt    DateTime?       @db.Timestamptz(6)
  // Soft-delete (descartar/restaurar) — paridad con ProposalV2Version.
  discardedAt    DateTime?       @db.Timestamptz(6)
  createdAt      DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @db.Timestamptz(6)

  @@index([leadId])
  @@index([projectId])
  @@index([status])
  @@map("proposal_generations")
}

