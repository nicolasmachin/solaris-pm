  moneda           Moneda                      @default(USD)
  fechaEmision     DateTime
  fechaVencimiento DateTime?
  estado           EstadoComprobante           @default(PENDIENTE)
  movimientoId     String?
  movimiento       FinanceMovement?            @relation(fields: [movimientoId], references: [id])
  origenEmail      String?
  archivoUrl       String?
  notas            String?
  pagos            FinanceComprobantePayment[]
  deletedAt        DateTime?
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt

