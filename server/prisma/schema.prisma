  concepto         String
  monto            Decimal                     @db.Decimal(14, 2)
  moneda           Moneda                      @default(USD)
  fechaEmision     DateTime
  fechaVencimiento DateTime?
  estado           EstadoComprobante           @default(PENDIENTE)
  movimientoId     String?
