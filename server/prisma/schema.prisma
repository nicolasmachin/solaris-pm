enum CommissionStatus {
  PENDIENTE
  PAGADA
}

// Comisión del asesor por una venta cerrada (lead CERRADO_GANADO). El monto se
// congela del snapshot de la propuesta ganadora (snapshot.calc.comisionVentasUsdSinIva)
// y se refleja como un FinanceMovement PREVISTO en Finanzas. El estado
// (PENDIENTE/PAGADA) es espejo del status del movimiento (fuente de verdad = Finanzas).
model Commission {
  id String @id @default(cuid())

  // Asesor beneficiario (SalesLead.assignedTo al cerrar).
  asesorId String
  asesor   User   @relation("CommissionAsesor", fields: [asesorId], references: [id], onDelete: Restrict)

  // Lead ganado: una comisión por lead. Nullable: las comisiones manuales
  // cargadas por un admin no están atadas a un lead (leadId null → se etiquetan
  // con `concepto`). El @unique nullable permite varios NULL en Postgres.
  leadId String?    @unique
  lead   SalesLead? @relation(fields: [leadId], references: [id], onDelete: SetNull)

  // Etiqueta libre para comisiones manuales sin lead (ej. "Bono Q2", "Venta externa").
  concepto String?

  // Propuesta ganadora. Nullable: si el cliente aceptó una propuesta vieja
  // (ProposalGeneration, sin snapshot) el monto se carga manual y acá queda null,
  // con la traza en proposalGenerationId.
  proposalVersionId    String?
  proposalVersion      ProposalV2Version? @relation(fields: [proposalVersionId], references: [id], onDelete: SetNull)
  proposalGenerationId String?

  // Monto congelado (snapshot.calc.comisionVentasUsdSinIva) o carga manual admin.
  montoUsd     Decimal  @db.Decimal(14, 2)
  // % aplicado (defaults.comisionVendedorPorcentaje). Null si monto manual.
  porcentaje   Decimal? @db.Decimal(6, 4)
  // True si el monto se cargó a mano (propuesta vieja sin snapshot).
  origenManual Boolean  @default(false)

  // Fecha de venta = SalesLead.closedAt. dueDate = día 1 del mes siguiente.
  fechaVenta DateTime @db.Timestamptz(6)
  dueDate    DateTime @db.Date

  // Estado espejo del FinanceMovement linkeado.
  status CommissionStatus @default(PENDIENTE)
  paidAt DateTime?        @db.Timestamptz(6)

  // Pendiente/pago en Finanzas.
  financeMovementId String?          @unique
  financeMovement   FinanceMovement? @relation(fields: [financeMovementId], references: [id], onDelete: SetNull)

  createdById String
  createdBy   User   @relation("CommissionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  // Edición admin de una comisión ya congelada (fechas / monto). Deja registro
  // visible de que fue modificada; el detalle fino va al audit log.
  editadoAt     DateTime? @db.Timestamptz(6)
  notaEdicion   String?
  // True si el admin fijó la fecha de pago prevista a mano: al cambiar la fecha
  // de venta ya no se recalcula sola al 1° del mes siguiente.
  dueDateManual Boolean   @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([asesorId])
  @@index([status])
  @@index([fechaVenta])
  @@map("commissions")
}

enum InstallerPaymentStatus {
  PENDIENTE
  PARCIAL
  PAGADO
}

// Pago de mano de obra a un instalador tercerizado por una obra.
//
// Espejo de `Commission` del lado del gasto, con dos diferencias pedidas por
// negocio: admite pagos PARCIALES (como los cobros al cliente: total, pagado y
// saldo) y el instalador se asigna A MANO. Lo segundo no es una simplificación:
// `Team` (los equipos del calendario, con type TERCERIZADO) no tiene relación con
// `User`, así que no hay forma de deducir qué persona hizo la obra.
//
// El monto se congela de la propuesta ganadora — `calc.manoDeObraUsdSinIva` MÁS
// IVA, porque el instalador factura — y queda editable: lo que el cotizador
// estima no siempre es lo que se negocia.
model InstallerPayment {
  id String @id @default(cuid())

  // Un pago por proyecto. Nullable + sin @unique no alcanzaría: la carga manual
  // de un admin puede no tener proyecto, y el @unique nullable de Postgres
  // permite varios NULL.
  projectId String?  @unique
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  // Etiqueta libre para pagos manuales sin proyecto (ej. "Reparación garantía").
  concepto String?

  // Null hasta que un admin lo asigna: es el estado normal apenas se crea, al
  // ganarse el proyecto. Mientras esté null nadie lo ve en "mis pagos".
  installerId String?
  installer   User?   @relation("InstallerPaymentInstaller", fields: [installerId], references: [id], onDelete: SetNull)

  // Mano de obra CON IVA. El instalador emite factura, así que lo que se le paga
  // es el costo más IVA, no el neto que muestra el desglose del cotizador.
  montoUsd Decimal @db.Decimal(14, 2)

  // Propuesta de la que salió el monto. Null si se cargó a mano o si el proyecto
  // no tenía propuesta nueva con snapshot.
  proposalVersionId String?
  proposalVersion   ProposalV2Version? @relation(fields: [proposalVersionId], references: [id], onDelete: SetNull)

  // true = no hubo snapshot del cual congelar (nace en 0 y hay que cargarlo).
  origenManual Boolean @default(false)
  // true = un admin corrigió el monto congelado. Sirve para no pisarlo si algún
  // día se recalcula, y para saber que el número no es el del cotizador.
  montoEditado Boolean @default(false)

  fechaTrabajo DateTime @db.Timestamptz(6)
  dueDate      DateTime @db.Date

  // DERIVADO de los movimientos pagados, nunca se setea a mano.
  // Ver recalcularStatus() en installer-payment.service.ts.
  status InstallerPaymentStatus @default(PENDIENTE)
  paidAt DateTime?              @db.Timestamptz(6)

  notas String?

  // Un FinanceMovement por pago parcial: así entra solo al flujo de fondos, a las
  // cuentas y a la conciliación, sin duplicar esa maquinaria.
  movimientos FinanceMovement[] @relation("FinanceMovementInstallerPayment")

  createdById String
  createdBy   User   @relation("InstallerPaymentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  @@index([installerId])
  @@index([status])
  @@index([fechaTrabajo])
  @@index([deletedAt])
  @@map("installer_payments")
}

model ProposalDefaults {
  id String @id @default("singleton")

  data Json // Cada variable como {value, asesorCanOverride}

  // PDF de tapa (Canva) — campos preparados para Fase D
  coverPdfAttachmentId String?
  coverPdfAttachment   FileAttachment? @relation("ProposalV2Cover", fields: [coverPdfAttachmentId], references: [id])

  // Coordenadas overlay para texto sobre la tapa
  coverOverlay Json

  // Tapa propia de las propuestas a empresas. Van como columnas y no dentro del
  // JSON `data` porque ahí cada clave es un {value, asesorCanOverride} y un
  // attachmentId no encaja en ese contrato. Si están vacías, el cotizador B2B
  // usa la tapa residencial (fallback), así funciona antes de que se cargue.
  coverEmpresaPdfAttachmentId String?
  coverEmpresaPdfAttachment   FileAttachment? @relation("ProposalV2CoverEmpresa", fields: [coverEmpresaPdfAttachmentId], references: [id])
  coverEmpresaOverlay         Json?

  updatedAt   DateTime @updatedAt @db.Timestamptz(6)
  updatedById String?
  updatedBy   User?    @relation("ProposalDefaultsUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("proposal_defaults")
}

// ─── Reportes fotovoltaicos mensuales ────────────────────────────────────────
// Reemplaza el sistema Python standalone (Reporte_Fotovoltaico) que producía los
// reportes mensuales de generación a partir de 4 planillas Excel.
//
// Las capas están deliberadamente separadas — la planilla original mezclaba dato
// crudo con resultado calculado y por eso no se podía recalcular nada:
//
//   Maestros  ReporteFvConfig / ReporteFvDestinatario   humano, no regenerable
//   Tarifas   TarifaUteVersion + hijas                  humano, versionado
//   Crudo     ReporteFvLectura                          Growatt o humano
//   Calculado ReporteFvCalculo + ...Tarifa              motor, SIEMPRE regenerable
//   Emitido   ReporteFvEmision                          congelado + snapshot
//   Enviado   ReporteFvEnvio                            historial de intentos
//
// Regla de oro: todo lo calculado es derivable de (lecturas + config + tarifa
// vigente + tipo de cambio). Todo lo emitido es inmutable y lleva su snapshot,
// para que un reporte de 2025 se regenere idéntico aunque cambien las tarifas.

enum TarifaUte {
  SIMPLE
  DOBLE
  TRIPLE
  ZAFRAL
}

enum FranjaHoraria {
  PUNTA
  LLANO
  VALLE
  FUERA_PUNTA // solo tarifa doble
}

enum ReporteFvTipoCliente {
  RESIDENCIAL
  EMPRESA
}

// Origen de cada valor de una lectura. Se guarda POR CAMPO, no por fila: es lo
// que permite que un consumo cargado a mano (porque el smart meter falló) no lo
// pise la próxima ingesta de Growatt.
enum ReporteFvFuente {
  GROWATT
  HUAWEI
  MANUAL
  IMPORT_LEGACY
}

// De dónde salen las lecturas de este cliente. No todos los generadores tienen
// Growatt: los de otras marcas (sin API disponible todavía) se cargan a mano
// todos los meses. La ingesta los saltea y el panel los agrupa aparte, así
// "falta el dato" no se confunde con "falló la ingesta".
enum ReporteFvOrigenDatos {
  GROWATT
  HUAWEI
  MANUAL
}

enum ReporteFvIngestaModo {
  CRON
  MANUAL
  BACKFILL
}

enum ReporteFvIngestaEstado {
  EN_CURSO
  OK
  PARCIAL
  ERROR
  CANCELADA
}

enum ReporteFvEmisionEstado {
  BORRADOR
  LISTO
  ENVIADO
  ANULADO
}

enum ReporteFvEnvioEstado {
  ENVIADO
  FALLIDO
  DRY_RUN
  OMITIDO
}

// ─── Tarifas UTE (versionadas por vigencia) ──────────────────────────────────
// UTE ajusta el pliego periódicamente. Cada cuadro tarifario es una versión con
// fecha de vigencia; ReporteFvCalculo congela cuál usó, así un reporte viejo se
// reproduce con el precio que regía ese mes.

model TarifaUteVersion {
  id           String    @id @default(cuid())
  nombre       String // "UTE 2026-01", "Legacy Excel"
  vigenteDesde DateTime  @db.Date // inclusive
  vigenteHasta DateTime? @db.Date // null = vigente hoy; se cierra al publicar la siguiente

  ivaPct  Decimal @default(0.2200) @db.Decimal(6, 4)
  irpfPct Decimal @default(0.1200) @db.Decimal(6, 4)

  // Borrador editable vs congelada. Solo las publicadas resuelven vigencia.
  publicada Boolean @default(false)
  notas     String?

  creadaPorId String
  creadaPor   User   @relation("TarifaUteVersionCreadaPor", fields: [creadaPorId], references: [id], onDelete: Restrict)

  cargos   TarifaUteCargo[]
  tramos   TarifaUteTramo[]
  franjas  TarifaUteFranja[]
  calculos ReporteFvCalculo[]

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@unique([vigenteDesde])
  @@index([publicada, vigenteDesde])
  @@map("tarifa_ute_versiones")
}

// Cargo fijo y cargo por potencia contratada, por tarifa (hoja `parametros`).
model TarifaUteCargo {
  id        String           @id @default(cuid())
  versionId String
  version   TarifaUteVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  tarifa          TarifaUte
  cargoFijo       Decimal   @db.Decimal(12, 4)
  cargoPotenciaKw Decimal   @db.Decimal(12, 4)

  @@unique([versionId, tarifa])
  @@map("tarifa_ute_cargos")
}

// Tramos escalonados de consumo (hoja `precios_simple`). Genérico por tarifa por
// si alguna otra pasa a escalonar.
model TarifaUteTramo {
  id        String           @id @default(cuid())
  versionId String
  version   TarifaUteVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  tarifa    TarifaUte
  orden     Int
  desdeKwh  Int
  hastaKwh  Int // 9999999 = sin tope (igual que la planilla original)
  precioKwh Decimal   @db.Decimal(12, 4)

  @@unique([versionId, tarifa, orden])
  @@map("tarifa_ute_tramos")
}

// Precio por franja horaria (hojas `precios_doble`, `precios_triple`, `zafral`).
model TarifaUteFranja {
  id        String           @id @default(cuid())
  versionId String
  version   TarifaUteVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  tarifa    TarifaUte
  franja    FranjaHoraria
  precioKwh Decimal       @db.Decimal(12, 4)

  @@unique([versionId, tarifa, franja])
  @@map("tarifa_ute_franjas")
}

// ─── Config del reporte por proyecto ─────────────────────────────────────────
// Los campos que YA viven en Project son nullable a propósito: null significa
// "usar el del proyecto". Solo se persiste el valor si alguien lo pisa a mano.
// Así el dato tiene una sola fuente de verdad y no se desincroniza — que es
// justamente lo que pasaba con la hoja `constantes` del Excel.
//
//   potenciaInstaladaKwp  null → Project.capacityKwp
//   inversionUsd          null → Project.budgetUsd
//   mesInicio             null → Project.postHabilitacionInicioEn ?? actualUteEnd
//   destinatarios vacío        → Project.clientEmail
//
// Lo que NO existe en Project y por eso es obligatorio acá: la potencia
// contratada a UTE, el reparto de consumo por franja horaria y la tarifa.

model ReporteFvConfig {
  id        String  @id @default(cuid())
  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Equivale a la columna `reporte` (1/0) de la planilla.
  habilitado       Boolean              @default(true)
  tipoCliente      ReporteFvTipoCliente @default(RESIDENCIAL)
  // Obligatoria si tipoCliente = EMPRESA. Los residenciales ven las 3 tarifas
  // comparadas y el ROI se calcula con la simple.
  tarifaContratada TarifaUte?

  potenciaContratadaKw Decimal @db.Decimal(8, 2)

  // Reparto horario del consumo. Se guarda SIEMPRE normalizado 0..1 y debe sumar
  // 1.0 ± 0.001. Es una estimación: el reporte lo aclara al cliente.
  pctPunta Decimal @db.Decimal(6, 4)
  pctLlano Decimal @db.Decimal(6, 4)
  pctValle Decimal @db.Decimal(6, 4)

  // Overrides de datos del proyecto. Ver comentario del bloque.
  inversionUsd         Decimal?  @db.Decimal(12, 2)
  potenciaInstaladaKwp Decimal?  @db.Decimal(8, 2)
  mesInicio            DateTime? @db.Date // día 1 del mes; ancla del ROI

  // GROWATT = la ingesta trae las lecturas sola. MANUAL = generador de otra marca
  // sin API; alguien carga generación/consumo/exportación todos los meses desde
  // el panel. La marca del inversor vive en SolarSystem.inverterBrand.
  origenDatos ReporteFvOrigenDatos @default(GROWATT)

  // Denormalizado desde GrowattPlant para no joinear en cada consulta del panel.
  // La vinculación real (y la unicidad) vive en GrowattPlant.projectId.
  growattPlantId BigInt?

  envioAutomatico Boolean @default(false)
  notasFijas      String?

  // Día de corte del medidor de UTE (1-31, aproximado). null = el reporte cubre
  // el mes calendario (default). Si está seteado, el ciclo va del día siguiente
  // al corte del mes anterior hasta el corte del mes en curso, así los kWh del
  // reporte coinciden con el período que factura UTE. Lo puede cargar el cliente
  // desde el portal o el equipo desde el panel. UTE corre la lectura por fines de
  // semana/feriados, por eso es aproximado.
  diaCorteMedidor Int?

  destinatarios ReporteFvDestinatario[]

  actualizadoPorId String?
  actualizadoPor   User?   @relation("ReporteFvConfigActualizadaPor", fields: [actualizadoPorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([habilitado])
  @@map("reporte_fv_configs")
}

model ReporteFvDestinatario {
  id       String          @id @default(cuid())
  configId String
  config   ReporteFvConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  email   String
  nombre  String?
  esCopia Boolean @default(false) // false = To, true = Cc
  activo  Boolean @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@unique([configId, email])
  @@map("reporte_fv_destinatarios")
}

// ─── Catálogo de plantas Growatt ─────────────────────────────────────────────
// El plantId es la ENTIDAD CANÓNICA del sistema de reportes. La planilla unía
// sus 4 fuentes por nombre de persona y eso ya había roto ~17 vínculos.
// El matching por nombre queda solo como sugerencia en la UI, nunca en runtime.
//
// La "allowlist" del script pasa a ser: projectId != null AND ignorada = false.

/// Planta de FusionSolar (Huawei). Tabla aparte de GrowattPlant y no un campo
/// `proveedor` en aquélla: el identificador de Huawei es un string ("NE=36611488")
/// contra el BigInt de Growatt, y dispositivos/incidencias/monitoreo ya cuelgan
/// de ese BigInt. Unificarlas sería un refactor grande de algo que funciona para
/// ganar poco: los dos catálogos se cruzan por projectId, que es lo que importa.
model HuaweiPlant {
  id        String @id @default(cuid())
  plantCode String @unique // "NE=36611488"
  name      String

  capacityKwp        Decimal?  @db.Decimal(10, 2)
  gridConnectionDate DateTime? @db.Date
  address            String?

  /// `real_health_state` de getStationRealKpi: 1 = DESCONECTADA (el inversor no
  /// llega a internet; NO significa que esté rota — caso verificado: Rodolfo Sosa
  /// funciona pero no tiene wifi), 2 = con falla, 3 = sana. A diferencia de
  /// Growatt, acá el estado lo dice la API y no hay que inferirlo de "comunica
  /// pero no genera".
  healthState    Int?
  ultimoEstadoEn DateTime? @db.Timestamptz(6)

  /// null = planta vista en la API pero todavía sin vincular a un proyecto.
  projectId String?  @unique
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  ignorada  Boolean  @default(false)

  vinculadaPorId String?
  vinculadaPor   User?     @relation("HuaweiPlantVinculadaPor", fields: [vinculadaPorId], references: [id], onDelete: SetNull)
  vinculadaEn    DateTime? @db.Timestamptz(6)

  /// Silenciar el monitoreo diario. Fecha y no booleano, misma razón que en
  /// GrowattPlant: un silencio permanente se olvida y mata el monitoreo.
  monitoreoSilenciadoHasta  DateTime? @db.Date
  monitoreoSilenciadoMotivo String?
  monitoreoSilenciadoPorId  String?
  monitoreoSilenciadoPor    User?     @relation("HuaweiPlantMonitoreoSilenciadaPor", fields: [monitoreoSilenciadoPorId], references: [id], onDelete: SetNull)

  primeraVezEn DateTime @default(now()) @db.Timestamptz(6)
  ultimaVezEn  DateTime @default(now()) @db.Timestamptz(6)

  incidencias FvIncidencia[]

  @@index([projectId])
  @@index([ignorada])
  @@map("huawei_plants")
}

model GrowattPlant {
  id      String @id @default(cuid())
  plantId BigInt @unique
  name    String

  status      String?
  peakPowerKw Decimal? @db.Decimal(10, 2)
  city        String?
  country     String?

  // Cuenta de Growatt dueña de la planta (`user_id` de plant/details).
  //
  // El token de la Open API no está acotado a una sola cuenta: alcanza a todas
  // las que cuelgan de la misma jerarquía. Medido sobre el catálogo real, 87 de
  // las 152 plantas visibles pertenecen a OTRA empresa instaladora. Guardar el
  // dueño es lo que permite quedarse sólo con las propias (GROWATT_USER_ID) sin
  // depender de que Growatt cambie el alcance del token.
  //
  // Nullable porque las plantas migradas de la planilla vieja no lo traían: se
  // completa de a poco, cuando la sincronización pasa por cada una.
  ownerUserId Int?

  // null = planta detectada en la API pero todavía sin vincular a un proyecto.
  projectId String?  @unique
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  // Planta que no corresponde a un cliente (demo, instalación propia, etc.).
  ignorada  Boolean  @default(false)

  vinculadaPorId String?
  vinculadaPor   User?     @relation("GrowattPlantVinculadaPor", fields: [vinculadaPorId], references: [id], onDelete: SetNull)
  vinculadaEn    DateTime? @db.Timestamptz(6)

  // Silenciar el monitoreo diario (mantenimiento programado, caso ya
  // gestionado, cliente que se va). Fecha y no booleano a propósito: un
  // silencio permanente se olvida y mata el monitoreo sin que nadie se entere.
  // Para "no mirarla nunca más" ya está `ignorada`.
  monitoreoSilenciadoHasta  DateTime? @db.Date
  monitoreoSilenciadoMotivo String?
  monitoreoSilenciadoPorId  String?
  monitoreoSilenciadoPor    User?     @relation("GrowattPlantMonitoreoSilenciadaPor", fields: [monitoreoSilenciadoPorId], references: [id], onDelete: SetNull)

  primeraVezEn DateTime @default(now()) @db.Timestamptz(6)
  ultimaVezEn  DateTime @default(now()) @db.Timestamptz(6)

  devices     GrowattDevice[]
  incidencias FvIncidencia[]

  @@index([projectId])
  @@index([ignorada])
  @@index([ownerUserId])
  @@map("growatt_plants")
}

// ─── Dispositivos de la planta ───────────────────────────────────────────────
// `device/list` ya se llamaba en cada ingesta y se tiraba todo salvo el
// datalogger_sn del type 3. Persistir el resto no cuesta un request extra y es
// lo que permite distinguir "el equipo no comunica" de "comunica pero no
// genera" — que para el cliente son dos problemas completamente distintos.

model GrowattDevice {
  id String @id @default(cuid())

  // FK contra `plantId` (que es @unique) y no contra `id`: el plantId es la
  // entidad canónica del módulo y se evita un join en cada consulta del monitor.
  growattPlantId BigInt
  plant          GrowattPlant @relation(fields: [growattPlantId], references: [plantId], onDelete: Cascade)

  deviceSn     String
  dataloggerSn String?
  // Crudo de la API: 1=inverter, 3=other (el medidor), 4=max, 5=sph, 7=min/TLX.
  // Int y no enum: Growatt agrega tipos y un enum se rompería con hardware nuevo.
  tipo         Int
  model        String?

  // Último snapshot de device/list. OJO con `lost`: el datalogger se alimenta
  // del inversor y sólo transmite con sol (~08:00–18:30), así que de noche
  // "perdido" es lo normal. Por eso el monitoreo mide horas desde `ultimoDatoEn`
  // en vez de creerle al booleano.
  lost         Boolean?
  statusRaw    Int?
  ultimoDatoEn DateTime? @db.Timestamptz(6)

  // Dirección del medidor colgado de este datalogger (device/ammeter/meter_list).
  // Se cachea porque redescubrirla cuesta un request por planta por día, y no
  // cambia salvo que se toque el hardware.
  meterAddress String?

  // De device/tlx/tlx_last_data (POST), sólo para inversores sospechosos.
  // statusText/errorText/warnText vienen en inglés desde Growatt.
  faultCode  Int?
  warnCode   Int?
  faultTexto String?
  statusText String?

  primeraVezEn    DateTime  @default(now()) @db.Timestamptz(6)
  ultimaVezEn     DateTime  @default(now()) @db.Timestamptz(6)
  ultimoChequeoEn DateTime? @db.Timestamptz(6)

  @@unique([growattPlantId, deviceSn])
  @@index([growattPlantId])
  @@map("growatt_devices")
}

// ─── Lecturas mensuales (dato crudo) ─────────────────────────────────────────
// Históricamente el 63% de las lecturas llegó sin consumo ni exportación (el
// smart meter falla seguido), así que la carga manual es parte del flujo normal,
// no una excepción. De ahí la fuente por campo.

model ReporteFvLectura {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  periodo   DateTime @db.Date // SIEMPRE día 1 del mes

  generacionKwh        Decimal? @db.Decimal(12, 2)
  // consumo = generación + importación medida - exportación
  consumoKwh           Decimal? @db.Decimal(12, 2)
  exportacionKwh       Decimal? @db.Decimal(12, 2)
  // Crudo del smart meter. No entra al cálculo (la importación de red se deriva
  // del consumo) pero se guarda para poder auditar de dónde salió el consumo.
  importacionMedidaKwh Decimal? @db.Decimal(12, 2)

  generacionFuente  ReporteFvFuente?
  consumoFuente     ReporteFvFuente?
  exportacionFuente ReporteFvFuente?

  // Cobertura del smart meter en el mes. El total de consumo/exportación se arma
  // sumando el máximo diario de cada día que reportó; un mes con días faltantes
  // produce un total parcial que parece completo. Guardar cuántos días de cuántos
  // reportaron es lo que permite distinguir un dato confiable de uno subestimado.
  // La ingesta descarta consumo/exportación si la cobertura no llega al 90%.
  // Null en las lecturas cargadas a mano o migradas (no vienen del medidor).
  diasConDatos  Int?
  diasEsperados Int?

  // Por qué faltan datos: "sin datalogger tipo 3", "cobertura 5/30", etc.
  motivoFaltante String?
  nota           String?

  editadoPorId String?
  editadoPor   User?     @relation("ReporteFvLecturaEditadaPor", fields: [editadoPorId], references: [id], onDelete: SetNull)
  editadoEn    DateTime? @db.Timestamptz(6)

  ingestaItemId String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@unique([projectId, periodo])
  @@index([periodo])
  @@map("reporte_fv_lecturas")
}

// ─── Corridas de ingesta ─────────────────────────────────────────────────────
// Cada item se escribe apenas termina su planta, no al final: si el proceso
// muere a mitad de camino el estado parcial ya quedó persistido y la próxima
// corrida saltea lo que ya está completo.

model ReporteFvIngesta {
  id      String               @id @default(cuid())
  periodo DateTime             @db.Date
  modo    ReporteFvIngestaModo

  estado      ReporteFvIngestaEstado @default(EN_CURSO)
  iniciadaEn  DateTime               @default(now()) @db.Timestamptz(6)
  terminadaEn DateTime?              @db.Timestamptz(6)

  plantasTotal Int @default(0)
  plantasOk    Int @default(0)
  plantasError Int @default(0)
  requests     Int @default(0)

  lanzadaPorId String?
  lanzadaPor   User?   @relation("ReporteFvIngestaLanzadaPor", fields: [lanzadaPorId], references: [id], onDelete: SetNull)
  errorMessage String?

  items ReporteFvIngestaItem[]

  @@index([periodo])
  @@map("reporte_fv_ingestas")
}

model ReporteFvIngestaItem {
  id        String           @id @default(cuid())
  ingestaId String
  ingesta   ReporteFvIngesta @relation(fields: [ingestaId], references: [id], onDelete: Cascade)

  growattPlantId BigInt
  projectId      String?
  ok             Boolean @default(false)

  generacionKwh  Decimal? @db.Decimal(12, 2)
  consumoKwh     Decimal? @db.Decimal(12, 2)
  exportacionKwh Decimal? @db.Decimal(12, 2)

  requests     Int     @default(0)
  duracionMs   Int?
  errorMessage String?

  @@unique([ingestaId, growattPlantId])
  @@map("reporte_fv_ingesta_items")
}

// ─── Resultado calculado ─────────────────────────────────────────────────────
// Se regenera entero cada vez que cambia una lectura, la config o la tarifa: la
// cuenta corriente UTE es acumulativa y arrastra saldo mes a mes, así que
// recalcular la serie completa del cliente es la única forma de no dejar saldos
// huérfanos al corregir un mes viejo. Son ~25 periodos por cliente: milisegundos.

model ReporteFvCalculo {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  periodo   DateTime @db.Date

  // Congelados: con qué tarifa y qué cotización se calculó este mes.
  tarifaVersionId String
  tarifaVersion   TarifaUteVersion @relation(fields: [tarifaVersionId], references: [id], onDelete: Restrict)
  tipoCambioUsd   Decimal          @db.Decimal(10, 4)
  // Tarifa sobre la que se reportan el ahorro y el ROI: la contratada si es
  // empresa, SIMPLE si es residencial.
  tarifaPrincipal TarifaUte

  // Energía derivada del mes
  autoconsumoKwh            Decimal @db.Decimal(12, 2)
  importacionRedKwh         Decimal @db.Decimal(12, 2)
  // Los créditos por exportación se valúan con lo exportado el mes ANTERIOR.
  exportacionMesAnteriorKwh Decimal @db.Decimal(12, 2)

  // Resultado de la tarifa principal (equivale a una fila del histórico Excel)
  ahorroAutoconsumo Decimal @db.Decimal(14, 2)
  ahorroVenta       Decimal @db.Decimal(14, 2)
  ahorroTotal       Decimal @db.Decimal(14, 2)
  ahorroTotalUsd    Decimal @db.Decimal(14, 2)
  irpf              Decimal @db.Decimal(14, 2)

  // Acumulados congelados, para que el panel y el portal no recomputen la serie.
  ahorroAcumulado            Decimal   @db.Decimal(14, 2)
  ahorroAcumuladoUsd         Decimal   @db.Decimal(14, 2)
  irpfAcumulado              Decimal   @db.Decimal(14, 2)
  ahorroPromedioHistorico    Decimal   @db.Decimal(14, 2)
  ahorroPromedioHistoricoUsd Decimal   @db.Decimal(14, 2)
  mesesConDatosUsd           Int
  retornoInversionPct        Decimal   @db.Decimal(7, 2)
  mesRetornoEstimado         DateTime? @db.Date

  // Control UTE: la exportación anual no debe superar la importación anual.
  exportacionAcumuladaAnio Decimal @db.Decimal(14, 2)
  importacionAcumuladaAnio Decimal @db.Decimal(14, 2)
  ratioUte                 Decimal @db.Decimal(7, 2)
  estadoUte                String // OK | ALERTA | EXCEDIDO - SIN RIESGO | EXCEDIDO - CON RIESGO

  // Config efectiva usada (ya resueltos los fallbacks al proyecto).
  configSnapshot Json
  // Notas dinámicas del reporte (ej. alerta de consumo excesivo).
  notas          Json

  tarifas   ReporteFvCalculoTarifa[]
  emisiones ReporteFvEmision[]

  calculadoEn DateTime @default(now()) @db.Timestamptz(6)

  @@unique([projectId, periodo])
  @@index([periodo])
  @@map("reporte_fv_calculos")
}

// Una fila por tarifa comparada. El reporte residencial muestra 3; el de empresa,
// solo la contratada. Las 4 se calculan siempre.
model ReporteFvCalculoTarifa {
  id        String           @id @default(cuid())
  calculoId String
  calculo   ReporteFvCalculo @relation(fields: [calculoId], references: [id], onDelete: Cascade)
  tarifa    TarifaUte

  // Factura hipotética SIN paneles
  sinTotalNeto    Decimal @db.Decimal(14, 2)
  sinCargoEnergia Decimal @db.Decimal(14, 2)

  // Factura real CON paneles (post cuenta corriente)
  conTotalBruto      Decimal @db.Decimal(14, 2)
  conTotalNeto       Decimal @db.Decimal(14, 2)
  conCargoEnergia    Decimal @db.Decimal(14, 2)
  conIva             Decimal @db.Decimal(14, 2)
  conIrpf            Decimal @db.Decimal(14, 2)
  creditoExportacion Decimal @db.Decimal(14, 2)

  // Cuenta corriente UTE (arrastre mes a mes, por tarifa)
  saldoInicial     Decimal @db.Decimal(14, 2)
  saldoAplicado    Decimal @db.Decimal(14, 2)
  saldoGeneradoMes Decimal @db.Decimal(14, 2)
  saldoFinal       Decimal @db.Decimal(14, 2)

  // Desglose del ahorro
  ahorroAutoconsumo   Decimal @db.Decimal(14, 2)
  ahorroVenta         Decimal @db.Decimal(14, 2)
  ahorroTotalDesglose Decimal @db.Decimal(14, 2)
  // El total que muestra la tabla comparativa. Difiere de ahorroTotalDesglose
  // porque el original lo calcula pre-cuenta-corriente mientras que el "total
  // con paneles" de la misma columna es post. Se replica tal cual: cambiarlo
  // desalinearía todos los reportes ya enviados.
  ahorroTotalTabla    Decimal @db.Decimal(14, 2)
  pctAutoconsumo      Decimal @db.Decimal(6, 2)
  pctVenta            Decimal @db.Decimal(6, 2)

  @@unique([calculoId, tarifa])
  @@map("reporte_fv_calculo_tarifas")
}

// ─── Emisión (PDF congelado) ─────────────────────────────────────────────────
// Regenerar crea una versión nueva, igual que UnifilarVersion/EFPVersion.
// snapshotJson guarda el view-model completo: con eso el PDF se reproduce
// idéntico años después aunque hayan cambiado tarifas, config o motor.

model ReporteFvEmision {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  periodo   DateTime @db.Date
  version   Int

  calculoId String
  calculo   ReporteFvCalculo @relation(fields: [calculoId], references: [id], onDelete: Restrict)

  estado       ReporteFvEmisionEstado @default(BORRADOR)
  snapshotJson Json

  fileAttachmentId String?
  fileAttachment   FileAttachment? @relation("ReporteFvPdf", fields: [fileAttachmentId], references: [id], onDelete: SetNull)

  publicadoEnPortal Boolean   @default(false)
  publicadoEn       DateTime? @db.Timestamptz(6)

  // CLAIM de idempotencia del envío. Se setea con un updateMany condicional
  // (where enviadoEn: null) para que dos procesos concurrentes —cron y botón
  // manual, por ejemplo— no puedan mandar el mismo reporte dos veces. Si el
  // envío falla se revierte a null para poder reintentar.
  enviadoEn DateTime? @db.Timestamptz(6)

  generadoPorId String?
  generadoPor   User?    @relation("ReporteFvEmisionGeneradaPor", fields: [generadoPorId], references: [id], onDelete: SetNull)
  generadoEn    DateTime @default(now()) @db.Timestamptz(6)

  envios ReporteFvEnvio[]

  @@unique([projectId, periodo, version])
  @@index([periodo, estado])
  @@index([publicadoEnPortal])
  @@map("reporte_fv_emisiones")
}

// Historial de cada intento de envío, incluidos los dry-run y los omitidos por
// no pasar las guardas. La planilla original tenía un CSV de log que nadie leía,
// y por eso re-correr el script reenviaba todo duplicado.
model ReporteFvEnvio {
  id        String           @id @default(cuid())
  emisionId String
  emision   ReporteFvEmision @relation(fields: [emisionId], references: [id], onDelete: Cascade)

  estado        ReporteFvEnvioEstado
  destinatarios String // CSV de los destinatarios reales (aunque en dev se redirija)
  emailLogId    String?
  errorMessage  String?
  esDryRun      Boolean              @default(false)

  enviadoPorId String?
  enviadoPor   User?    @relation("ReporteFvEnvioEnviadoPor", fields: [enviadoPorId], references: [id], onDelete: SetNull)
  enviadoEn    DateTime @default(now()) @db.Timestamptz(6)

  @@index([emisionId])
  @@map("reporte_fv_envios")
}

// ═════════════════════════════════════════════════════════════════════════════
// MONITOREO DIARIO DE PLANTAS
// ═════════════════════════════════════════════════════════════════════════════
// Antes de esto, que la planta de un cliente dejara de generar se descubría
// cuando el cliente llamaba, o al armar el reporte del mes siguiente. Podía
// pasar un mes entero apagada. Un cron diario revisa que cada planta haya
// generado ayer y, si no, clasifica el motivo.

// Serie diaria de generación. Tiene DOS consumidores: el monitoreo (necesita
// los últimos días para saber si la planta está viva) y el gráfico del portal
// del cliente. Sólo generación: consumo y exportación diarios costarían ~30
// requests por planta por mes contra el smart meter, que ya falla seguido.
model ReporteFvGeneracionDiaria {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fecha     DateTime @db.Date

  generacionKwh Decimal         @db.Decimal(10, 2)
  fuente        ReporteFvFuente @default(GROWATT)

  // Exportación del día, del smart meter. null = el medidor no reportó ese día,
  // que NO es lo mismo que haber exportado cero: el cero real significa que la
  // planta genera y no inyecta (inyección limitada en el inversor), y el null
  // sólo que no medimos. Confundirlos llena el panel de alertas falsas.
  exportacionKwh Decimal? @db.Decimal(10, 2)

  // Denormalizado para poder trazar de qué planta salió el dato: el vínculo
  // planta↔proyecto puede cambiar con el tiempo.
  growattPlantId BigInt?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@unique([projectId, fecha])
  @@index([fecha])
  @@map("reporte_fv_generaciones_diarias")
}

enum FvDiagnostico {
  OK
  GENERACION_BAJA // reservado: necesita ≥1 año de serie para tener sentido
  SIN_GENERACION // ~0 kWh con el equipo comunicando → falla del equipo
  SIN_COMUNICACION // el datalogger no reporta hace ≥N horas (WiFi, o apagada)
  ERROR_DISPOSITIVO // el inversor reporta un código de falla
  // Genera normal pero no inyecta a la red: señal de que la inyección quedó
  // limitada en el inversor. El cliente produce energía que no se le acredita,
  // y desde afuera se ve como una planta sana. Es mensual, no diario: la
  // exportación viene del smart meter y sólo se conoce tras la ingesta.
  SIN_EXPORTACION
  ESPERANDO_HABILITACION // todavía no pasó la habilitación UTE: no es un problema
  SILENCIADA
  SIN_DATOS_API // Growatt no respondió: problema NUESTRO, no del cliente
}

enum FvIncidenciaEstado {
  ABIERTA
  RESUELTA
  DESCARTADA
}

enum FvMonitorCorridaModo {
  CRON
  MANUAL
}

enum FvMonitorCorridaEstado {
  EN_CURSO
  OK
  PARCIAL
  ERROR
}

model FvMonitorCorrida {
  id String @id @default(cuid())

  // Día EVALUADO (el anterior), no el día en que corrió el cron. Es lo que se
  // filtra y lo que hay que mirar para saber si falta una corrida.
  fecha  DateTime               @db.Date
  modo   FvMonitorCorridaModo
  estado FvMonitorCorridaEstado @default(EN_CURSO)

  iniciadaEn  DateTime  @default(now()) @db.Timestamptz(6)
  terminadaEn DateTime? @db.Timestamptz(6)

  plantasTotal Int @default(0)
  plantasOk    Int @default(0)
  plantasError Int @default(0)
  requests     Int @default(0)

  incidenciasAbiertas Int     @default(0)
  incidenciasCerradas Int     @default(0)
  emailEnviado        Boolean @default(false)

  lanzadaPorId String?
  lanzadaPor   User?   @relation("FvMonitorCorridaLanzadaPor", fields: [lanzadaPorId], references: [id], onDelete: SetNull)
  errorMessage String?

  items FvMonitorItem[]

  @@index([fecha])
  @@map("fv_monitor_corridas")
}

model FvMonitorItem {
  id        String           @id @default(cuid())
  corridaId String
  corrida   FvMonitorCorrida @relation(fields: [corridaId], references: [id], onDelete: Cascade)

  growattPlantId BigInt
  projectId      String?

  diagnostico       FvDiagnostico
  generacionKwh     Decimal?      @db.Decimal(10, 2)
  diasSinGeneracion Int?
  detalle           String?

  ok           Boolean @default(true)
  requests     Int     @default(0)
  duracionMs   Int?
  errorMessage String?

  @@unique([corridaId, growattPlantId])
  @@index([growattPlantId])
  @@map("fv_monitor_items")
}

// El aviso no se manda "cuando algo está mal" sino "cuando algo EMPIEZA a estar
// mal": sin este ciclo de vida, una planta rota generaría el mismo mail todos
// los días hasta que alguien la arregle, y el mail se volvería ruido de fondo.
model FvIncidencia {
  id String @id @default(cuid())

  // Una y sólo una de las dos está seteada: la incidencia es de una planta
  // Growatt o de una Huawei. Se modela con dos FK nullables y no con una tabla
  // por marca para que el mail y el panel las muestren juntas — al que mira el
  // monitoreo no le importa de qué marca es el inversor que se cayó.
  growattPlantId BigInt?
  plant          GrowattPlant? @relation(fields: [growattPlantId], references: [plantId], onDelete: Cascade)
  huaweiPlantId  String?
  huaweiPlant    HuaweiPlant?  @relation(fields: [huaweiPlantId], references: [id], onDelete: Cascade)
  projectId      String?
  project        Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)

  diagnostico FvDiagnostico
  estado      FvIncidenciaEstado @default(ABIERTA)

  primeraDeteccionEn DateTime  @db.Date
  ultimaDeteccionEn  DateTime  @db.Date
  resueltaEn         DateTime? @db.Date

  diasAfectados      Int       @default(1)
  detalle            String?
  // Último día con generación antes de romperse: es el dato que más se mira
  // para saber desde cuándo el cliente está perdiendo plata.
  ultimaGeneracionEn DateTime? @db.Date

  revisadaPorId String?
  revisadaPor   User?     @relation("FvIncidenciaRevisadaPor", fields: [revisadaPorId], references: [id], onDelete: SetNull)
  revisadaEn    DateTime? @db.Timestamptz(6)
  nota          String?

  // Se avisó por mail hasta acá. Con notificadaEn != null la incidencia no
  // vuelve nunca a la sección "nuevas" del digest, corra el cron las veces que
  // corra. Éste es el candado real contra el aviso repetido.
  notificadaEn DateTime? @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  // OJO: la migración agrega a mano un índice único PARCIAL
  // (growattPlantId, diagnostico) WHERE estado = 'ABIERTA', que Prisma no sabe
  // expresar. Sin él, dos corridas concurrentes duplican la incidencia.
  @@index([growattPlantId, estado])
  @@index([huaweiPlantId, estado])
  @@index([estado, diagnostico])
  @@index([projectId])
  @@map("fv_incidencias")
}

// ─── Videos del proyecto ──────────────────────────────────────────────────────
// Videos que documentan el proyecto: los ensayos de obra (evidencia con
// retención permanente, sirve de respaldo interno y ante UTE) y los que graba el
// operario durante una visita técnica.
//
// El archivo que se conserva NO es el que subió el operario: todo video se
// recomprime a un perfil único (H.264 720p) porque un original de celular pesa
// dos órdenes de magnitud más y guardarlos crudos "para siempre" no entra en el
// disco. Los campos `original*` son la cadena de custodia de lo que se descartó.

enum TipoVideo {
  ENSAYO_ANTI_ISLA
  ENSAYO_ENCENDIDO
  VISITA
  OTRO
}

enum VideoProcessingStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

model ProjectVideo {
  id         String          @id @default(cuid())
  // Dueño: un proyecto, o un lead cuando el video se grabó en la visita de
  // ventas (antes de que el proyecto exista). Exactamente uno de los dos; la
  // validación es a nivel de service, igual que en `FileAttachment`. Al ganarse
  // el lead el video se reasigna al proyecto y `leadId` queda como rastro de
  // dónde salió.
  projectId  String?
  project    Project?        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  leadId     String?
  lead       SalesLead?      @relation("SalesLeadVideos", fields: [leadId], references: [id], onDelete: Cascade)
  // Subetapa de obra (O2P / O2T) desde la que se cargó, cuando se conoce.
  substageId String?
  substage   Substage?       @relation("ProjectVideoSubstage", fields: [substageId], references: [id], onDelete: SetNull)
  // Visita técnica en la que se grabó, cuando vino por esa vía. El video sigue
  // siendo del proyecto: si la visita se borra, el video queda igual.
  visitId    String?
  visit      TechnicalVisit? @relation("ProjectVideoVisit", fields: [visitId], references: [id], onDelete: SetNull)

  tipoVideo   TipoVideo
  descripcion String?

  // El adjunto se crea recién cuando la compresión termina bien: hasta entonces
  // no hay archivo definitivo que referenciar.
  fileAttachmentId String?
  fileAttachment   FileAttachment? @relation("ProjectVideoFile", fields: [fileAttachmentId], references: [id], onDelete: SetNull)

  posterUrl       String?
  durationSeconds Int?
  width           Int?
  height          Int?
  sizeBytes       Int?
  sha256          String?

  processingStatus   VideoProcessingStatus @default(PENDING)
  processingError    String?
  processingAttempts Int                   @default(0)

  // Cadena de custodia del original, que se borra tras comprimir. Permite
  // atestiguar de qué archivo proviene esta copia sin conservar los bytes.
  originalFilename  String
  originalSizeBytes Int
  originalMimeType  String
  originalSha256    String?
  originalProbe     Json?

  uploadedById String
  uploadedBy   User   @relation("ProjectVideoUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)

  // Borrado suave SIN borrar el archivo físico: es evidencia, y un borrado
  // equivocado no puede destruir los bytes. Purgar es un acto aparte y explícito.
  deletedAt   DateTime? @db.Timestamptz(6)
  deletedById String?
  deletedBy   User?     @relation("ProjectVideoDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  processedAt DateTime? @db.Timestamptz(6)

  @@index([projectId])
  @@index([leadId])
  @@index([substageId])
  @@index([visitId])
  @@index([processingStatus])
  @@index([deletedAt])
  @@map("project_videos")
}
