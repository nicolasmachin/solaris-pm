  tipoCambio           Decimal?                 @db.Decimal(10, 4)
  pagado               Boolean                  @default(false)
  cobrado              Boolean                  @default(false)
  impactaFlujo         Boolean                  @default(true)
  status               FinanceMovementStatus    @default(PAGADO)
  expectedDate         DateTime?                @db.Date
  dueDate              DateTime?                @db.Date
  invoiceNumber        String?
  sourceType           MovementSourceType       @default(MANUAL)
  materialItemId       String?
  materialItem         MaterialItem?            @relation(fields: [materialItemId], references: [id])
  quantity             Decimal?                 @db.Decimal(10, 2)
