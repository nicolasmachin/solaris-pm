}

model InstallationSchedule {
  id              String    @id @default(cuid())
  projectId       String    @unique
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  teamId          String?
  team            Team?     @relation(fields: [teamId], references: [id], onDelete: SetNull)
  teamName        String
  teamColor       String    @default("#378ADD")
  teamType        TeamType  @default(PROPIO)
  actualWorkEnd   DateTime? @db.Date
  confirmedAt     DateTime? @db.Timestamptz(6)
  confirmedBy     String?
  confirmedByUser User?     @relation("InstallationConfirmedBy", fields: [confirmedBy], references: [id], onDelete: SetNull)
  notes           String?
  createdBy       String?
