// ─── Trámites UTE ────────────────────────────────────────────────────────────

enum UteStage {
  CONSULTA
  SOLICITUD
  DOCS_1
  DOCS_2
  RELEVAR
  ENSAYOS
  FINALIZADO
}

enum UteStatus {
  CERRADO
  EN_PROCESO
  ESPERANDO
  PENDIENTE
}

model UteProcess {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  currentStage     UteStage  @default(CONSULTA)
  currentStatus    UteStatus @default(PENDIENTE)
  stageManuallySet Boolean   @default(false)

  caseNumber String?
  notes      String?
  dateColors Json?

  consultaSentAt     DateTime? @db.Date
  caseOpenedAt       DateTime? @db.Date
  consultaApprovedAt DateTime? @db.Date

  solicitudSentAt    DateTime? @db.Date
  proyectoApprovedAt DateTime? @db.Date

  docs1SentAt     DateTime? @db.Date
  docs1ApprovedAt DateTime? @db.Date

  ensayosSentAt     DateTime? @db.Date
  ensayosApprovedAt DateTime? @db.Date

  docs2SentAt DateTime? @db.Date
  finalizedAt DateTime? @db.Date

  createdById String?
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt   DateTime? @db.Timestamptz(6)

  @@index([projectId])
  @@index([currentStage])
  @@index([currentStatus])
  @@index([deletedAt])
  @@map("ute_processes")
}

// ─── Catálogo de materiales ──────────────────────────────────────────────────

model MaterialCategory {
  id          String  @id @default(cuid())
  nombre      String  @unique
  descripcion String?
  orden       Int     @default(0)
  activa      Boolean @default(true)

  items MaterialItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([activa])
  @@index([orden])
  @@map("material_categories")
}

model MaterialItem {
  id         String           @id @default(cuid())
  categoryId String
  category   MaterialCategory @relation(fields: [categoryId], references: [id])

  nombre      String
  descripcion String?
  unidad      String  @default("un")

  precioSugerido Decimal? @db.Decimal(12, 2)
  moneda         Moneda   @default(USD)
  ivaTasa        Float    @default(22.0)

  defaultSupplierId String?
  defaultSupplier   Supplier? @relation(fields: [defaultSupplierId], references: [id])

  activo Boolean @default(true)

  // Campos de stock (unificación con StockProduct)
  // gestionaStock = false → es un servicio / mano de obra, no tiene representación
  // física y no entra al inventario.
  gestionaStock     Boolean  @default(true)
  stockActual       Decimal  @default(0) @db.Decimal(10, 2)
  stockMinimo       Decimal? @db.Decimal(10, 2)
  ubicacionDeposito String?

  projectMaterials ProjectMaterial[]
  movimientos      FinanceMovement[]
  stockMovements   StockMovement[]
  invoiceItems     InvoiceItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([activo])
  @@index([gestionaStock])
  @@map("material_items")
}

model ProjectMaterial {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  materialItemId String
  materialItem   MaterialItem @relation(fields: [materialItemId], references: [id])

  quantity  Decimal @db.Decimal(10, 2)
  unitPrice Decimal @db.Decimal(12, 2)
  moneda    Moneda  @default(USD)
  ivaTasa   Float   @default(22.0)

  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id])

  notes String?

  // Fecha tentativa de compra/uso. Reemplaza el movement.expectedDate del flujo
  // viejo (donde cada grupo de materiales generaba un FinanceMovement PREVISTO).
  // Ahora vive directamente acá y alimenta el flujo de fondos sin pasar por
  // movements. movementId queda solo para los casos en que un material ya está
  // ligado a un movimiento avanzado (COMPROMETIDO/A_PAGAR/PAGADO) — los nuevos
  // proyectados no crean movements.
  expectedDate DateTime? @db.Date

  movementId String?
  movement   FinanceMovement? @relation(fields: [movementId], references: [id])

  // ─── Lista colaborativa (Ingeniería + Operaciones) ─────────────────────
  // Estado de compra/recepción del ítem. Editable por ambas áreas.
  status  MaterialStatus @default(PENDIENTE)
  // Tachado: el ítem queda en la lista pero atravesado por una línea (legible).
  crossed Boolean        @default(false)
  // Color de fondo opcional para códigos de color personales. Valores
  // permitidos: yellow | green | blue | purple | red | gray | null.
  rowColor String?

  // Audit livianas — quién agregó y quién editó por última vez.
  addedById String?
  addedBy   User?   @relation("ProjectMaterialAddedBy", fields: [addedById], references: [id], onDelete: SetNull)

  lastEditedAt    DateTime?
  lastEditedById  String?
  lastEditedBy    User?     @relation("ProjectMaterialLastEditedBy", fields: [lastEditedById], references: [id], onDelete: SetNull)
  // Rol del último editor (ej "INGENIERIA", "OPERACIONES", "ADMIN") — sirve
  // para mostrar "Última edición {rol} hace 2h" sin joinear con User.
  lastEditedRole  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([materialItemId])
  @@index([movementId])
  @@index([expectedDate])
  @@index([status])
  @@map("project_materials")
}

enum MaterialStatus {
  PENDIENTE
  PEDIDO
  RECIBIDO
  EN_STOCK
}

// ─── Desglose de factura (InvoiceItem) ──────────────────────────────────────
// Cada factura A_PAGAR/PAGADO puede llevar el detalle de los ítems comprados.
// Al confirmar el desglose, cada InvoiceItem genera un StockMovement de
// ENTRADA. Si el movimiento luego se anula, se revierte el StockMovement.

model InvoiceItem {
  id         String          @id @default(cuid())
  movementId String
  movement   FinanceMovement @relation(fields: [movementId], references: [id], onDelete: Cascade)

  materialItemId String
  materialItem   MaterialItem @relation(fields: [materialItemId], references: [id])

  quantity  Decimal @db.Decimal(10, 2)
  unitPrice Decimal @db.Decimal(12, 2)
  moneda    Moneda  @default(USD)
  ivaTasa   Float   @default(22.0)
  notes     String?

  // 1:1 con el StockMovement de ENTRADA generado al confirmar
  stockMovement StockMovement?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([movementId])
  @@index([materialItemId])
  @@map("invoice_items")
}

// ─── Payments + PaymentApplications ──────────────────────────────────────────
//
// Pago real hecho a un proveedor (transferencia, cheque, efectivo). Un pago
// puede aplicarse a una o varias facturas (FinanceMovement) vía
// PaymentApplication. El total aplicado puede ser menor al monto del pago
// (saldo a favor del proveedor) y un pago puede dejarse sin aplicar para
// asignarlo después.

model Payment {
  id         String   @id @default(cuid())
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  fecha  DateTime @db.Date
  monto  Decimal  @db.Decimal(14, 2)
  moneda Moneda   @default(USD)

  metodo     MetodoPago @default(TRANSFERENCIA)
  referencia String?
  notas      String?

  accountId String?
  account   Account? @relation(fields: [accountId], references: [id])

  applications PaymentApplication[]

  createdById String?
  createdBy   User?   @relation("PaymentCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([supplierId])
  @@index([fecha])
  @@index([deletedAt])
  @@index([accountId])
  @@map("payments")
}

// ─── Cuentas (caja, bancos) ──────────────────────────────────────────────────
//
// Una Account representa una caja física o cuenta bancaria desde donde sale o
// entra dinero. Los movimientos PAGADOS/COBRADOS y todos los Payments se
// vinculan a una cuenta para poder calcular saldos por caja/banco.

model Account {
  id                String      @id @default(cuid())
  nombre            String
  tipo              AccountType
  moneda            Moneda
  saldoInicial      Decimal     @default(0) @db.Decimal(14, 2)
  fechaSaldoInicial DateTime?   @db.Date
  notas             String?
  activa            Boolean     @default(true)

  movements       FinanceMovement[]
  payments        Payment[]
  reconciliations AccountReconciliation[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([activa])
  @@index([tipo])
  @@map("accounts")
}

// G.10 — Conciliación bancaria. Punto verificado en el tiempo donde el usuario
// cargó el saldo real de la cuenta (ej: extracto de home banking) y el sistema
// lo comparó contra el saldo calculado por movimientos. Si hubo diferencia y el
// usuario eligió aplicar ajuste, queda un FinanceMovement de tipo
// AJUSTE_CONCILIACION linkeado vía ajusteMovementId.
model AccountReconciliation {
  id String @id @default(cuid())

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  fecha          DateTime @db.Date
  saldoReal      Decimal  @db.Decimal(14, 2)
  saldoCalculado Decimal  @db.Decimal(14, 2)
  diferencia     Decimal  @db.Decimal(14, 2) // saldoReal - saldoCalculado

  ajusteMovementId String?          @unique
  ajusteMovement   FinanceMovement? @relation("ReconciliationAjuste", fields: [ajusteMovementId], references: [id], onDelete: SetNull)

  notas String?

  createdById String
  createdBy   User   @relation("ReconciliationCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([accountId, fecha])
  @@index([createdAt])
  @@map("account_reconciliations")
}

model PaymentApplication {
  id        String  @id @default(cuid())
  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  movementId String
  movement   FinanceMovement @relation(fields: [movementId], references: [id])

  montoAplicado Decimal @db.Decimal(14, 2)

  createdAt DateTime @default(now())

  @@unique([paymentId, movementId])
  @@index([movementId])
  @@map("payment_applications")
}

// ─── AI Assistant: registros de consultas + rate limits ──────────────────────

enum AIQueryStatus {
  SUCCESS
  SQL_INVALID
  EXECUTION_ERROR
  RATE_LIMIT_EXCEEDED
  PERMISSION_DENIED
  AI_ERROR
}

model AIQuery {
  id           String         @id @default(cuid())
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  question     String
  generatedSQL String?        @db.Text
  result       Json?
  response     String?        @db.Text

  status       AIQueryStatus
  errorMessage String?

  tokensInput  Int?
  tokensOutput Int?
  costUSD      Decimal?       @db.Decimal(10, 6)

  durationMs   Int?

  createdAt    DateTime       @default(now()) @db.Timestamptz(6)

  @@index([userId, createdAt])
  @@index([status])
  @@map("ai_queries")
}

model AIRateLimit {
  id              String  @id @default(cuid())
  userId          String  @unique
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  queriesPerDay   Int     @default(100)
  costUSDPerMonth Decimal @default(50) @db.Decimal(10, 2)

  enabled         Boolean @default(true)

  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)

  @@map("ai_rate_limits")
}

// ─── Generador de unifilares ──────────────────────────────────────────────
//
// `UnifilarVersion` representa un snapshot inmutable de un plano unifilar
// para un proyecto. Cada versión guarda los inputs eléctricos + un snapshot
// denormalizado de los datos del proyecto (cliente, ubicación, autor) para
// que el plano sea inmutable aunque después se modifiquen los datos del
// proyecto. Sin estados (DRAFT/FINAL); cada versión vale por sí misma.

enum TipoRed {
  MONO_230
  TRI_230_SN
  TRI_400_CN
}

enum TipoProteccionDC {
  TERMOMAGNETICO
  FUSIBLE
}

model UnifilarVersion {
  id            String   @id @default(cuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  versionNumber Int
  label         String?
  createdAt     DateTime @default(now()) @db.Timestamptz(6)

  // Snapshot del proyecto (denormalizado para inmutabilidad)
  snapshotCliente   String
  snapshotUbicacion String
  snapshotFecha     DateTime @db.Timestamptz(6)
  snapshotAutor     String

  // Ejes de variación
  tipoRed              TipoRed
  cantidadPaneles      Int
  potenciaPanelW       Int              @default(580)
  cantidadStrings      Int              @default(2)
  potenciaContratadaKw Float
  tipoProteccionDc     TipoProteccionDC @default(TERMOMAGNETICO)

  // Modelos de equipos (string libre)
  modeloPanel             String?
  modeloInversor          String
  potenciaInversorKw      Float
  modeloMedidorMonitoreo  String?
  calibreProteccionDc     String           @default("25A 2P")

  // Longitudes (metros, int)
  largoDcPanelesM      Int
  largoDcEsLargo       Boolean @default(false)
  largoAcInversorIcpM  Int
  largoAcIcpTableroM   Int

  @@unique([projectId, versionNumber])
  @@index([projectId])
  @@map("unifilar_versions")
}

// Versiones del documento "Resumen Técnico" (Pre-Ingeniería). Mismo patrón que
// UnifilarVersion: 1:N inmutable, snapshot del cliente al momento de crear, los
// datos eléctricos son texto libre (soporta multi-instalación tipo COVITEJA).
model PreIngenieriaVersion {
  id            String   @id @default(cuid())

  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  versionNumber Int
  label         String?
  createdAt     DateTime @default(now()) @db.Timestamptz(6)

  // Snapshot de datos del cliente (denormalizado al crear la versión)
  snapshotNombre        String
  snapshotDireccion     String?
  snapshotCiudad        String?
  snapshotCelular       String?
  snapshotFechaPrevista String?

  // Datos del sitio
  tipoTecho     String?
  tipoTechoOtro String?
  infoTecho     String?
  alturaTecho   String?

  // Datos eléctricos (texto libre, salvo potenciaPaneles que migró a entero
  // en watts — la columna acepta el W intended del panel, ej 580. Cantidad
  // sigue como string por ahora.)
  cantidadPaneles  String?
  potenciaPaneles  Int?
  inversor         String?
  stringsLineasDc  String?
  cableAc          String?
  termicaAc        String?
  diferencialAc    String?
  largoCablesAcMts String?
  largoCablesDcMts String?

  // Tipo de red (multi-select para multi-instalación)
  redMonofasica     Boolean @default(false)
  redTrifasica230SN Boolean @default(false)
  redTrifasica400CN Boolean @default(false)

  // Notas adicionales
  notasAdicionales String?

  // Trazabilidad de pre-rellenado desde unifilar (opcional, sin FK fuerte)
  unifilarVersionId String?

  // Trazabilidad de extracción desde minuta del relevamiento. Si se usó IA
  // para pre-rellenar el formulario, se guarda el FileAttachment del PDF
  // original + cuándo se extrajo + qué modelo se usó (auditoría/costos).
  minutaFileId      String?
  minutaFile        FileAttachment? @relation("MinutaSource", fields: [minutaFileId], references: [id], onDelete: SetNull)
  minutaExtractedAt DateTime?       @db.Timestamptz(6)
  minutaModelUsed   String?

  fotos PreIngenieriaFoto[]

  @@unique([projectId, versionNumber])
  @@index([projectId])
  @@index([minutaFileId])
  @@map("preingenieria_versions")
}

// Consolidador de materiales: herramienta global del módulo Ingeniería que
// agrupa las listas de materiales de varios proyectos en una sola tabla
// ítem×proyecto + total. NO está atada a un Project — los proyectos viven
// en el snapshot JSON. Versionado correlativo global.
model MaterialesConsolidadosVersion {
  id            String   @id @default(cuid())
  versionNumber Int      @unique
  label         String?
  createdAt     DateTime @default(now()) @db.Timestamptz(6)

  // Snapshot al momento de consolidar — si los proyectos cambian su lista o
  // se borran después, la versión queda intacta. Estructura:
  //   projectsSnapshot: [{ id, nombreCliente, potenciaKwp, ubicacion }, ...]
  //   itemsSnapshot:    [{ catalogItemId, nombre, categoria, categoriaOrden,
  //                        unidad, cantidadesPorProyecto: {pid: n}, total }]
  projectsSnapshot Json
  itemsSnapshot    Json

  // Paths del PDF y XLSX en STORAGE_PATH (relativos: ej. "ingenieria/consolidados/v3.pdf").
  // Esta herramienta es global (no atada a un proyecto) por lo que no usa
  // FileAttachment (que requiere projectId NOT NULL). Los archivos se sirven
  // por endpoint dedicado que verifica el permiso del módulo.
  pdfPath  String?
  xlsxPath String?

  @@index([createdAt])
  @@map("materiales_consolidados_versions")
}

model PreIngenieriaFoto {
  id               String                @id @default(cuid())
  versionId        String
  version          PreIngenieriaVersion  @relation(fields: [versionId], references: [id], onDelete: Cascade)
  orden            Int
  etiqueta         String?
  fileAttachmentId String?
  fileAttachment   FileAttachment?       @relation(fields: [fileAttachmentId], references: [id], onDelete: SetNull)

  @@index([versionId])
  @@index([fileAttachmentId])
  @@map("preingenieria_fotos")
}

// ─── Visita Técnica con IA ────────────────────────────────────────────────
// Operario carga audios/fotos/notas durante la visita y la IA genera un
// informe estructurado en 7 secciones. Cada vez que se agregan inputs nuevos,
// se genera una versión nueva del reporte que complementa la anterior.

enum VisitType {
  INICIAL
  REVISION
  COMPLEMENTARIA
}

enum VisitStatus {
  EN_CURSO
  FINALIZADA
  ARCHIVADA
}

enum VisitInputType {
  AUDIO
  PHOTO
  NOTE
}

enum TranscriptionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model TechnicalVisit {
  id          String  @id @default(cuid())
  projectId   String
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User    @relation("TechnicalVisitCreator", fields: [createdById], references: [id], onDelete: Restrict)

  visitDate DateTime    @db.Timestamptz(6)
  visitType VisitType   @default(INICIAL)
  notes     String?
  status    VisitStatus @default(EN_CURSO)

  inputs  VisitInput[]
  reports VisitReport[]

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  @@index([projectId])
  @@index([createdById])
  @@index([deletedAt])
  @@map("technical_visits")
}

model VisitInput {
  id      String         @id @default(cuid())
  visitId String
  visit   TechnicalVisit @relation(fields: [visitId], references: [id], onDelete: Cascade)

  type VisitInputType

  // Para AUDIO y PHOTO: archivo en storage.
  fileUrl      String?
  fileMimeType String?
  fileSize     Int?

  // Sólo AUDIO.
  transcription       String?              @db.Text
  transcriptionStatus TranscriptionStatus?

  // Sólo NOTE.
  noteText String? @db.Text

  // Etiqueta opcional para cualquier tipo (ej: "tablero general", "recorrida techo").
  description String?

  createdById String
  createdBy   User   @relation("VisitInputCreator", fields: [createdById], references: [id], onDelete: Restrict)

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  @@index([visitId, createdAt])
  @@index([deletedAt])
  @@map("visit_inputs")
}

model VisitReport {
  id      String         @id @default(cuid())
  visitId String
  visit   TechnicalVisit @relation(fields: [visitId], references: [id], onDelete: Cascade)

  version Int

  // Contenido estructurado: 7 secciones predefinidas como markdown.
  // { datosGenerales, acometida, techo, espacioInversor, canalizaciones,
  //   observaciones, proximosPasos }
  content Json

  summary             String? @db.Text
  changesFromPrevious String? @db.Text

  // [{ field, currentValue, suggestedValue, reason, confidence }]
  projectSuggestions Json?

  // IDs de los VisitInput que se usaron para generar este reporte.
  inputsUsed String[]

  modelUsed    String?
  tokensInput  Int?
  tokensOutput Int?
  costUsd      Decimal? @db.Decimal(10, 6)

  generatedAt   DateTime @default(now()) @db.Timestamptz(6)
  generatedById String
  generatedBy   User     @relation("VisitReportGenerator", fields: [generatedById], references: [id], onDelete: Restrict)

  // Path al PDF persistido (relativo a STORAGE_PATH). Null si la versión
  // todavía no se exportó a PDF.
  pdfPath String?

  @@unique([visitId, version])
  @@index([visitId])
  @@map("visit_reports")
}

// ─── Proyecto Final de Ingeniería (EFP) ─────────────────────────────────────
// Documento integrador que el proyectista arma a partir de pre-ingeniería +
// visitas técnicas + criterio profesional. Mismo patrón que VisitReport pero
// versionado N (cada "Crear nueva versión" o "Regenerar con IA" snapshotea).
// La edición inline NO crea versión nueva: actualiza la versión actual.

enum EFPStatus {
  DRAFT
  REVIEW
  APPROVED
  ARCHIVED
}

model EngineeringFinalProject {
  id        String  @id @default(cuid())
  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  status EFPStatus @default(DRAFT)

  versions    EFPVersion[]
  attachments EFPAttachment[]

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  @@index([deletedAt])
  @@map("engineering_final_projects")
}

model EFPVersion {
  id    String                  @id @default(cuid())
  efpId String
  efp   EngineeringFinalProject @relation(fields: [efpId], references: [id], onDelete: Cascade)

  version Int

  // Contenido de las 7 secciones como markdown:
  // { datosGenerales, resumenEjecutivo, analisisSitio, equipamiento,
  //   disenoElectrico, disenoMecanico, anexos }
  content Json

  // Checklist sugerida por la IA — qué revisar en cada sección. Misma estructura
  // de 7 keys con array de strings. Null si la versión no se generó con IA.
  checklist Json?

  // Visitas técnicas usadas como base de la generación.
  sourceVisitIds String[]

  // Si se generó con IA (vs. snapshot manual o edición inline).
  aiGenerated  Boolean  @default(false)
  modelUsed    String?
  tokensInput  Int?
  tokensOutput Int?
  costUsd      Decimal? @db.Decimal(10, 6)

  changesFromPrevious String? @db.Text

  // Snapshots congelados al momento de crear la versión. Antes el PDF re-leía
  // Project/PreIngeniería/UTE en cada export, así que aprobar v1 y después
  // cambiar capacityKwp mutaba el PDF de v1. Con estos snapshots, cada versión
  // queda anclada a los datos del momento. Estructura: ver
  // server/src/services/efp.snapshots.types.ts.
  snapshotProject   Json?
  snapshotPreIng    Json?
  snapshotUte       Json?
  snapshotMaterials Json?

  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)
  createdById String
  createdBy   User     @relation("EFPVersionCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([efpId, version])
  @@index([efpId, version])
  @@map("efp_versions")
}

// Anexos extra del proyecto final (datasheets, planos, fotos adicionales que
// el proyectista sube fuera de las visitas). Apuntan a un FileAttachment del
// proyecto para que aparezcan también en Documentos.
model EFPAttachment {
  id    String                  @id @default(cuid())
  efpId String
  efp   EngineeringFinalProject @relation(fields: [efpId], references: [id], onDelete: Cascade)

  fileAttachmentId String
  fileAttachment   FileAttachment @relation("EFPAttachmentFile", fields: [fileAttachmentId], references: [id], onDelete: Cascade)

  description String?
  category    String? // 'datasheet' | 'foto' | 'plano' | 'otro'

  // Si false, el archivo no se fusiona al PDF final (sigue listado en la UI).
  // Útil para excluir adjuntos pesados o irrelevantes del documento final.
  includeInPdf Boolean @default(true)

  uploadedById String
  uploadedBy   User   @relation("EFPAttachmentUploader", fields: [uploadedById], references: [id], onDelete: Restrict)

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  @@index([efpId])
  @@index([fileAttachmentId])
  @@map("efp_attachments")
}

// ─── Generador de documentos UTE ────────────────────────────────────────────
// Plantillas PDF en server/src/assets/ute-templates/. La config guarda los
// datos complementarios que no viven en Project (CI cliente, cuenta UTE,
// representante, etc.) más los datos técnicos UTE-específicos.
model UteDocumentConfig {
  id        String  @id @default(cuid())
  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Datos del cliente (lo que no está en Project)
  ciCliente       String  @default("")
  calle           String  @default("")
  numCalle        String  @default("")
  cuentaUte       String  @default("")
  casoUte         String  @default("")
  personaFisica   Boolean @default(true)
  empresa         Boolean @default(false)

  // Representante del cliente (si aplica)
  representa    String @default("")
  ciRepre       String @default("")
  calidadRepre  String @default("")

  // Datos de Voltia / técnico instalador / UTE
  fi          String @default("")
  rut         String @default("")
  dirFi       String @default("")  // Dirección de la firma instaladora (Voltia)
  ti          String @default("")
  ciTi        String @default("")
  oficina     String @default("")
  repUte      String @default("")
  calidadUte  String @default("")
  // "asUte" porque `as` es palabra reservada en TS.
  asUte       String @default("")
  ps          String @default("")
  x           String @default("")

  // Datos técnicos del sistema (lo que no está en SolarSystem)
  potenciaNomSolicitudImg   String  @default("")
  intensidadNomSolicitudImg String  @default("")
  tension230                Boolean @default(true)
  tension400                Boolean @default(false)
  tensionNomInversor230     Boolean @default(true)
  tensionNomInversor400     Boolean @default(false)
  fasesMono                 Boolean @default(true)
  fasesTri                  Boolean @default(false)
  tipoGeneradorSincMono     Boolean @default(true)
  tipoGeneradorSincTri      Boolean @default(false)
  potImg                    String  @default("")
  potImgLetras              String  @default("")
  potContratada             String  @default("")
  potContratadaLetras       String  @default("")
  potContratada1000         String  @default("")
  tarifa                    String  @default("")
  fp                        String  @default("")
  normas1                   String  @default("")
  normas2                   String  @default("")
  x1                        String  @default("")
  x2                        String  @default("")
  x3                        String  @default("")
  x4                        String  @default("")
  seriePanel                String  @default("")
  serieInversor             String  @default("")
  areaPaneles               String  @default("")

  // Fechas
  fechaDoc DateTime  @default(now()) @db.Date
  fechaFin DateTime? @db.Date

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@map("ute_document_configs")
}

// Auditoría de cada generación. Guarda snapshot completo de los datos usados
// para poder reproducir el ZIP si hace falta.
model UteDocumentGeneration {
  id             String   @id @default(cuid())
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  configSnapshot Json
  docsGenerated  String[]
  generatedById  String
  generatedBy    User     @relation("UteDocsGeneratedBy", fields: [generatedById], references: [id], onDelete: Restrict)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  @@index([projectId])
  @@index([generatedById])
  @@map("ute_document_generations")
}
