}

model FinanceApprovalHistory {
  id            String           @id @default(cuid())
  movimientoId  String
  movimiento    FinanceMovement  @relation(fields: [movimientoId], references: [id], onDelete: Cascade)
  userId        String
  user          User             @relation(fields: [userId], references: [id])
  accion        String
  comentario    String?
  estadoAntes   EstadoAprobacion
  estadoDespues EstadoAprobacion
  createdAt     DateTime         @default(now())

  @@index([movimientoId])
  @@index([userId])
