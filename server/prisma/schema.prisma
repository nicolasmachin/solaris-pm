generator client {
  provider      = "prisma-client-js"
  // "native" cubre macOS dev local; los Linux targets cubren el container.
  // bookworm-slim usa glibc (linux-arm64 / linux-x64), no musl.
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

