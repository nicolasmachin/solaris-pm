  updatedById String
  updatedBy   User         @relation("SettingUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(6)

  @@unique([level, key, userId, projectId])
  @@index([level, key])
