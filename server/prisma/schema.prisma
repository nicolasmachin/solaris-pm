// ─── Modelos existentes ───────────────────────────────────────────────────────

model User {
  id                             String                   @id @default(cuid())
  email                          String                   @unique
  password                       String
  name                           String
  phone                          String?
  roleId                         String
  role                           Role                     @relation(fields: [roleId], references: [id], onDelete: Restrict)
  tenantId                       String?
  avatarUrl                      String?                  @map("avatar_url")
  notificationPreferences        UserNotificationPreference?
  createdProjects                Project[]                @relation("ProjectCreatedBy")
  projectsSalesperson            Project[]                @relation("ProjectSalesperson")
  assignedSubstages              Substage[]
  assignedStages                 Stage[]                  @relation("StageResponsibleUser")
  completedChecklistItems        ChecklistItem[]          @relation("ChecklistCompletedBy")
  assignedTasks                  Task[]
  uploadedFiles                  FileAttachment[]         @relation("FileUploadedBy")
  auditLogs                      AuditLog[]
  notifications                  Notification[]
  comments                       Comment[]
  settings                       Setting[]                @relation("SettingUser")
  settingsUpdated                Setting[]                @relation("SettingUpdatedBy")
  salesLeadsAssigned             SalesLead[]              @relation("LeadAssignedTo")
  salesLeadsCreated              SalesLead[]              @relation("LeadCreatedBy")
  salesActivities                SalesActivity[]
  proposals                      ProposalGeneration[]     @relation("ProposalGeneratedBy")
  goals                          Goal[]                   @relation("GoalCreatedBy")
  financeMovementsCreated        FinanceMovement[]        @relation("FinanceMovCreadoPor")
  financeMovementsApproved       FinanceMovement[]        @relation("FinanceMovAprobadoPor")
  financeApprovalHistory         FinanceApprovalHistory[]
  paymentsCreated                Payment[]                @relation("PaymentCreatedBy")
  installationSchedulesConfirmed InstallationSchedule[]   @relation("InstallationConfirmedBy")
  reconciliationsCreated         AccountReconciliation[]  @relation("ReconciliationCreatedBy")
  aiQueries                      AIQuery[]
  aiRateLimit                    AIRateLimit?
  clientProjects                 Project[]                @relation("ProjectClient")
  projectClients                 ProjectClient[]          @relation("ProjectClientUser")
  projectClientsCreated          ProjectClient[]          @relation("ProjectClientCreatedBy")
  technicalVisitsCreated         TechnicalVisit[]         @relation("TechnicalVisitCreator")
  visitInputsCreated             VisitInput[]             @relation("VisitInputCreator")
  visitReportsGenerated          VisitReport[]            @relation("VisitReportGenerator")
  efpVersionsCreated             EFPVersion[]             @relation("EFPVersionCreator")
  efpAttachmentsUploaded         EFPAttachment[]          @relation("EFPAttachmentUploader")
  projectMaterialsAdded          ProjectMaterial[]        @relation("ProjectMaterialAddedBy")
  projectMaterialsEdited         ProjectMaterial[]        @relation("ProjectMaterialLastEditedBy")
  uteDocumentsGenerated          UteDocumentGeneration[]  @relation("UteDocsGeneratedBy")
  passwordTemporary              Boolean                  @default(false)
  deletedAt                      DateTime?                @db.Timestamptz(6)
  createdAt                      DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt                      DateTime                 @updatedAt @db.Timestamptz(6)

  @@index([deletedAt])
  @@index([tenantId])
  @@map("users")
}

model Project {
  id                   String                @id @default(cuid())
  code                 String                @unique
  tenantId             String?
  clientName           String
  capacityKwp          Decimal               @db.Decimal(10, 2)
  locationCity         String
  locationProvince     String
  status               ProjectStatus
  startDate            DateTime              @db.Date
  saleDate             DateTime?             @db.Date
  plannedEndDate       DateTime?             @db.Date
  actualEndDate        DateTime?             @db.Date
  budgetUsd            Decimal?              @db.Decimal(14, 2)
  executedUsd          Decimal               @db.Decimal(14, 2)
  estimatedMwhYear     Decimal?              @db.Decimal(10, 2)
  co2TonsAvoided       Decimal?              @db.Decimal(10, 2)
  actualOnboardingEnd  DateTime?             @db.Date
  actualEngineeringEnd DateTime?             @db.Date
  actualUteStart       DateTime?             @db.Date
  actualUteEnd         DateTime?             @db.Date
  modalidadPago        ModalidadPago?
  firstDateScheduledAt DateTime?             @db.Timestamptz(6)
  notificationEmail    String?
  notificationPhone    String?
  clientAddress        String?
  uteCodigoPS          String?
  uteCodigoAS          String?
  createdById          String
  createdBy            User                  @relation("ProjectCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  salespersonId        String?
  salesperson          User?                 @relation("ProjectSalesperson", fields: [salespersonId], references: [id], onDelete: SetNull)
  clientUserId         String?
  clientUser           User?                 @relation("ProjectClient", fields: [clientUserId], references: [id], onDelete: SetNull)
  stages               Stage[]
  substages            Substage[]
  checklistItems       ChecklistItem[]
  tasks                Task[]
  files                FileAttachment[]
  auditLogs            AuditLog[]
  notifications        Notification[]
  comments             Comment[]
  settings             Setting[]             @relation("SettingProject")
  convertedLeads       SalesLead[]           @relation("LeadConvertedTo")
  proposals            ProposalGeneration[]  @relation("ProposalProject")
  solarSystems         SolarSystem[]
  financeMovements     FinanceMovement[]
  projectMaterials     ProjectMaterial[]
  stockMovements       StockMovement[]
  installationSchedule InstallationSchedule?
  uteProcesses         UteProcess[]
  clients              ProjectClient[]
  unifilarVersions     UnifilarVersion[]
  preIngenieriaVersions PreIngenieriaVersion[]
  technicalVisits      TechnicalVisit[]
  engineeringFinalProject EngineeringFinalProject?
  uteDocumentConfig    UteDocumentConfig?
  uteDocumentGenerations UteDocumentGeneration[]
  deletedAt            DateTime?             @db.Timestamptz(6)
  createdAt            DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime              @updatedAt @db.Timestamptz(6)

  @@index([status])
  @@index([tenantId])
  @@index([createdById])
  @@index([salespersonId])
  @@index([clientUserId])
  @@index([plannedEndDate])
  @@index([saleDate])
  @@index([deletedAt])
  @@map("projects")
}

// Relación many-to-many entre Project y User (rol CLIENT). Reemplaza al
// `Project.clientUserId` que sólo permitía un cliente por proyecto. El campo
// directo se conserva como legacy (deprecado, no se actualiza desde nuevos
// endpoints) para no romper datos preexistentes hasta una migración posterior.
model ProjectClient {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation("ProjectClientUser", fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  createdById String?
  createdBy   User?    @relation("ProjectClientCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
  @@map("project_clients")
}

model SolarSystem {
  id                String     @id @default(cuid())
  projectId         String
  project           Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  order             Int        @default(1)
  description       String?
  inverterBrand     String?
  inverterPowerKw   Decimal?   @db.Decimal(10, 2)
  inverterQuantity  Int?       @default(1)
  inverterPhaseType PhaseType?
  inverterModel     String?
  panelQuantity     Int?
  panelPowerW       Int?
  panelBrand        String?
  panelModel        String?
  deletedAt         DateTime?  @db.Timestamptz(6)
  createdAt         DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime   @updatedAt @db.Timestamptz(6)

  @@unique([projectId, order])
  @@index([projectId])
  @@index([deletedAt])
  @@map("solar_systems")
}

model Stage {
  id                        String           @id @default(cuid())
  projectId                 String
  project                   Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  order                     Int
  name                      StageType
  status                    StageStatus
  progressPercent           Int
  tipoObra                  TipoObra?
  plannedStartDate          DateTime?        @db.Date
  plannedEndDate            DateTime?        @db.Date
  actualStartDate           DateTime?        @db.Date
  actualEndDate             DateTime?        @db.Date
  plannedDurationDays       Int?
  actualDurationDays        Int?
  delayDays                 Int?
  actualDatesManuallyEdited Boolean          @default(false)
  /// @deprecated usar responsibleUserId + relación responsibleUser. Se conserva como referencia.
  responsibleName           String?
  responsibleUserId         String?
  responsibleUser           User?            @relation("StageResponsibleUser", fields: [responsibleUserId], references: [id], onDelete: SetNull)
  notes                     String?
  substages                 Substage[]
  tasks                     Task[]
  files                     FileAttachment[]
  comments                  Comment[]
  deletedAt                 DateTime?        @db.Timestamptz(6)
  createdAt                 DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt                 DateTime         @updatedAt @db.Timestamptz(6)

  @@unique([projectId, order])
  @@unique([projectId, name])
  @@index([projectId, order])
  @@index([projectId, status])
  @@index([status])
  @@index([responsibleUserId])
  @@index([deletedAt])
  @@map("stages")
}

model Substage {
  id                 String           @id @default(cuid())
  stageId            String
  projectId          String
  order              Int
  name               String
  sopCode            String?
  responsableRol     String?
  status             SubstageStatus
  progressPercent    Int              @default(0)
  /// @deprecated usar userId + relación user. Se conserva como referencia del rol sugerido heredado del template.
  responsible        String
  userId             String?
  user               User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  stage              Stage            @relation(fields: [stageId], references: [id], onDelete: Cascade)
  project            Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  dueDate            DateTime?        @db.Date
  plannedStartDate   DateTime?        @db.Date
  plannedEndDate     DateTime?        @db.Date
  actualStartDate    DateTime?        @db.Date
  actualEndDate      DateTime?        @db.Date
  actualDurationDays Int?
  delayDays          Int?
  notes              String?
  isSystem           Boolean          @default(false)
  isActive           Boolean          @default(true)
  // Identifica una subetapa system-managed que representa una acción del
  // UteProcess (consultaSentAt, caseOpenedAt, …, finalizedAt). Sólo se setea
  // en subetapas de la stage HABILITACION_UTE generadas por el sync. Cuando
  // está set + isSystem=true, el endpoint bloquea cambios de nombre/orden.
  uteAction          String?
  checklistItems     ChecklistItem[]
  tasks              Task[]
  files              FileAttachment[]
  comments           Comment[]
  deadline                  DateTime? @db.Date
  deadlineManuallySet       Boolean   @default(false)
  deadlineNotificationSent  Boolean   @default(false)
  deadlineNotifiedAt        DateTime? @db.Timestamptz(6)
  deletedAt          DateTime?        @db.Timestamptz(6)
  createdAt          DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime         @updatedAt @db.Timestamptz(6)

  @@unique([stageId, order])
  @@index([stageId])
  @@index([projectId, status])
  @@index([status])
  @@index([userId])
  @@index([deletedAt])
  @@index([deadline])
  @@index([uteAction])
  @@map("substages")
}

model UserNotificationPreference {
  id                            String   @id @default(cuid())
  userId                        String   @unique
  user                          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Aviso 3 días antes de un deadline
  deadlineWarning               Boolean  @default(true)
  deadlineWarningInApp          Boolean  @default(true)
  deadlineWarningEmail          Boolean  @default(false)
  deadlineWarningWhatsapp       Boolean  @default(false)

  // Aviso al completarse la subetapa anterior a la mía
  prevSubstageCompleted         Boolean  @default(true)
  prevSubstageCompletedInApp    Boolean  @default(true)
  prevSubstageCompletedEmail    Boolean  @default(false)
  prevSubstageCompletedWhatsapp Boolean  @default(false)

  createdAt                     DateTime @default(now()) @db.Timestamptz(6)
  updatedAt                     DateTime @updatedAt @db.Timestamptz(6)

  @@map("user_notification_preferences")
}

enum DeadlineRuleTipo {
  DIAS_DESDE_CREACION
  DIAS_ANTES_INSTALACION
  MANUAL
  SIN_DEADLINE
}

// Reglas globales de cálculo de deadlines. Se matchea por (stageType, sopCode)
// o (stageType, substageName) contra el template de pipeline. Una regla aplica
// a las subetapas correspondientes en TODOS los proyectos.
model DeadlineRule {
  id           String           @id @default(cuid())
  stageType    StageType
  // Identifica la subetapa dentro de la etapa. Si ambos son null, la regla
  // aplica como default a todas las subetapas de ese stageType que no tengan
  // una regla más específica.
  sopCode      String?
  substageName String?
  tipo         DeadlineRuleTipo
  dias         Int?
  activa       Boolean          @default(true)
  createdAt    DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime         @updatedAt @db.Timestamptz(6)

  @@unique([stageType, sopCode, substageName])
  @@index([stageType])
  @@index([activa])
  @@map("deadline_rules")
}

model ChecklistItem {
  id                       String         @id @default(cuid())
  substageId               String
  substage                 Substage       @relation(fields: [substageId], references: [id], onDelete: Cascade)
  projectId                String
  project                  Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  order                    Int
  label                    String
  completed                Boolean        @default(false)
  completedAt              DateTime?      @db.Timestamptz(6)
  completedBy              String?
  user                     User?          @relation("ChecklistCompletedBy", fields: [completedBy], references: [id], onDelete: SetNull)
  notes                    String?
  isRequired               Boolean        @default(false)
  isBlocker                Boolean        @default(false)
  isCustom                 Boolean        @default(false)
  appliesWhenModalidadPago ModalidadPago?
  comments                 Comment[]
  deletedAt                DateTime?      @db.Timestamptz(6)
  createdAt                DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt                DateTime       @updatedAt @db.Timestamptz(6)

  @@index([substageId])
  @@index([completed])
  @@index([projectId])
  @@index([deletedAt])
  @@map("checklist_items")
}

model Task {
  id          String       @id @default(cuid())
  projectId   String
  stageId     String?
  substageId  String?
  title       String
  description String?
  status      TaskStatus
  priority    TaskPriority
  /// @deprecated usar userId + relación user. Se conserva como referencia legacy.
  responsible String
  userId      String?
  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stage       Stage?       @relation(fields: [stageId], references: [id], onDelete: SetNull)
  substage    Substage?    @relation(fields: [substageId], references: [id], onDelete: SetNull)
  comments    Comment[]
  dueDate     DateTime?    @db.Date
  completedAt DateTime?    @db.Timestamptz(6)
  deletedAt   DateTime?    @db.Timestamptz(6)
  createdAt   DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(6)

  @@index([projectId])
  @@index([status])
  @@index([projectId, status])
  @@index([userId])
  @@index([dueDate])
  @@index([deletedAt])
  @@map("tasks")
}

model FileAttachment {
  id             String              @id @default(cuid())
  // Un FileAttachment debe estar ligado a UN owner: o un Project, o un
  // SalesLead. La validación (XOR) se hace a nivel de service.
  projectId      String?
  leadId         String?
  stageId        String?
  substageId     String?
  filename       String
  storedFilename String
  mimeType       String
  sizeBytes      Int
  url            String
  tipo           FileAttachmentTipo? // null = upload manual legacy
  // Trazabilidad fina del origen para documentos generados por herramientas del
  // módulo Ingeniería. `tipo` queda como índice grueso (UNIFILAR, etc.); estos
  // campos permiten badges "Ingeniería: Unifilar v3" y filtros por origen.
  toolSource     String?
  toolVersion    Int?
  toolEntityId   String?
  uploadedById   String
  uploadedBy     User                @relation("FileUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)
  project        Project?            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  lead           SalesLead?          @relation("LeadAttachments", fields: [leadId], references: [id], onDelete: Cascade)
  stage          Stage?              @relation(fields: [stageId], references: [id], onDelete: SetNull)
  substage       Substage?           @relation(fields: [substageId], references: [id], onDelete: SetNull)
  preIngenieriaFotos     PreIngenieriaFoto[]
  preIngenieriaMinutaFor PreIngenieriaVersion[]  @relation("MinutaSource")
  efpAttachments         EFPAttachment[]         @relation("EFPAttachmentFile")
  proposalGenerations    ProposalGeneration[]    @relation("ProposalAttachment")
  deletedAt      DateTime?           @db.Timestamptz(6)
  createdAt      DateTime            @default(now()) @db.Timestamptz(6)

  @@index([projectId])
  @@index([leadId])
  @@index([uploadedById])
  @@index([deletedAt])
  @@index([toolSource])
  @@map("file_attachments")
}

enum FileAttachmentTipo {
  UPLOAD_MANUAL
  LISTA_MATERIALES
  PRESUPUESTO
  CALCULO_TRIANGULOS
  UNIFILAR
  PRE_INGENIERIA
  MINUTA_RELEVAMIENTO
  OTRO
}

model AuditLog {
  id           String          @id @default(cuid())
  entityType   AuditEntityType
  entityId     String
  projectId    String?
  project      Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  userId       String
  user         User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  action       AuditAction
  fieldChanged String?
  oldValue     String?
  newValue     String?
  description  String
  timestamp    DateTime        @default(now()) @db.Timestamptz(6)
  metadata     Json?

  @@index([entityType, entityId])
  @@index([projectId])
  @@index([projectId, timestamp])
  @@index([timestamp])
  @@index([userId])
  @@map("audit_logs")
}

model Notification {
  id           String           @id @default(cuid())
  userId       String?
  user         User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  projectId    String?
  project      Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
