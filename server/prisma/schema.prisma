  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  installations InstallationSchedule[]

  @@index([deletedAt])
  @@map("teams")
}

model StockMovement {
  id                String              @id @default(cuid())
  fecha             DateTime
  materialItemId    String
  materialItem      MaterialItem        @relation(fields: [materialItemId], references: [id])
  tipo              TipoMovimientoStock
  cantidad          Decimal             @db.Decimal(14, 3)
  costoUnitario     Decimal?            @db.Decimal(14, 2)
  costoTotal        Decimal?            @db.Decimal(14, 2)
  moneda            Moneda              @default(USD)
  stockResultante   Decimal             @db.Decimal(14, 3)
  supplierId        String?
  supplier          Supplier?           @relation(fields: [supplierId], references: [id])
  projectId         String?
  project           Project?            @relation(fields: [projectId], references: [id])
  financeMovementId String?
  financeMovement   FinanceMovement?    @relation(fields: [financeMovementId], references: [id])
  invoiceItemId     String?             @unique
  invoiceItem       InvoiceItem?        @relation(fields: [invoiceItemId], references: [id])
  causaIngreso      ExpenseSourceType?
  reversed          Boolean             @default(false)
  referencia        String?
  observaciones     String?
  createdAt         DateTime            @default(now())

  @@index([materialItemId])
  @@index([fecha])
  @@index([projectId])
  @@index([financeMovementId])
  @@index([reversed])
  @@map("stock_movements")
}

// ─── Trámites UTE ────────────────────────────────────────────────────────────

enum UteStage {
  CONSULTA
  SOLICITUD
  DOCS_1
  DOCS_2
  RELEVAR
  ENSAYOS
  FINALIZADO
}

enum UteStatus {
  CERRADO
  EN_PROCESO
  ESPERANDO
  PENDIENTE
}

model UteProcess {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  currentStage     UteStage  @default(CONSULTA)
  currentStatus    UteStatus @default(PENDIENTE)
  stageManuallySet Boolean   @default(false)

  caseNumber String?
  notes      String?
  dateColors Json?

  consultaSentAt     DateTime? @db.Date
  caseOpenedAt       DateTime? @db.Date
  consultaApprovedAt DateTime? @db.Date

  solicitudSentAt    DateTime? @db.Date
  proyectoApprovedAt DateTime? @db.Date

  docs1SentAt     DateTime? @db.Date
  docs1ApprovedAt DateTime? @db.Date

  ensayosSentAt     DateTime? @db.Date
  ensayosApprovedAt DateTime? @db.Date

  docs2SentAt DateTime? @db.Date
  finalizedAt DateTime? @db.Date

  createdById String?
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt   DateTime? @db.Timestamptz(6)

  @@index([projectId])
  @@index([currentStage])
  @@index([currentStatus])
  @@index([deletedAt])
  @@map("ute_processes")
}

// ─── Experiencia de Clientes ─────────────────────────────────────────────────
// Bitácora de interacciones del módulo Experiencia de Clientes (Ola 1 / MVP).
// El "cliente" es el proyecto (relación 1:1), por eso se cuelga de projectId.
// Diseñada para migración ADITIVA futura: cuando lleguen las olas 2-4 se agregan
// `direction` (ENTRANTE/SALIENTE) y `reason` (BIENVENIDA/SEGUIMIENTO/…) como
// columnas nullable nuevas, sin reinterpretar los registros viejos.
enum InteractionChannel {
  WHATSAPP
  EMAIL
  LLAMADA
  VISITA
  OTRO
}

// Dirección y motivo de la interacción (seguimientos paralelos de CX, §10).
// Nullable: los registros viejos quedan sin reinterpretar.
enum InteractionDirection {
  ENTRANTE
  SALIENTE
}

enum InteractionReason {
  BIENVENIDA
  SEGUIMIENTO
  AVISO_HABILITACION
  CONSULTA
  OTRO
}

model ClientInteraction {
  id            String                @id @default(cuid())
  projectId     String
  project       Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  channel       InteractionChannel
  direction     InteractionDirection?
  reason        InteractionReason?
  content       String                @db.Text
  authorId      String
  author        User                  @relation("ClientInteractionAuthor", fields: [authorId], references: [id])
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  // Soft delete: la interacción deja de mostrarse en la UI pero queda en la DB.
  // deletedBy queda como rastro extra (el quién también va en la auditoría).
  deletedAt     DateTime?             @db.Timestamptz(6)
  deletedBy     String?
  deletedByUser User?                 @relation("ClientInteractionDeletedBy", fields: [deletedBy], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([deletedAt])
  @@map("client_interactions")
}

// ─── Catálogo de materiales ──────────────────────────────────────────────────

model MaterialCategory {
  id          String  @id @default(cuid())
  nombre      String  @unique
  descripcion String?
  orden       Int     @default(0)
  activa      Boolean @default(true)

  items MaterialItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([activa])
  @@index([orden])
  @@map("material_categories")
}

model MaterialItem {
  id         String           @id @default(cuid())
  categoryId String
  category   MaterialCategory @relation(fields: [categoryId], references: [id])

  nombre      String
  descripcion String?
  unidad      String  @default("un")

  precioSugerido Decimal? @db.Decimal(12, 2)
  moneda         Moneda   @default(USD)
  ivaTasa        Float    @default(22.0)

  defaultSupplierId String?
  defaultSupplier   Supplier? @relation(fields: [defaultSupplierId], references: [id])

  activo Boolean @default(true)

  // Foto de referencia del ítem: sirve para identificar visualmente el material
  // en las listas (hay ítems de nombre parecido que se confunden al comprar o
  // al preparar la salida a obra). Se guarda UNA sola imagen ya recomprimida a
  // JPEG chico bajo `storage/catalogo/materiales/`; el original se descarta.
  // `fotoPath` es la ruta relativa al storage, `fotoUpdatedAt` sirve para
  // invalidar el cache del navegador cuando se reemplaza.
  fotoPath      String?
  fotoUpdatedAt DateTime?

  // Campos de stock (unificación con StockProduct)
  // gestionaStock = false → es un servicio / mano de obra, no tiene representación
  // física y no entra al inventario.
  gestionaStock     Boolean  @default(true)
  stockActual       Decimal  @default(0) @db.Decimal(10, 2)
  stockMinimo       Decimal? @db.Decimal(10, 2)
  ubicacionDeposito String?

  projectMaterials      ProjectMaterial[]
  movimientos           FinanceMovement[]
  stockMovements        StockMovement[]
  invoiceItems          InvoiceItem[]
  materialTemplateItems MaterialTemplateItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([activo])
  @@index([gestionaStock])
  @@map("material_items")
}

// Plantillas de lista de materiales: set reutilizable de ítems del catálogo
// (típicamente por tipo de instalación: Monofásico / Trifásico 230 / 400) que se
// aplica sobre la lista de un proyecto para precargar la base habitual en un click.
// Patrón espejo de ChecklistTemplate → ProjectChecklistItem.
model MaterialTemplate {
  id          String                 @id @default(cuid())
  nombre      String                 @unique
  descripcion String?
  phaseType   PhaseType?
  orden       Int                    @default(0)
  activa      Boolean                @default(true)
  items       MaterialTemplateItem[]
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@index([activa, orden])
  @@map("material_templates")
}

model MaterialTemplateItem {
  id             String           @id @default(cuid())
  templateId     String
  template       MaterialTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  materialItemId String
  materialItem   MaterialItem     @relation(fields: [materialItemId], references: [id], onDelete: Cascade)
  quantity       Decimal          @default(1) @db.Decimal(10, 2)
  orden          Int              @default(0)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([templateId, materialItemId])
  @@index([templateId])
  @@index([materialItemId])
  @@map("material_template_items")
}

model ProjectMaterial {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  materialItemId String
  materialItem   MaterialItem @relation(fields: [materialItemId], references: [id])

  quantity  Decimal @db.Decimal(10, 2)
  unitPrice Decimal @db.Decimal(12, 2)
  moneda    Moneda  @default(USD)
  ivaTasa   Float   @default(22.0)

  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id])

  notes String?

  // Fecha tentativa de compra/uso. Reemplaza el movement.expectedDate del flujo
  // viejo (donde cada grupo de materiales generaba un FinanceMovement PREVISTO).
  // Ahora vive directamente acá y alimenta el flujo de fondos sin pasar por
  // movements. movementId queda solo para los casos en que un material ya está
  // ligado a un movimiento avanzado (COMPROMETIDO/A_PAGAR/PAGADO) — los nuevos
  // proyectados no crean movements.
  expectedDate DateTime? @db.Date

  movementId String?
  movement   FinanceMovement? @relation(fields: [movementId], references: [id])

  // ─── Lista colaborativa (Ingeniería + Operaciones) ─────────────────────
  // Estado de compra/recepción del ítem. Editable por ambas áreas.
  status   MaterialStatus @default(PENDIENTE)
  // Tachado: el ítem queda en la lista pero atravesado por una línea (legible).
  crossed  Boolean        @default(false)
  // Color de fondo opcional para códigos de color personales. Valores
  // permitidos: yellow | green | blue | purple | red | gray | null.
  rowColor String?

  // Audit livianas — quién agregó y quién editó por última vez.
  addedById String?
  addedBy   User?   @relation("ProjectMaterialAddedBy", fields: [addedById], references: [id], onDelete: SetNull)

  lastEditedAt   DateTime?
  lastEditedById String?
  lastEditedBy   User?     @relation("ProjectMaterialLastEditedBy", fields: [lastEditedById], references: [id], onDelete: SetNull)
  // Rol del último editor (ej "INGENIERIA", "OPERACIONES", "ADMIN") — sirve
  // para mostrar "Última edición {rol} hace 2h" sin joinear con User.
  lastEditedRole String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([materialItemId])
  @@index([movementId])
  @@index([expectedDate])
  @@index([status])
  @@map("project_materials")
}

// Costos de obra NO-material cargados a mano (mano de obra, tercerizados,
// fletes, etc.). C14 "Control de Costos": complementan los consumos de stock
// (materiales) para el costo real total de la obra. Independientes de Finanzas.
model ProjectNonMaterialCost {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  concepto String
  monto    Decimal   @db.Decimal(14, 2)
  moneda   Moneda    @default(USD)
  fecha    DateTime? @db.Date
  notas    String?

  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([projectId])
  @@map("project_non_material_costs")
}

enum MaterialStatus {
  PENDIENTE
  PEDIDO
  RECIBIDO
  EN_STOCK
}

// ─── Desglose de factura (InvoiceItem) ──────────────────────────────────────
// Cada factura A_PAGAR/PAGADO puede llevar el detalle de los ítems comprados.
// Al confirmar el desglose, cada InvoiceItem genera un StockMovement de
// ENTRADA. Si el movimiento luego se anula, se revierte el StockMovement.

model InvoiceItem {
  id         String          @id @default(cuid())
  movementId String
  movement   FinanceMovement @relation(fields: [movementId], references: [id], onDelete: Cascade)

  materialItemId String
  materialItem   MaterialItem @relation(fields: [materialItemId], references: [id])

  quantity  Decimal @db.Decimal(10, 2)
  unitPrice Decimal @db.Decimal(12, 2)
  moneda    Moneda  @default(USD)
  ivaTasa   Float   @default(22.0)
  notes     String?

  // 1:1 con el StockMovement de ENTRADA generado al confirmar
  stockMovement StockMovement?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([movementId])
  @@index([materialItemId])
  @@map("invoice_items")
}

// ─── Payments + PaymentApplications ──────────────────────────────────────────
//
// Pago real hecho a un proveedor (transferencia, cheque, efectivo). Un pago
// puede aplicarse a una o varias facturas (FinanceMovement) vía
// PaymentApplication. El total aplicado puede ser menor al monto del pago
// (saldo a favor del proveedor) y un pago puede dejarse sin aplicar para
// asignarlo después.

model Payment {
  id         String   @id @default(cuid())
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  fecha  DateTime @db.Date
  monto  Decimal  @db.Decimal(14, 2)
  moneda Moneda   @default(USD)

  metodo     MetodoPago @default(TRANSFERENCIA)
  referencia String?
  notas      String?

  accountId String?
  account   Account? @relation(fields: [accountId], references: [id])

  applications PaymentApplication[]

  createdById String?
  createdBy   User?   @relation("PaymentCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([supplierId])
  @@index([fecha])
  @@index([deletedAt])
  @@index([accountId])
  @@map("payments")
}

// ─── Cuentas (caja, bancos) ──────────────────────────────────────────────────
//
// Una Account representa una caja física o cuenta bancaria desde donde sale o
// entra dinero. Los movimientos PAGADOS/COBRADOS y todos los Payments se
// vinculan a una cuenta para poder calcular saldos por caja/banco.

model Account {
  id                String      @id @default(cuid())
  nombre            String
  tipo              AccountType
  moneda            Moneda
  saldoInicial      Decimal     @default(0) @db.Decimal(14, 2)
  fechaSaldoInicial DateTime?   @db.Date
  notas             String?
  activa            Boolean     @default(true)

  movements       FinanceMovement[]
  payments        Payment[]
  reconciliations AccountReconciliation[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([activa])
  @@index([tipo])
  @@map("accounts")
}

// G.10 — Conciliación bancaria. Punto verificado en el tiempo donde el usuario
// cargó el saldo real de la cuenta (ej: extracto de home banking) y el sistema
// lo comparó contra el saldo calculado por movimientos. Si hubo diferencia y el
// usuario eligió aplicar ajuste, queda un FinanceMovement de tipo
// AJUSTE_CONCILIACION linkeado vía ajusteMovementId.
model AccountReconciliation {
  id String @id @default(cuid())

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  fecha          DateTime @db.Date
  saldoReal      Decimal  @db.Decimal(14, 2)
  saldoCalculado Decimal  @db.Decimal(14, 2)
  diferencia     Decimal  @db.Decimal(14, 2) // saldoReal - saldoCalculado

  ajusteMovementId String?          @unique
  ajusteMovement   FinanceMovement? @relation("ReconciliationAjuste", fields: [ajusteMovementId], references: [id], onDelete: SetNull)

  notas String?

  createdById String
  createdBy   User   @relation("ReconciliationCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([accountId, fecha])
  @@index([createdAt])
  @@map("account_reconciliations")
}

model PaymentApplication {
  id        String  @id @default(cuid())
  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  movementId String
  movement   FinanceMovement @relation(fields: [movementId], references: [id])

  montoAplicado Decimal @db.Decimal(14, 2)

  createdAt DateTime @default(now())

  @@unique([paymentId, movementId])
  @@index([movementId])
  @@map("payment_applications")
}

// ─── AI Assistant: registros de consultas + rate limits ──────────────────────

enum AIQueryStatus {
  SUCCESS
  SQL_INVALID
  EXECUTION_ERROR
  RATE_LIMIT_EXCEEDED
  PERMISSION_DENIED
  AI_ERROR
}

model AIQuery {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  question     String
  generatedSQL String? @db.Text
  result       Json?
  response     String? @db.Text

  status       AIQueryStatus
  errorMessage String?

  tokensInput  Int?
  tokensOutput Int?
  costUSD      Decimal? @db.Decimal(10, 6)

  durationMs Int?

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([userId, createdAt])
  @@index([status])
  @@map("ai_queries")
}

model AIRateLimit {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  queriesPerDay   Int     @default(100)
  costUSDPerMonth Decimal @default(50) @db.Decimal(10, 2)

  enabled Boolean @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@map("ai_rate_limits")
}

// ─── Generador de unifilares ──────────────────────────────────────────────
//
// `UnifilarVersion` representa un snapshot inmutable de un plano unifilar
// para un proyecto. Cada versión guarda los inputs eléctricos + un snapshot
// denormalizado de los datos del proyecto (cliente, ubicación, autor) para
// que el plano sea inmutable aunque después se modifiquen los datos del
// proyecto. Sin estados (DRAFT/FINAL); cada versión vale por sí misma.

enum TipoRed {
  MONO_230
  TRI_230_SN
  TRI_400_CN
}

enum TipoProteccionDC {
  TERMOMAGNETICO
  FUSIBLE
}

model UnifilarVersion {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  versionNumber Int
  label         String?
  createdAt     DateTime @default(now()) @db.Timestamptz(6)

  // Snapshot del proyecto (denormalizado para inmutabilidad)
  snapshotCliente   String
  snapshotUbicacion String
  snapshotFecha     DateTime @db.Timestamptz(6)
  snapshotAutor     String

  // Ejes de variación
  tipoRed              TipoRed
  cantidadPaneles      Int
  potenciaPanelW       Int              @default(580)
  cantidadStrings      Int              @default(2)
  potenciaContratadaKw Float
  tipoProteccionDc     TipoProteccionDC @default(TERMOMAGNETICO)

  // Modelos de equipos (string libre)
  modeloPanel             String?
  modeloInversor          String
  potenciaInversorKw      Float
  modeloMedidorMonitoreo  String?
  calibreProteccionDc     String  @default("25A 2P")
  // Overrides opcionales del calibre AC. Si son null, el SVG generator
  // usa la tabla de rules.ts en función de (potenciaInversorKw, tipoRed).
  // Si tienen valor, ese valor se imprime tal cual en el unifilar.
  termicaAcCalibre        String?
  diferencialAcCalibre    String?
  // Overrides opcionales de la SECCIÓN de los cables (mm², string libre).
  // Si son null, el generador usa la regla de rules.ts (corriente admisible).
  // Si tienen valor, ese valor se imprime tal cual — permite ajustar a mano
  // por caída de tensión o material (Cu/Al) que la regla no considera.
  // El prefijo de polaridad (2x/3x/4x) y el sufijo PE/solar siguen siendo
  // automáticos según tipo de red; el override es sólo el número de mm².
  seccionDcOverride       String? // cable DC (paneles ↔ tablero protecciones DC)
  seccionAcInvIcpOverride String? // cable AC inversor → ICP de la IMG
  seccionAcCasaOverride   String? // cable AC ICP → tablero general de la casa
  seccionPeOverride       String? // conductor PE a la jabalina común

  // Longitudes (metros, int)
  largoDcPanelesM     Int
  largoDcEsLargo      Boolean @default(false)
  largoAcInversorIcpM Int
  largoAcIcpTableroM  Int

  @@unique([projectId, versionNumber])
  @@index([projectId])
  @@map("unifilar_versions")
}

// Versiones del documento "Resumen Técnico" (Pre-Ingeniería). Mismo patrón que
// UnifilarVersion: 1:N inmutable, snapshot del cliente al momento de crear, los
// datos eléctricos son texto libre (soporta multi-instalación tipo COVITEJA).
model PreIngenieriaVersion {
  id String @id @default(cuid())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  versionNumber Int
  label         String?
  createdAt     DateTime @default(now()) @db.Timestamptz(6)

  // Snapshot de datos del cliente (denormalizado al crear la versión)
  snapshotNombre        String
  snapshotDireccion     String?
  snapshotCiudad        String?
  snapshotCelular       String?
  snapshotFechaPrevista String?

  // Datos del sitio
  tipoTecho     String?
  tipoTechoOtro String?
  infoTecho     String?
  alturaTecho   String?

  // Datos eléctricos (texto libre, salvo potenciaPaneles que migró a entero
  // en watts — la columna acepta el W intended del panel, ej 580. Cantidad
  // sigue como string por ahora.)
  cantidadPaneles  String?
  potenciaPaneles  Int?
  inversor         String?
  stringsLineasDc  String?
  cableAc          String?
  termicaAc        String?
  diferencialAc    String?
  largoCablesAcMts String?
  largoCablesDcMts String?

  // Tipo de red (multi-select para multi-instalación)
  redMonofasica     Boolean @default(false)
  redTrifasica230SN Boolean @default(false)
  redTrifasica400CN Boolean @default(false)

  // Notas adicionales
  notasAdicionales String?

  // Trazabilidad de pre-rellenado desde unifilar (opcional, sin FK fuerte)
  unifilarVersionId String?

  // Trazabilidad de extracción desde minuta del relevamiento. Si se usó IA
  // para pre-rellenar el formulario, se guarda el FileAttachment del PDF
  // original + cuándo se extrajo + qué modelo se usó (auditoría/costos).
  minutaFileId      String?
  minutaFile        FileAttachment? @relation("MinutaSource", fields: [minutaFileId], references: [id], onDelete: SetNull)
  minutaExtractedAt DateTime?       @db.Timestamptz(6)
  minutaModelUsed   String?

  fotos PreIngenieriaFoto[]

  @@unique([projectId, versionNumber])
  @@index([projectId])
  @@index([minutaFileId])
  @@map("preingenieria_versions")
}

// Consolidador de materiales: herramienta global del módulo Ingeniería que
// agrupa las listas de materiales de varios proyectos en una sola tabla
// ítem×proyecto + total. NO está atada a un Project — los proyectos viven
// en el snapshot JSON. Versionado correlativo global.
model MaterialesConsolidadosVersion {
  id            String   @id @default(cuid())
  versionNumber Int      @unique
  label         String?
  createdAt     DateTime @default(now()) @db.Timestamptz(6)

  // Snapshot al momento de consolidar — si los proyectos cambian su lista o
  // se borran después, la versión queda intacta. Estructura:
  //   projectsSnapshot: [{ id, nombreCliente, potenciaKwp, ubicacion }, ...]
  //   itemsSnapshot:    [{ catalogItemId, nombre, categoria, categoriaOrden,
  //                        unidad, cantidadesPorProyecto: {pid: n}, total }]
  projectsSnapshot Json
  itemsSnapshot    Json

  // Paths del PDF y XLSX en STORAGE_PATH (relativos: ej. "ingenieria/consolidados/v3.pdf").
  // Esta herramienta es global (no atada a un proyecto) por lo que no usa
  // FileAttachment (que requiere projectId NOT NULL). Los archivos se sirven
  // por endpoint dedicado que verifica el permiso del módulo.
  pdfPath  String?
  xlsxPath String?

  @@index([createdAt])
  @@map("materiales_consolidados_versions")
}

model PreIngenieriaFoto {
  id               String               @id @default(cuid())
  versionId        String
  version          PreIngenieriaVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  orden            Int
  etiqueta         String?
  fileAttachmentId String?
  fileAttachment   FileAttachment?      @relation(fields: [fileAttachmentId], references: [id], onDelete: SetNull)

  @@index([versionId])
  @@index([fileAttachmentId])
  @@map("preingenieria_fotos")
}

// ─── Visita Técnica con IA ────────────────────────────────────────────────
// Operario carga audios/fotos/notas durante la visita y la IA genera un
// informe estructurado en 7 secciones. Cada vez que se agregan inputs nuevos,
// se genera una versión nueva del reporte que complementa la anterior.

enum VisitType {
  INICIAL
  REVISION
  COMPLEMENTARIA
}

enum VisitStatus {
  EN_CURSO
  FINALIZADA
  ARCHIVADA
}

enum VisitInputType {
  AUDIO
  PHOTO
  NOTE
}

enum TranscriptionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model TechnicalVisit {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation("TechnicalVisitCreator", fields: [createdById], references: [id], onDelete: Restrict)

  visitDate DateTime    @db.Timestamptz(6)
  visitType VisitType   @default(INICIAL)
  notes     String?
  status    VisitStatus @default(EN_CURSO)

  inputs  VisitInput[]
  reports VisitReport[]
  videos  ProjectVideo[] @relation("ProjectVideoVisit")

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  @@index([projectId])
  @@index([createdById])
  @@index([deletedAt])
  @@map("technical_visits")
}

model VisitInput {
  id      String         @id @default(cuid())
  visitId String
  visit   TechnicalVisit @relation(fields: [visitId], references: [id], onDelete: Cascade)

  type VisitInputType

  // Para AUDIO y PHOTO: archivo en storage.
  fileUrl      String?
  fileMimeType String?
  fileSize     Int?

  // Sólo AUDIO.
  transcription       String?              @db.Text
  transcriptionStatus TranscriptionStatus?

  // Sólo NOTE.
  noteText String? @db.Text

  // Etiqueta opcional para cualquier tipo (ej: "tablero general", "recorrida techo").
  description String?

  createdById String
  createdBy   User   @relation("VisitInputCreator", fields: [createdById], references: [id], onDelete: Restrict)

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  @@index([visitId, createdAt])
  @@index([deletedAt])
  @@map("visit_inputs")
}

model VisitReport {
  id      String         @id @default(cuid())
  visitId String
  visit   TechnicalVisit @relation(fields: [visitId], references: [id], onDelete: Cascade)

  version Int

  // Contenido estructurado: 7 secciones predefinidas como markdown.
  // { datosGenerales, acometida, techo, espacioInversor, canalizaciones,
  //   observaciones, proximosPasos }
  content Json

  summary             String? @db.Text
  changesFromPrevious String? @db.Text

  // [{ field, currentValue, suggestedValue, reason, confidence }]
  projectSuggestions Json?

  // IDs de los VisitInput que se usaron para generar este reporte.
  inputsUsed String[]

  modelUsed    String?
  tokensInput  Int?
  tokensOutput Int?
  costUsd      Decimal? @db.Decimal(10, 6)

  generatedAt   DateTime @default(now()) @db.Timestamptz(6)
  generatedById String
  generatedBy   User     @relation("VisitReportGenerator", fields: [generatedById], references: [id], onDelete: Restrict)

  // Path al PDF persistido (relativo a STORAGE_PATH). Null si la versión
  // todavía no se exportó a PDF.
  pdfPath String?

  @@unique([visitId, version])
  @@index([visitId])
  @@map("visit_reports")
}

// ─── Proyecto Final de Ingeniería (EFP) ─────────────────────────────────────
// Documento integrador que el proyectista arma a partir de pre-ingeniería +
// visitas técnicas + criterio profesional. Mismo patrón que VisitReport pero
// versionado N (cada "Crear nueva versión" o "Regenerar con IA" snapshotea).
// La edición inline NO crea versión nueva: actualiza la versión actual.

enum EFPStatus {
  DRAFT
  REVIEW
  APPROVED
  ARCHIVED
}

model EngineeringFinalProject {
  id        String  @id @default(cuid())
  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  status EFPStatus @default(DRAFT)

  versions    EFPVersion[]
  attachments EFPAttachment[]

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  @@index([deletedAt])
  @@map("engineering_final_projects")
}

model EFPVersion {
  id    String                  @id @default(cuid())
  efpId String
  efp   EngineeringFinalProject @relation(fields: [efpId], references: [id], onDelete: Cascade)

  version Int

  // Contenido de las 7 secciones como markdown:
  // { datosGenerales, resumenEjecutivo, analisisSitio, equipamiento,
  //   disenoElectrico, disenoMecanico, anexos }
  content Json

  // Checklist sugerida por la IA — qué revisar en cada sección. Misma estructura
  // de 7 keys con array de strings. Null si la versión no se generó con IA.
  checklist Json?

  // Visitas técnicas usadas como base de la generación.
  sourceVisitIds String[]

  // Si se generó con IA (vs. snapshot manual o edición inline).
  aiGenerated  Boolean  @default(false)
  modelUsed    String?
  tokensInput  Int?
  tokensOutput Int?
  costUsd      Decimal? @db.Decimal(10, 6)

  changesFromPrevious String? @db.Text

  // Snapshots congelados al momento de crear la versión. Antes el PDF re-leía
  // Project/PreIngeniería/UTE en cada export, así que aprobar v1 y después
  // cambiar capacityKwp mutaba el PDF de v1. Con estos snapshots, cada versión
  // queda anclada a los datos del momento. Estructura: ver
  // server/src/services/efp.snapshots.types.ts.
  snapshotProject   Json?
  snapshotPreIng    Json?
  snapshotUte       Json?
  snapshotMaterials Json?

  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)
  createdById String
  createdBy   User     @relation("EFPVersionCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([efpId, version])
  @@index([efpId, version])
  @@map("efp_versions")
}

// Anexos extra del proyecto final (datasheets, planos, fotos adicionales que
// el proyectista sube fuera de las visitas). Apuntan a un FileAttachment del
// proyecto para que aparezcan también en Documentos.
model EFPAttachment {
  id    String                  @id @default(cuid())
  efpId String
  efp   EngineeringFinalProject @relation(fields: [efpId], references: [id], onDelete: Cascade)

  fileAttachmentId String
  fileAttachment   FileAttachment @relation("EFPAttachmentFile", fields: [fileAttachmentId], references: [id], onDelete: Cascade)

  description String?
  category    String? // 'datasheet' | 'foto' | 'plano' | 'otro'

  // Si false, el archivo no se fusiona al PDF final (sigue listado en la UI).
  // Útil para excluir adjuntos pesados o irrelevantes del documento final.
  includeInPdf Boolean @default(true)

  uploadedById String
  uploadedBy   User   @relation("EFPAttachmentUploader", fields: [uploadedById], references: [id], onDelete: Restrict)

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  @@index([efpId])
  @@index([fileAttachmentId])
  @@map("efp_attachments")
}

// ─── Generador de documentos UTE ────────────────────────────────────────────
// Plantillas PDF en server/src/assets/ute-templates/. La config guarda los
// datos complementarios que no viven en Project (CI cliente, cuenta UTE,
// representante, etc.) más los datos técnicos UTE-específicos.
model UteDocumentConfig {
  id        String  @id @default(cuid())
  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Datos del trámite UTE específicos al expediente. Los datos generales
  // del cliente (CI, calle, persona física/empresa) viven en Project.
  cuentaUte String @default("")
  casoUte   String @default("")

  // Representante del cliente (si aplica)
  representa   String @default("")
  ciRepre      String @default("")
  calidadRepre String @default("TITULAR")

  // Datos de Voltia / técnico instalador / UTE
  fi         String @default("MACHIN JUSTET NICOLAS FERNANDO")
  rut        String @default("150733900014")
  dirFi      String @default("Rondeau 2110") // Dirección de la firma instaladora (Voltia)
  ti         String @default("Nicolás Machín")
  ciTi       String @default("4.139.492-7")
  oficina    String @default("")
  repUte     String @default("")
  calidadUte String @default("")
  // AS = Acuerdo de Servicio UTE. "asUte" porque `as` es palabra reservada en TS.
  asUte      String @default("")
  ps         String @default("")
  x          String @default("")

  // Datos técnicos del sistema (lo que no está en SolarSystem)
  potenciaNomSolicitudImg   String  @default("")
  intensidadNomSolicitudImg String  @default("")
  tension230                Boolean @default(true)
  tension400                Boolean @default(false)
  tensionNomInversor230     Boolean @default(true)
  tensionNomInversor400     Boolean @default(false)
  fasesMono                 Boolean @default(true)
  fasesTri                  Boolean @default(false)
  tipoGeneradorSincMono     Boolean @default(true)
  tipoGeneradorSincTri      Boolean @default(false)
  potImg                    String  @default("")
  potImgLetras              String  @default("")
  potContratada             String  @default("")
  potContratadaLetras       String  @default("")
  potContratada1000         String  @default("")
  tarifa                    String  @default("")
  fp                        String  @default("0.95 inductivo – 0.95 capacitivo")
  normas1                   String  @default("IEC62109-1, IEC62109-2")
  normas2                   String  @default("IEC62116 y EN50438")
  x1                        String  @default("")
  x2                        String  @default("")
  x3                        String  @default("X")
  x4                        String  @default("X")
  seriePanel                String  @default("")
  serieInversor             String  @default("")
  areaPaneles               String  @default("")

  // Fechas — ambas opcionales y sin default. El usuario las elige
  // explícitamente en el form. Si quedan vacías, los Dia/Mes/Año del PDF
  // salen como string vacío.
  fechaDoc DateTime? @db.Date
  fechaFin DateTime? @db.Date

  // Aumento de potencia contratada (trámite opcional que se pide a UTE desde
  // Onboarding, ver aumento-potencia). `potSolicitada` es la potencia nueva
  // que se le pide a UTE — distinta de `potContratada`, que es la vigente hoy.
  // `aumentoPotenciaSentAt` se completa sola al enviar el mail y no se pisa.
  potSolicitada         String    @default("")
  aumentoPotenciaSentAt DateTime? @db.Date

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@map("ute_document_configs")
}

// Auditoría de cada generación. Guarda snapshot completo de los datos usados
// para poder reproducir el ZIP si hace falta.
model UteDocumentGeneration {
  id             String   @id @default(cuid())
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  configSnapshot Json
  docsGenerated  String[]
  generatedById  String
  generatedBy    User     @relation("UteDocsGeneratedBy", fields: [generatedById], references: [id], onDelete: Restrict)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  @@index([projectId])
  @@index([generatedById])
  @@map("ute_document_generations")
}

// ─── Sistema de mails ─────────────────────────────────────────────────────────

// Configuración SMTP por usuario. La password se guarda cifrada (AES-256-GCM
// con SMTP_ENCRYPTION_KEY); nunca se devuelve al cliente en claro.
model UserSmtpConfig {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  host              String
  port              Int
  secure            Boolean @default(true) // true = 465 (SSL), false = 587 (STARTTLS)
  username          String
  passwordEncrypted String
  fromName          String?
  replyTo           String?

  verifiedAt DateTime? @db.Timestamptz(6) // última vez que "Probar conexión" dio OK

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@map("user_smtp_configs")
}

// Plantilla de mail con motor Handlebars (variables + condicionales).
model EmailTemplate {
  id          String  @id @default(cuid())
  key         String  @unique // slug estable para auto-selección (ej. "consulta_ute")
  nombre      String
  descripcion String?

  modulo Module
  scope  EmailTemplateScope @default(PROJECT)

  toTemplate      String @default("")
  ccTemplate      String @default("")
  bccTemplate     String @default("")
  subjectTemplate String
  bodyTemplate    String @db.Text

  activo    Boolean @default(true)
  esSistema Boolean @default(false) // sembradas: editables pero no borrables

  logs EmailLog[] @relation("EmailLogTemplate")

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@map("email_templates")
}

enum EmailTemplateScope {
  PROJECT
  LEAD
  GLOBAL
}

// Auditoría de cada envío. No guarda el cuerpo (decisión tomada).
model EmailLog {
  id          String         @id @default(cuid())
  templateId  String?
  template    EmailTemplate? @relation("EmailLogTemplate", fields: [templateId], references: [id], onDelete: SetNull)
  templateKey String? // snapshot del key por si se borra la plantilla

  projectId String?
  project   Project? @relation("EmailLogProject", fields: [projectId], references: [id], onDelete: SetNull)
  leadId    String?

  sentById String
  sentBy   User   @relation("EmailSentBy", fields: [sentById], references: [id], onDelete: Restrict)

  toAddresses  String // CSV
  ccAddresses  String?
  bccAddresses String?
  subject      String

  status       EmailStatus
  errorMessage String?

  sentAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([projectId])
  @@index([sentById])
  @@index([sentAt])
  @@map("email_logs")
}

enum EmailStatus {
  SENT
  FAILED
}

// ─── Generador de propuestas v2 ──────────────────────────────────────────────
// Constructor interactivo que reemplaza progresivamente al generador Excel+Python
// (ProposalGeneration). Ver docs/features/proposals-v2/SPEC.md.

enum ProposalV2VersionStatus {
  PUBLISHED
  DISCARDED // soft-delete
}

// Borrador de propuesta v2: uno por lead, mutable, sin PDF persistido.
// La propuesta se genera durante la venta (fase lead), antes de que exista
// proyecto. Ver docs/features/proposals-v2/FASE_E_SPEC.md.
model ProposalV2Draft {
  id     String    @id @default(cuid())
  leadId String
  lead   SalesLead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  // Qué cotizador armó este borrador. Residencial y empresa son dos cotizadores
  // separados (dos botones en la ficha del lead) y cada uno tiene su propio
  // borrador: se puede estar armando las dos propuestas para el mismo cliente
  // sin que una pise a la otra. Por eso la unicidad es por el par y no por lead.
  //
  // La variante también viaja dentro de `data` — ahí es la que se congela en el
  // snapshot al publicar y la que elige plantilla y fórmula de comisión; acá es
  // la que rutea el borrador.
  variante ProposalVariante @default(RESIDENCIAL)

  // Inputs editables (calculadora + template). Shape validado por Zod en el
  // borde (draftDataSchema), no en la BD.
  data Json

  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)
  createdById String
  createdBy   User     @relation("ProposalV2DraftCreatedBy", fields: [createdById], references: [id])
  updatedById String
  updatedBy   User     @relation("ProposalV2DraftUpdatedBy", fields: [updatedById], references: [id])

  @@unique([leadId, variante])
  @@index([leadId])
  @@map("proposal_v2_drafts")
}

// Variante de propuesta comercial. RESIDENCIAL es la de siempre; EMPRESA es el
// cotizador B2B, con su propio documento, sus propios defaults y una comisión
// del asesor que crece con el markup negociado.
enum ProposalVariante {
  RESIDENCIAL
  EMPRESA
}

// Versión publicada: inmutable en contenido, numerada por lead, soft-deleteable.
// Snapshot completo + 2 PDFs persistidos en disco (paths relativos a STORAGE_PATH).
model ProposalV2Version {
  id            String                  @id @default(cuid())
  leadId        String
  lead          SalesLead               @relation(fields: [leadId], references: [id], onDelete: Restrict)
  versionNumber Int
  status        ProposalV2VersionStatus @default(PUBLISHED)

  // Todo lo necesario para regenerar el PDF idéntico (ver spec sección 6).
  snapshot Json

  // Paths relativos a STORAGE_PATH.
  fullPdfPath    String
  summaryPdfPath String

  publishedAt   DateTime @default(now()) @db.Timestamptz(6)
  publishedById String
  publishedBy   User     @relation("ProposalV2VersionPublishedBy", fields: [publishedById], references: [id])

  // Soft-delete.
  discardedAt   DateTime? @db.Timestamptz(6)
  discardedById String?
  discardedBy   User?     @relation("ProposalV2VersionDiscardedBy", fields: [discardedById], references: [id], onDelete: SetNull)
  discardReason String?

  commissions       Commission[]
  installerPayments InstallerPayment[]

  @@unique([leadId, versionNumber])
  @@index([leadId, status])
  @@map("proposal_v2_versions")
}

enum ContractVersionStatus {
  PUBLISHED
  DISCARDED
}

// Borrador del contrato: uno por proyecto, mutable, sin PDF persistido. Se edita
// en la subetapa "Contrato" del onboarding con el mismo generador que las
// propuestas (form + preview en vivo). Shape validado por Zod en el borde.
model ContractDraft {
  id        String  @id @default(cuid())
  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  data Json

  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)
  createdById String
  createdBy   User     @relation("ContractDraftCreatedBy", fields: [createdById], references: [id])
  updatedById String
  updatedBy   User     @relation("ContractDraftUpdatedBy", fields: [updatedById], references: [id])

  @@index([projectId])
  @@map("contract_drafts")
}

// Versión publicada del contrato: inmutable en contenido, numerada por proyecto,
// soft-deleteable. Snapshot completo + 1 PDF persistido en disco (path relativo a
// STORAGE_PATH).
model ContractVersion {
  id            String                @id @default(cuid())
  projectId     String
  project       Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versionNumber Int
  status        ContractVersionStatus @default(PUBLISHED)

  snapshot Json
  pdfPath  String
  label    String?

  publishedAt   DateTime @default(now()) @db.Timestamptz(6)
  publishedById String
  publishedBy   User     @relation("ContractVersionPublishedBy", fields: [publishedById], references: [id])

  discardedAt   DateTime? @db.Timestamptz(6)
  discardedById String?
  discardReason String?

  @@unique([projectId, versionNumber])
  @@index([projectId, status])
  @@map("contract_versions")
}

enum ProformaVersionStatus {
  PUBLISHED
  DISCARDED
}

// Borrador de la proforma BBVA: uno por proyecto, mutable, sin PDF persistido. Se
// edita en la subetapa "Modalidad de pago definida" del onboarding con el mismo
// generador que el contrato (form + preview en vivo).
model ProformaDraft {
  id        String  @id @default(cuid())
  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  data Json

  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)
  createdById String
  createdBy   User     @relation("ProformaDraftCreatedBy", fields: [createdById], references: [id])
  updatedById String
  updatedBy   User     @relation("ProformaDraftUpdatedBy", fields: [updatedById], references: [id])

  @@index([projectId])
  @@map("proforma_drafts")
}

// Versión publicada de la proforma: inmutable, numerada por proyecto,
// soft-deleteable. Snapshot + 1 PDF en disco (path relativo a STORAGE_PATH).
model ProformaVersion {
  id            String                @id @default(cuid())
  projectId     String
  project       Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versionNumber Int
  status        ProformaVersionStatus @default(PUBLISHED)

  snapshot Json
  pdfPath  String
  label    String?

  publishedAt   DateTime @default(now()) @db.Timestamptz(6)
  publishedById String
  publishedBy   User     @relation("ProformaVersionPublishedBy", fields: [publishedById], references: [id])

  discardedAt   DateTime? @db.Timestamptz(6)
  discardedById String?
  discardReason String?

  @@unique([projectId, versionNumber])
  @@index([projectId, status])
  @@map("proforma_versions")
