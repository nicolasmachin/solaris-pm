  montoMaximo      Decimal?         @db.Decimal(14, 2)
  estadoResultante EstadoAprobacion @default(PENDIENTE_APROBACION)
  descripcion      String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

