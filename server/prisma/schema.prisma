  read         Boolean          @default(false)
  sentEmail    Boolean          @default(false)
  sentWhatsapp Boolean          @default(false)
  uniqueKey    String?          @unique
  createdAt    DateTime         @default(now()) @db.Timestamptz(6)

  @@index([userId, read])
  @@index([projectId])
  @@index([projectId, type])
  @@map("notifications")
}

